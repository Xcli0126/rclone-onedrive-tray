#!/usr/bin/env bash
#
# onedrive-watch: start a sync as soon as local files change.
#
# rclone bisync has no watch mode, so this watches the local tree with inotify
# and starts the sync service once the changes stop arriving. The systemd timer
# stays in place as the fallback for changes made on another machine, which no
# local watcher can see.
#
# The awkward part is that a sync writes into the tree being watched. Two things
# keep that from feeding back into an endless loop:
#
#   * `attrib` is deliberately not watched. bisync rewrites directory mtimes on
#     the local side ("Set directory modification time"), which raises IN_ATTRIB
#     events and nothing else. Watching metadata would mean every run triggered
#     the next one.
#   * After each triggered run the event queue is drained until it has been
#     quiet for WATCH_SETTLE seconds, so the echo of that run is discarded.
#
# Configuration: ~/.config/rclone-onedrive-tray/config
#   WATCH_DEBOUNCE  seconds of quiet before a burst counts as finished (default 8)
#   WATCH_SETTLE    seconds of quiet used when draining after a run (default 12)
#   WATCH_EXCLUDE   optional regex of paths to ignore, passed to inotifywait
#
set -uo pipefail

APP="onedrive-watch"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rclone-onedrive-tray"
CONFIG_FILE="$CONFIG_DIR/config"

die() { printf '%s: %s\n' "$APP" "$*" >&2; exit 1; }

[ -f "$CONFIG_FILE" ] || die "config not found: $CONFIG_FILE"
# shellcheck source=/dev/null
. "$CONFIG_FILE"

: "${LOCAL:?LOCAL is not set in $CONFIG_FILE}"

UNIT_NAME="${UNIT_NAME:-onedrive-sync}"
SERVICE="$UNIT_NAME.service"
DEBOUNCE="${WATCH_DEBOUNCE:-8}"
SETTLE="${WATCH_SETTLE:-12}"
EXCLUDE_RE="${WATCH_EXCLUDE:-}"
EVENTS="modify,create,delete,move"

command -v inotifywait >/dev/null 2>&1 ||
    die "inotifywait not found; install the inotify-tools package"
[ -d "$LOCAL" ] || die "sync directory not found: $LOCAL"

ARGS=(-q -r -e "$EVENTS" --format '')
if [ -n "$EXCLUDE_RE" ]; then
    ARGS+=(--exclude "$EXCLUDE_RE")
fi

running() { systemctl --user is-active --quiet "$SERVICE"; }

# Every inotifywait call used to discard both streams, so a failure was silently
# "sleep 5 and try the same thing again". A permanent one -- an exclude pattern
# that is not a valid regular expression, or the kernel's watch limit -- failed on
# every attempt: the unit stayed active, so systemd's Restart=always never fired,
# the journal held the startup banner alone, and nothing was watched at all while
# every diagnostic said the watcher was fine. The stderr is kept and written to
# the journal now, a permanent failure is told apart from a tree that went away,
# and a few permanent failures in a row end the process so systemd restarts it
# and the journal carries the reason.
MAX_PERMANENT_FAILS=3    # in a row, then exit non-zero for Restart=always
PERMANENT_RETRY=2        # seconds between attempts at something that keeps failing
TRANSIENT_RETRY=5        # seconds before looking again for a tree that is not there

error_count=0            # consecutive failures, whatever their kind
permanent_fails=0        # consecutive permanent ones, for the exit above
last_start_err=""        # so a failing systemctl start is reported once per reason

# report_error <message> -- the first failure, then every twelfth, so a tree left
# away for an hour is one line a minute rather than seven hundred.
report_error() {
    error_count=$((error_count + 1))
    if [ "$error_count" -eq 1 ] || [ $((error_count % 12)) -eq 0 ]; then
        printf '%s: inotifywait failed (%d in a row): %s\n' \
            "$APP" "$error_count" "$1" >&2
    fi
}

# permanent_failure <inotifywait stderr> -- true when retrying cannot help. A
# tree that is not there any more is the one failure that clears itself: put it
# back and watching works again. inotifywait says "No such file or directory" for
# a path that vanished between the check above and the watch, and says nothing at
# all when its directory is removed under it, so both the message and the state
# of the tree are asked.
permanent_failure() {
    [ -d "$LOCAL" ] || return 1
    case "$1" in
        *"No such file or directory"*|*"Not a directory"*) return 1 ;;
    esac
    return 0
}

# Wait for one event. With a timeout of 0, block until something happens. The
# exit status answers the caller's question (0: an event, non-zero: the timeout
# expired or inotifywait failed); EVENT_RC and EVENT_ERR carry the rest, because
# a command substitution can report the text or the status but not both.
EVENT_RC=0; EVENT_ERR=""
wait_event() {
    if [ "${1:-0}" = "0" ]; then
        EVENT_ERR="$(inotifywait "${ARGS[@]}" "$LOCAL" 2>&1 >/dev/null)"
    else
        EVENT_ERR="$(inotifywait -t "$1" "${ARGS[@]}" "$LOCAL" 2>&1 >/dev/null)"
    fi
    EVENT_RC=$?
    [ "$EVENT_RC" -eq 0 ]
}

# Consume events until the tree has been quiet for $1 seconds.
drain() { while wait_event "$1"; do :; done; }

printf '%s: watching %s (debounce %ss, settle %ss) -> %s\n' \
    "$APP" "$LOCAL" "$DEBOUNCE" "$SETTLE" "$SERVICE" >&2

drain "$SETTLE"     # ignore anything that happened before we started

while true; do
    if ! wait_event 0; then
        if permanent_failure "$EVENT_ERR"; then
            permanent_fails=$((permanent_fails + 1))
            report_error "${EVENT_ERR:-inotifywait exited $EVENT_RC without saying why}"
            if [ "$permanent_fails" -ge "$MAX_PERMANENT_FAILS" ]; then
                printf '%s: inotifywait failed %d times in a row and retrying cannot help; exiting so systemd restarts this unit and the journal keeps the reason\n' \
                    "$APP" "$permanent_fails" >&2
                exit 1
            fi
            sleep "$PERMANENT_RETRY"
        else
            # Not permanent, and not a reason to give up: the tree may come back.
            permanent_fails=0
            report_error "${EVENT_ERR:-the tree is not there (inotifywait exited $EVENT_RC)}"
            sleep "$TRANSIENT_RETRY"
        fi
        continue
    fi
    error_count=0
    permanent_fails=0

    drain "$DEBOUNCE"   # wait for the burst of edits to stop

    if running; then
        while running; do sleep 2; done
        sleep 2         # let bisync release its lock
    fi

    # The old line threw systemd's answer away. A refused start -- no session, a
    # unit that does not exist -- left the watcher looking healthy while nothing
    # was ever started, and the journal had nothing to say about it either. One
    # line per distinct reason, so a start that keeps failing is not one per edit.
    start_err=""
    if ! start_out="$(systemctl --user start "$SERVICE" 2>&1)"; then
        start_err="$(printf '%s\n' "$start_out" | head -1)"
        [ -n "$start_err" ] || start_err="it exited non-zero without a message"
    fi
    if [ -n "$start_err" ] && [ "$start_err" != "$last_start_err" ]; then
        printf '%s: systemctl --user start %s failed: %s\n' \
            "$APP" "$SERVICE" "$start_err" >&2
    fi
    last_start_err="$start_err"

    drain "$SETTLE"     # swallow whatever the run just wrote locally
done
