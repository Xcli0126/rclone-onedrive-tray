#!/usr/bin/env bash
#
# onedrive-check: report local names and paths that OneDrive will refuse or rename.
#
# bisync finds these the expensive way. It uploads, the service rejects the item,
# and every later run retries the same item: the log fills with the same error and
# the sync never reaches a clean state. One walk of the tree before the first sync
# turns that loop into a list you can act on.
#
#   onedrive-check              report for the configured pair
#   onedrive-check --quiet      no output, exit status only
#   onedrive-check --max N      show at most N entries per group (default 20)
#
# Exit 0 when nothing will fail, 1 when something will, 2 on a usage error. A name
# that will be renamed rather than rejected does not change the exit status. A
# directory find could not read leaves the walk incomplete and also exits 1: an
# incomplete report is not a clean one, and the output says so.
#
# What counts as a failure was measured, not assumed. The numbers and how they
# were taken are in docs/TROUBLESHOOTING.md.

set -uo pipefail

APP="onedrive-check"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rclone-onedrive-tray"
CONFIG_FILE="$CONFIG_DIR/config"

QUIET=0
MAX_SHOWN=20

# Print the whole header comment, whatever its length: a fixed range silently
# truncates the help as soon as the comment grows.
usage() { sed -n '2,/^[^#]/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; }

die() { printf '%s: %s\n' "$APP" "$*" >&2; exit 2; }

while [ $# -gt 0 ]; do
    case "$1" in
        --quiet|-q) QUIET=1; shift ;;
        --max)
            # Anything that is not a positive integer is a usage error, not a
            # value to feed to print_group: the old form let "--max abc" reach
            # the arithmetic and flood stderr instead of failing once.
            [ $# -ge 2 ] || die "--max needs a positive integer"
            case "$2" in
                ''|*[!0-9]*) die "--max needs a positive integer, got '$2'" ;;
            esac
            [ "$2" -gt 0 ] || die "--max needs a positive integer, got '$2'"
            MAX_SHOWN="$2"; shift 2 ;;
        -h|--help)  usage; exit 0 ;;
        *)          echo "$APP: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

[ -f "$CONFIG_FILE" ] || die "config not found: $CONFIG_FILE (run install.sh first)"
# shellcheck source=/dev/null
. "$CONFIG_FILE"

# A missing variable used to reach the reader as a raw bash error from ":?LOCAL",
# which looks like a bug in this script rather than the configuration fault it is.
[ -n "${LOCAL:-}" ]  || die "LOCAL is not set in $CONFIG_FILE"
[ -n "${REMOTE:-}" ] || die "REMOTE is not set in $CONFIG_FILE"

# Strip trailing slashes before anything compares against LOCAL. The strips below
# are literal matches, so "/x/y/" matched nothing, every rel stayed absolute, and
# every parent then looked over-long, which suppressed every report. "/" itself
# has to keep working.
while [ "$LOCAL" != "/" ] && [ "${LOCAL%/}" != "$LOCAL" ]; do
    LOCAL="${LOCAL%/}"
done
LOCAL_SLASH="$LOCAL/"
[ "$LOCAL" = "/" ] && LOCAL_SLASH="/"

[ -d "$LOCAL" ] || die "sync directory not found: $LOCAL"

REMOTE_PATH="${REMOTE#*:}"
[ "$REMOTE_PATH" = "$REMOTE" ] && REMOTE_PATH=""

# Measured against a personal account on rclone 1.75.1: a cloud path of 364
# characters uploaded, one of 383 came back pathIsTooLong. Microsoft documents
# 400, so the service counts something a little longer than the path itself and
# the documented number is not a working limit. 380 sits below every failure seen
# and leaves room for a file that gets renamed.
LIMIT_CLOUD=380
# Microsoft's documented total: a local path of up to 400 plus a root folder of
# up to 120. Only reachable with a long LOCAL, but nothing else catches it.
LIMIT_TOTAL=520
# Documented, not measured. A name longer than 255 bytes cannot be created on
# ext4 either, so this is a guard rather than a case that happens; a name of
# exactly 255 is the legal maximum and is not reported.
LIMIT_NAME=255

long_paths=0
renamed=0
rejected=0
declare -a long_list=() renamed_list=() rejected_list=()
declare -A seen_lower=()
# Every path that landed in any group, so the closing line can count distinct
# paths: one file that is both renamed and over-long is one thing to look at.
declare -A reported=()
# Directories already reported as renamed, so their contents are covered by that
# one entry rather than repeated per file.
declare -A renamed_dirs=()

# Microsoft reserves the Windows device names, and the one that was tried was
# refused: "CON: Failed to copy: invalidRequest: Invalid request". Windows also
# ignores everything after the first dot, so CON.txt is the same name as CON.
#
# Three more reserved names do not fit that rule and were invisible here:
# ".lock" leaves nothing before the dot, so the stem is empty; "desktop.ini"
# reduces to "desktop"; and "_vti_" is a reserved prefix with no dot in it at
# all. docs/FEATURE-PARITY.md lists all three beside CON, and the default
# filters only skip two of them, so the checker has to catch them itself.
is_reserved_name() {
    local name="${1,,}"
    local stem="${name%%.*}"
    case "$name" in
        .lock|desktop.ini) return 0 ;;
    esac
    case "$stem" in
        con|prn|aux|nul|com[0-9]|lpt[0-9]) return 0 ;;
    esac
    case "$name" in
        _vti_*) return 0 ;;
    esac
    return 1
}

# 0 when $1 is valid UTF-8, 1 otherwise, byte by byte. The check runs under a C
# locale on purpose so it does not depend on the caller's locale, and the caller
# only reaches it for a name that already holds a byte outside printable ASCII,
# so an all-ASCII tree never pays for the loop.
is_valid_utf8() {
    local LC_ALL=C
    local s="$1"
    local i=0 n=${#s} b c rest lo hi
    while [ "$i" -lt "$n" ]; do
        printf -v b '%d' "'${s:i:1}"
        if [ "$b" -lt 128 ]; then
            i=$((i + 1)); continue
        elif [ "$b" -ge 194 ] && [ "$b" -le 223 ]; then
            rest=1; lo=128; hi=191
        elif [ "$b" -ge 224 ] && [ "$b" -le 239 ]; then
            rest=2; lo=128; hi=191
            [ "$b" -eq 224 ] && lo=160
            [ "$b" -eq 237 ] && hi=159
        elif [ "$b" -ge 240 ] && [ "$b" -le 244 ]; then
            rest=3; lo=128; hi=191
            [ "$b" -eq 240 ] && lo=144
            [ "$b" -eq 244 ] && hi=143
        else
            return 1
        fi
        i=$((i + 1))
        [ "$i" -lt "$n" ] || return 1
        printf -v c '%d' "'${s:i:1}"
        if [ "$c" -lt "$lo" ] || [ "$c" -gt "$hi" ]; then
            return 1
        fi
        i=$((i + 1))
        while [ "$rest" -gt 1 ]; do
            [ "$i" -lt "$n" ] || return 1
            printf -v c '%d' "'${s:i:1}"
            if [ "$c" -lt 128 ] || [ "$c" -gt 191 ]; then
                return 1
            fi
            i=$((i + 1))
            rest=$((rest - 1))
        done
    done
    return 0
}

add() {  # add <group> <path> <entry>
    case "$1" in
        long)     long_paths=$((long_paths + 1)); long_list+=("$3") ;;
        renamed)  renamed=$((renamed + 1));       renamed_list+=("$3")
                  # A directory with a name the service will rewrite affects
                  # everything under it, and find visits it first, so remembering
                  # it here lets the scan below report the subtree once.
                  [ -d "$LOCAL/$2" ] && renamed_dirs["$2"]=1 ;;
        rejected) rejected=$((rejected + 1));     rejected_list+=("$3") ;;
    esac
    reported["$2"]=1
}

# find's stderr otherwise vanished into /dev/null, and a directory it could not
# read then looked exactly like a tree with nothing wrong in it. The walk streams
# on stdin, so the errors go to a file and are reported after the walk.
find_err="$(mktemp)" || die "cannot create a temporary file for find's errors"
trap 'rm -f "$find_err"' EXIT

while IFS= read -r -d '' path; do
    rel="${path#"$LOCAL_SLASH"}"
    name="${rel##*/}"

    # --- an over-long directory is one problem, not one per file inside it ----
    # find visits a directory before its contents, so the ancestor has already
    # been reported by the time its children are considered.
    parent_over=0
    parent="${path%/*}"
    if [ -n "$parent" ] && [ "$parent" != "$path" ] && [ "$parent" != "$LOCAL" ]; then
        prel="${parent#"$LOCAL_SLASH"}"
        pcloud=$(( ${#REMOTE_PATH} + ${#prel} ))
        [ -n "$REMOTE_PATH" ] && pcloud=$((pcloud + 1))
        if [ "$pcloud" -ge "$LIMIT_CLOUD" ] ||
           [ $(( ${#LOCAL} + ${#prel} + 1 )) -ge "$LIMIT_TOTAL" ]; then
            parent_over=1
        fi
    fi

    if [ "$parent_over" -eq 0 ]; then
        # Each length is used twice below; the +1 is the separator under LOCAL.
        cloud_len=$(( ${#REMOTE_PATH} + ${#rel} ))
        local_len=$(( ${#LOCAL} + ${#rel} + 1 ))
        [ -n "$REMOTE_PATH" ] && cloud_len=$((cloud_len + 1))
        if [ "$cloud_len" -ge "$LIMIT_CLOUD" ]; then
            add long "$rel" "cloud path $cloud_len chars: $rel"
        elif [ "$local_len" -ge "$LIMIT_TOTAL" ]; then
            add long "$rel" "local path $local_len chars: $rel"
        fi
    fi

    # --- what makes the service refuse the item -------------------------------
    if is_reserved_name "$name"; then
        add rejected "$rel" "reserved name: $rel"
    fi
    # 255 is the documented maximum, so a name of exactly that length is legal:
    # -ge failed a name the service accepts.
    if [ "${#name}" -gt "$LIMIT_NAME" ]; then
        add long "$rel" "name is ${#name} chars: $rel"
    fi

    # --- names the service cannot tell apart ---------------------------------
    # OneDrive is case insensitive, so these two cannot both exist there.
    dir="${rel%/*}"; [ "$dir" = "$rel" ] && dir=""
    key="$dir/${name,,}"
    if [ -n "${seen_lower[$key]:-}" ]; then
        add rejected "$rel" "$rel clashes with ${seen_lower[$key]} (OneDrive ignores case)"
    else
        seen_lower[$key]="$name"
    fi

    # An ancestor already reported as renamed covers this path: the documentation
    # promises one entry per offending subtree, and a directory named "a:b" with
    # five hundred files in it used to be reported five hundred and one times.
    if [ "${#renamed_dirs[@]}" -gt 0 ]; then
        ancestor="${rel%/*}"
        skip_renamed=0
        while [ -n "$ancestor" ] && [ "$ancestor" != "$rel" ]; do
            if [ -n "${renamed_dirs["$ancestor"]:-}" ]; then
                skip_renamed=1
                break
            fi
            [ "$ancestor" = "${ancestor%/*}" ] && break
            ancestor="${ancestor%/*}"
        done
        [ "$skip_renamed" -eq 1 ] && continue
    fi

    # --- what rclone will silently rename on the way up ----------------------
    # Microsoft does not allow these, and rclone's default OneDrive encoding
    # (Slash,LtGt,DoubleQuote,Colon,Question,Asterisk,Pipe,BackSlash,Del,Ctl,
    # LeftSpace,LeftTilde,RightSpace,RightPeriod,InvalidUtf8,Dot) replaces them
    # with look-alike characters. The upload succeeds and the cloud name then
    # differs from the local one, which is harder to debug than a failure would
    # be.
    #
    # Split on "/" by hand rather than with `read -a`: read stops at the first
    # newline, so a name holding one used to truncate the rest of the scan.
    bad_part=""
    rest="$rel"
    while [ -n "$rest" ]; do
        if [[ "$rest" == */* ]]; then
            part="${rest%%/*}"
            rest="${rest#*/}"
        else
            part="$rest"
            rest=""
        fi
        case "$part" in
            ' '*|*' ')           bad_part="space at the start or end of '$part'" ;;
            '~'*)                bad_part="leading tilde in '$part'" ;;
            *.)                  bad_part="period at the end of '$part'" ;;
            *[$'\x7f']*)         bad_part="DEL (0x7f) in '$part'" ;;
            *[[:cntrl:]]*)       bad_part="control character in '$part'" ;;
            *[\"\*:\<\>\?\\\|]*) bad_part="'\"*:<>?\\|' in '$part'" ;;
            *)
                # InvalidUtf8: a name that is not even a byte outside printable
                # ASCII cannot be one, so the common name skips the scan.
                if [[ "$part" == *[!-~]* ]] && ! is_valid_utf8 "$part"; then
                    bad_part="bytes that are not valid UTF-8 in '$part'"
                fi ;;
        esac
        [ -n "$bad_part" ] && break
    done
    [ -n "$bad_part" ] && add renamed "$rel" "$rel -- $bad_part"
done < <(find "$LOCAL" -mindepth 1 -print0 2>"$find_err")

# find's error lines are the report that the walk was incomplete. Read them after
# the loop, once find has closed its stderr.
declare -a walk_err_lines=()
if [ -s "$find_err" ]; then
    while IFS= read -r line; do walk_err_lines+=("$line"); done < "$find_err"
fi
walk_errors=${#walk_err_lines[@]}
distinct=${#reported[@]}

if [ "$QUIET" -eq 0 ]; then
    printf '%s: %s against %s\n\n' "$APP" "$LOCAL" "$REMOTE"

    print_group() {  # print_group <heading> <count> <entries...>
        local heading="$1" count="$2"; shift 2
        printf '  %s (%d)\n' "$heading" "$count"
        if [ "$count" -eq 0 ]; then printf '\n'; return; fi
        local shown=0
        for entry in "$@"; do
            [ "$shown" -ge "$MAX_SHOWN" ] && break
            printf '    %s\n' "$entry"
            shown=$((shown + 1))
        done
        [ "$count" -gt "$MAX_SHOWN" ] && printf '    ... and %d more\n' "$((count - MAX_SHOWN))"
        printf '\n'
    }

    print_group "OneDrive will refuse these" "$rejected" ${rejected_list[@]+"${rejected_list[@]}"}
    print_group "OneDrive will rename these" "$renamed"  ${renamed_list[@]+"${renamed_list[@]}"}
    print_group "These paths are too long"   "$long_paths" ${long_list[@]+"${long_list[@]}"}

    if [ "$walk_errors" -gt 0 ]; then
        print_group "The walk was incomplete: find could not read these" \
            "$walk_errors" ${walk_err_lines[@]+"${walk_err_lines[@]}"}
        printf '  WARNING: the walk was incomplete, so this report does not cover the whole tree.\n\n'
    fi

    if [ "$distinct" -eq 0 ] && [ "$walk_errors" -eq 0 ]; then
        printf '  nothing to fix. Names and paths are within what OneDrive accepts.\n'
    elif [ "$distinct" -gt 0 ]; then
        # Both numbers, because they differ: one name can be renamed and too
        # long at once, so it is one path but two problems. The group headings
        # above count problems; this line says which is which instead of
        # leaving the reader to add them up and get a number nothing matches.
        problems=$((rejected + renamed + long_paths))
        paths_word=paths; problems_word=problems
        [ "$distinct" -eq 1 ] && paths_word=path
        [ "$problems" -eq 1 ] && problems_word=problem
        printf '  %d %s to look at (%d %s). Limits and measurements: docs/TROUBLESHOOTING.md\n' \
            "$distinct" "$paths_word" "$problems" "$problems_word"
    fi
fi

# An incomplete walk cannot certify the tree either, so it joins the failures.
if [ "$walk_errors" -gt 0 ] || [ $((rejected + long_paths)) -gt 0 ]; then
    exit 1
fi
exit 0
