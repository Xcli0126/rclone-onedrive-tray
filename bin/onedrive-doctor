#!/usr/bin/env bash
#
# onedrive-doctor: is this install healthy, and if not, which part is wrong.
#
# Why this exists: answering that by hand means running systemctl, journalctl,
# flock and tail and reading four outputs to find the one line that matters.
# Those are the checks below, one line each so the left edge can be scanned:
# ok, warn, fail.
#
# Usage:
#   onedrive-doctor              run every check
#   onedrive-doctor --quiet      print only warn and fail lines, plus the summary
#   onedrive-doctor --offline    skip the remote probe; nothing leaves the machine
#   onedrive-doctor --help
#
# Exit 0 when nothing failed, 1 when at least one check failed, 2 on a usage
# error. warn never changes the exit status: it marks something that is off
# rather than broken, such as a timer that is installed but not enabled, a
# baseline that was never built, or a network problem the next run retries.
#
# Read-only by construction: it never writes the config, never starts, stops,
# enables or disables a unit, never takes the sync lock and never runs a sync,
# and it leaves no file behind. Safe while a sync is running, over SSH and with
# no graphical session; it never imports GTK. Every command that could hang runs
# under timeout, and where systemctl is absent the scheduler check says so.
#
# Configuration: ~/.config/rclone-onedrive-tray/config  (see config.example)
#
set -uo pipefail

APP="onedrive-doctor"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rclone-onedrive-tray"
CONFIG_FILE="$CONFIG_DIR/config"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/rclone-onedrive-tray"
RCLONE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/rclone"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/rclone-onedrive-tray"

# Every config key some script here reads, so a key outside this list is a note
# rather than a fault.
KNOWN_KEYS=" REMOTE LOCAL UNIT_NAME INTERVAL_MIN MAX_DELETE CHECK_ACCESS
 CHECK_FILENAME BISYNC_ARGS BW_LIMIT FILTERS_FILE EXCLUDE_FOLDERS_FILE LOG
 OPEN_APP_CMD OPEN_APP_NAME UI_LANG SHOW_ICON WATCH WATCH_DEBOUNCE WATCH_SETTLE
 WATCH_EXCLUDE RETRIES RETRY_DELAY MAX_LOG_BYTES RCLONE NOTIFY_ON_SUCCESS "
# Flattened once, because the list above is wrapped: a match against the wrapped
# form misses any key that ended a line.
KNOWN=" $(printf '%s' "$KNOWN_KEYS" | tr -s '[:space:]' ' ') "

QUIET=0; OFFLINE=0
n_ok=0; n_warn=0; n_fail=0

# Print the whole header comment, whatever its length: a fixed range silently
# truncates the help as soon as the comment grows.
usage() { sed -n '2,/^[^#]/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; }
die() { printf '%s: %s\n' "$APP" "$*" >&2; exit 2; }

while [ $# -gt 0 ]; do
    case "$1" in
        --quiet|-q) QUIET=1; shift ;;
        --offline)  OFFLINE=1; shift ;;
        -h|--help)  usage; exit 0 ;;
        *) printf 'usage: %s [--quiet] [--offline] (unknown option: %s)\n' \
               "$APP" "$1" >&2
           exit 2 ;;
    esac
done

# ---- reporting ------------------------------------------------------------
# report <ok|warn|fail> <check> <message>
report() {
    local verdict="$1" check="$2" msg="$3"
    [ "$verdict" = ok ] && n_ok=$((n_ok + 1))
    [ "$verdict" = warn ] && n_warn=$((n_warn + 1))
    [ "$verdict" = fail ] && n_fail=$((n_fail + 1))
    # --quiet keeps the lines that ask for something; the summary still counts
    # every check, so a reader of --quiet never sees fewer checks than ran.
    [ "$QUIET" -eq 1 ] && [ "$verdict" = ok ] && return 0
    printf '%-4s %-9s %s\n' "$verdict" "$check" "$msg"
}

have() { command -v "$1" >/dev/null 2>&1; }

human_age() {  # human_age <seconds>
    local s="$1"
    if [ "$s" -lt 60 ]; then printf '%ds' "$s"
    elif [ "$s" -lt 3600 ]; then printf '%dm' "$((s / 60))"
    elif [ "$s" -lt 86400 ]; then printf '%dh' "$((s / 3600))"
    else printf '%dd' "$((s / 86400))"; fi
}

# Seconds since <path> changed, or nothing when stat cannot say. A clock that
# went backwards reads as 0 rather than as a negative age.
file_age() {
    local mtime age
    mtime="$(stat -c %Y -- "$1" 2>/dev/null)" || return 1
    [ -n "$mtime" ] || return 1
    age=$(( $(date +%s) - mtime ))
    [ "$age" -lt 0 ] && age=0
    printf '%s' "$age"
}

# The age at the front of a timestamped log line, or nothing. A failure hint can
# be older than the last successful run, and saying how old it is stops a reader
# from taking it for something that is happening now.
line_age() {
    local ts epoch age
    ts="$(printf '%s\n' "$1" |
        grep -a -oE '^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}' |
        head -1 || true)"
    [ -n "$ts" ] || return 0
    epoch="$(date -d "$ts" +%s 2>/dev/null || true)"
    [ -n "$epoch" ] || return 0
    age=$(( $(date +%s) - epoch ))
    [ "$age" -lt 0 ] && age=0
    human_age "$age"
}

# ---- the config -----------------------------------------------------------
# Loaded first and reported as its own check. A config that does not source
# cleanly under set -u is a real fault, the wrapper dies on it too; the tolerant
# second source still loads what it can, so the checks after this one describe
# the install rather than the failed parse.
config_state="missing"; config_err=""
err_file="$(mktemp)" || die "cannot create a temporary file"
trap 'rm -f "$err_file"' EXIT

source_config() {
    # shellcheck source=/dev/null
    . "$CONFIG_FILE"
}

if [ -f "$CONFIG_FILE" ]; then
    if ( set -u; source_config ) 2>"$err_file"; then
        config_state="clean"
    else
        config_state="unclean"; config_err="$(tail -1 "$err_file")"
    fi
    set +u
    # shellcheck source=/dev/null
    . "$CONFIG_FILE" 2>/dev/null || true
    set -u
fi

# The same defaults the wrapper and the tray use, so no check reports a value
# the scripts themselves would not use.
RCLONE="${RCLONE:-rclone}"; LOG="${LOG:-$CACHE_DIR/sync.log}"
MAX_LOG_BYTES="${MAX_LOG_BYTES:-5242880}"; WATCH="${WATCH:-1}"
UNIT_NAME="${UNIT_NAME:-onedrive-sync}"
REMOTE="${REMOTE:-}"; LOCAL="${LOCAL:-}"
FILTERS_FILE="${FILTERS_FILE:-}"; EXCLUDE_FOLDERS_FILE="${EXCLUDE_FOLDERS_FILE:-}"

[ "$QUIET" -eq 0 ] && printf '%s: %s\n' "$APP" "$CONFIG_FILE"

# ---- 1. rclone ------------------------------------------------------------
# 1.65 or newer: below that --resilient and --recover do not exist, so an
# interrupted sync never recovers on its own.
if have "$RCLONE"; then
    rclone_path="$(command -v "$RCLONE")"
    rclone_ver="$(timeout 10 "$RCLONE" version 2>/dev/null | head -1 |
        grep -oE '[0-9]+\.[0-9]+' | head -1 || true)"
    major="${rclone_ver%%.*}"; minor="${rclone_ver##*.}"
    if [ -z "$rclone_ver" ]; then
        report warn rclone "$rclone_path did not report a version; check the binary (rclone version)"
    elif [ "$major" -eq 0 ] || { [ "$major" -eq 1 ] && [ "$minor" -lt 65 ]; }; then
        report fail rclone "rclone $rclone_ver is older than 1.65, so an interrupted sync cannot recover by itself; install a current build (docs/DEPENDENCIES.md)"
    else
        report ok rclone "$rclone_ver at $rclone_path"
    fi
else
    report fail rclone "$RCLONE is not on PATH, so nothing can sync; install rclone (docs/DEPENDENCIES.md), or set RCLONE in $CONFIG_FILE"
fi

# ---- 2. flock -------------------------------------------------------------
# Without it the wrapper refuses to run: no lock means a manual sync and the
# timer can corrupt each other's listings.
if have flock; then
    report ok flock "$(command -v flock)"
else
    report fail flock "flock is missing (it ships with util-linux) and onedrive-sync refuses to run without it; install util-linux"
fi

# ---- 3. config ------------------------------------------------------------
if [ "$config_state" = missing ]; then
    report fail config "no config at $CONFIG_FILE; run ./setup.sh, or ./install.sh and edit it by hand"
elif [ "$config_state" = unclean ]; then
    report fail config "$CONFIG_FILE does not source cleanly under set -u: $config_err; fix that line (a key that refers to an unset variable is the usual cause)"
else
    config_missing=""
    [ -n "$REMOTE" ] || config_missing="REMOTE"
    [ -n "$LOCAL" ] || config_missing="${config_missing:+$config_missing and }LOCAL"
    unknown=""; file_keys=""
    while IFS= read -r key; do
        file_keys="$file_keys $key"
        case "$KNOWN" in
            *" $key "*) ;;
            *) unknown="${unknown:+$unknown, }$key" ;;
        esac
    # The optional `export ` is not decoration: the config is read with `.`, so
    # the wrapper, the tray and this script all accept `export RETRIES=...`, and
    # a scan anchored on the key alone did not see such a line at all. A config
    # the wrapper refused was then certified healthy here.
    done < <(sed -n 's/^[[:space:]]*\(export[[:space:]]\+\)\?\([A-Za-z_][A-Za-z0-9_]*\)=.*/\2/p' \
                 "$CONFIG_FILE" | sort -u)
    # The three keys onedrive-sync runs require_positive_int on. A value it
    # refuses stops every scheduled run before rclone starts, and its message goes
    # to the systemd journal, which is the last place a user looks. Only keys the
    # file actually sets are judged: an absent one gets the wrapper's own default.
    bad_number=""
    for key in RETRIES RETRY_DELAY MAX_LOG_BYTES; do
        case " $file_keys " in *" $key "*) ;; *) continue ;; esac
        value="$(printf '%s' "${!key-}" | tr -d '[:space:]')"
        case "$value" in
            ''|*[!0-9]*) bad_number="${bad_number:+$bad_number, }$key" ;;
            *) [ "$value" -gt 0 ] || bad_number="${bad_number:+$bad_number, }$key" ;;
        esac
    done
    if [ -n "$config_missing" ]; then
        report fail config "$CONFIG_FILE does not set $config_missing; add the key and run onedrive-sync --resync"
    elif [ -n "$bad_number" ]; then
        report fail config "$CONFIG_FILE sets $bad_number to something onedrive-sync refuses to run with (a whole number above zero is required); fix it or remove the key, because nothing syncs until it is"
    else
        report ok config "$CONFIG_FILE sets REMOTE and LOCAL${unknown:+ (note: key(s) nothing here reads: $unknown)}"
    fi
fi

# ---- 4. paths -------------------------------------------------------------
# One line: can this install touch what it needs. LOCAL has to exist and be
# writable, a filters file the config names has to be there, and an exclude list
# that exists has to be readable.
paths_verdict=ok; paths_msg=""
if [ -z "$LOCAL" ]; then
    paths_msg="LOCAL is not set, so there is nothing to check"; paths_verdict=fail
elif [ ! -d "$LOCAL" ]; then
    paths_msg="$LOCAL does not exist; create it (mkdir -p \"$LOCAL\") or fix LOCAL and run --resync"
    paths_verdict=fail
elif [ ! -w "$LOCAL" ]; then
    paths_msg="$LOCAL exists but is not writable by this user; fix its owner or permissions"; paths_verdict=fail
else
    paths_msg="$LOCAL exists and is writable"
fi

# The same optional `export ` as the key scan above: without it a config whose
# only FILTERS_FILE line carried the prefix got no mention of the path here.
if grep -qE '^[[:space:]]*(export[[:space:]]+)?FILTERS_FILE=' "$CONFIG_FILE" 2>/dev/null; then
    rules=""
    [ -f "$FILTERS_FILE" ] && \
        rules="$(grep -a -cvE '^[[:space:]]*(#|$)' "$FILTERS_FILE" 2>/dev/null || true)"
    if [ -z "$FILTERS_FILE" ]; then
        paths_msg="$paths_msg; FILTERS_FILE is empty, so no filter rules are applied"
    elif [ ! -e "$FILTERS_FILE" ]; then
        paths_msg="$paths_msg; FILTERS_FILE $FILTERS_FILE does not exist, so runs apply no filters; create it or empty the key"
        paths_verdict=fail
    elif [ ! -f "$FILTERS_FILE" ]; then
        # A directory (or a fifo) is not a missing file, and grep on one either
        # errors or waits forever; the wrapper passes no --filters-file for it,
        # so this is still a failure, with a sentence that matches what it is.
        paths_msg="$paths_msg; FILTERS_FILE $FILTERS_FILE is not a regular file, so runs apply no filters; point it at a file or empty the key"
        paths_verdict=fail
    elif [ ! -r "$FILTERS_FILE" ]; then
        paths_msg="$paths_msg; FILTERS_FILE $FILTERS_FILE is not readable; fix its permissions"; paths_verdict=fail
    else
        paths_msg="$paths_msg; filters file has ${rules:-0} rule line(s)"
    fi
fi

if [ -n "$EXCLUDE_FOLDERS_FILE" ] && [ -e "$EXCLUDE_FOLDERS_FILE" ]; then
    if [ ! -f "$EXCLUDE_FOLDERS_FILE" ]; then
        # The same guard the log and FILTERS_FILE carry, for the third file this
        # section reads: -e and -r are both true for a fifo, and the grep below
        # would wait for a writer that never comes. onedrive-sync skips a
        # non-regular exclude list, so nothing is excluded either way.
        paths_msg="$paths_msg; EXCLUDE_FOLDERS_FILE $EXCLUDE_FOLDERS_FILE is not a regular file, so runs exclude nothing from it; point it at a file or empty the key"
        paths_verdict=fail
    elif [ -r "$EXCLUDE_FOLDERS_FILE" ]; then
        paths_msg="$paths_msg; exclude list has $(grep -a -cvE '^[[:space:]]*(#|$)' "$EXCLUDE_FOLDERS_FILE" || true) entry line(s)"
    else
        paths_msg="$paths_msg; EXCLUDE_FOLDERS_FILE $EXCLUDE_FOLDERS_FILE is not readable; fix its permissions"
        paths_verdict=fail
    fi
fi
report "$paths_verdict" paths "$paths_msg"

# ---- 5. baseline ----------------------------------------------------------
# rclone names the listing <left>..<right>.path1.lst; only the right half is
# reliable, so the same slug the wrapper's pair_size() builds is used here.
baseline_verdict=warn; baseline_msg=""
if [ -z "$LOCAL" ]; then
    baseline_msg="LOCAL is not set, so the bisync pair cannot be named"; baseline_verdict=fail
else
    slug="$(printf '%s' "$LOCAL" | sed -e 's|^/||' -e 's|[/: ]|_|g')"
    newest=""; count=0
    for listing in "$RCLONE_CACHE"/bisync/*.."$slug".path1.lst; do
        [ -f "$listing" ] || continue
        count=$((count + 1))
        if [ -z "$newest" ] || [ "$listing" -nt "$newest" ]; then newest="$listing"; fi
    done
    if [ "$count" -eq 0 ]; then
        baseline_msg="no bisync listing for $LOCAL under $RCLONE_CACHE/bisync, so nothing has synced yet; build the baseline once with: onedrive-sync --resync"
    elif [ "$count" -gt 1 ]; then
        baseline_msg="$count listing pairs name $LOCAL, so the pair size cannot be told apart and the conservative 5% delete cap is used; keep one remote per local folder, then run --resync"
    else
        baseline_age="$(file_age "$newest")"
        baseline_msg="listing $(basename "$newest") is present"
        [ -n "$baseline_age" ] && baseline_msg="listing $(basename "$newest") last written $(human_age "$baseline_age") ago"
        baseline_verdict=ok
    fi
fi
report "$baseline_verdict" baseline "$baseline_msg"

# ---- 6. lock --------------------------------------------------------------
# The wrapper holds $CACHE_DIR/sync.lck with flock; that file carries no PID and
# stays behind after a run, so on its own it means nothing. rclone's own *.lck
# files do carry the owner PID, and the wrapper drops a stale one on its next
# run, which is why this check reads both.
lock_verdict=ok; lock_msg=""
wrapper_lock="$CACHE_DIR/sync.lck"
if [ -e "$wrapper_lock" ]; then
    lock_age="$(file_age "$wrapper_lock")"
    lock_msg="sync.lck present${lock_age:+ (last touched $(human_age "$lock_age") ago)}"
else
    lock_msg="no sync.lck yet"
fi
for lck in "$RCLONE_CACHE"/bisync/*.lck; do
    [ -e "$lck" ] || continue
    held_pid="$(grep -o '"PID"[[:space:]]*:[[:space:]]*"[0-9]\+"' "$lck" 2>/dev/null |
        grep -o '[0-9]\+' | head -1 || true)"
    if [ -n "$held_pid" ] && kill -0 "$held_pid" 2>/dev/null; then
        lock_msg="$lock_msg; a sync is running now ($(basename "$lck"), pid $held_pid)"
    elif [ -n "$held_pid" ]; then
        lock_msg="$lock_msg; stale $(basename "$lck") (owner pid $held_pid is gone); the next run removes it"
        lock_verdict=warn
    else
        lock_msg="$lock_msg; $(basename "$lck") carries no PID, so only --max-lock expires it"
        lock_verdict=warn
    fi
done
report "$lock_verdict" lock "$lock_msg"

# ---- 7. log ---------------------------------------------------------------
# The last line carrying a timestamp says when the wrapper last wrote. The
# newest failure hint is classified with the wrapper's own patterns; the order
# they are asked in is in classify_hint, below, and the sign-in markers come
# first for the reason written there.
RE_LOCK='prior lock file found'
RE_MAXDELETE='too many deletes|excessive deletes|deletion limit'
RE_ACCESS='access test failed|check file check failed'
RE_NETWORK='lookup .*:53|dial tcp|no such host|Temporary failure in name resolution|server misbehaving|couldn.t fetch token|connection reset|connection refused|i/o timeout|: EOF|unexpected EOF|no route to host|network is unreachable|TLS handshake|proxyconnect|context deadline exceeded'
RE_OLD='unknown flag|flag provided but not defined|unknown shorthand flag'
# The empty-remote refusal, measured on rclone 1.75.1: "Empty prior Path1
# listing. Cannot sync to an empty directory". It also ends in "Bisync critical
# error", so it has to be asked about before RE_RESYNC below.
RE_EMPTY='Empty prior Path1 listing'
RE_RESYNC='must run --resync|resync required|prior listings|critical error'
RE_AUTH='invalid_grant|401 Unauthorized|403 Forbidden|invalid_token|token expired|AADSTS'
ALL_HINTS="$RE_LOCK|$RE_MAXDELETE|$RE_ACCESS|$RE_NETWORK|$RE_OLD|$RE_EMPTY|$RE_RESYNC|$RE_AUTH"

classify_hint() {  # classify_hint <text> -> a tag, or none
    local t="$1"
    if grep -qiE "$RE_LOCK" <<<"$t"; then printf 'lock'
    elif grep -qiE "$RE_MAXDELETE" <<<"$t"; then printf 'maxdelete'
    elif grep -qiE "$RE_ACCESS" <<<"$t"; then printf 'access'
    # Before the network patterns: the line rclone 1.75.1 writes for a refused
    # sign-in is a single one, "failed to get root: ... couldn't fetch token:
    # invalid_grant: maybe token expired? - try refreshing with rclone config
    # reconnect", and it matches both tables. A marker that can only come from
    # Microsoft's own answer settles which it is; the network patterns are the
    # ones that also describe a request that never arrived.
    elif grep -qiE "$RE_AUTH" <<<"$t"; then printf 'auth'
    elif grep -qiE "$RE_NETWORK" <<<"$t"; then printf 'network'
    elif grep -qiE "$RE_OLD" <<<"$t"; then printf 'oldrclone'
    elif grep -qiE "$RE_EMPTY" <<<"$t"; then printf 'emptyremote'
    elif grep -qiE "$RE_RESYNC" <<<"$t"; then printf 'resync'
    else printf 'none'; fi
}

# marker_field <the part of the line after its number> <key> -> the value of
# that field, or nothing when the line does not carry it. Parameter expansion
# rather than a pattern: msg runs to the end of the line and may hold spaces,
# "=" and "/", so it cannot be read as one more word.
marker_field() {
    local line="$1" key="$2" rest
    case "$line" in
        *" $key="*) rest="${line#* "$key"=}" ;;
        *) return 0 ;;
    esac
    printf '%s' "${rest%% *}"
}

if [ ! -e "$LOG" ]; then
    report warn log "no log at $LOG yet, so no run has written one; the first sync creates it"
elif [ ! -r "$LOG" ]; then
    report fail log "$LOG exists but is not readable by this user; fix its permissions or your groups"
elif [ ! -f "$LOG" ]; then
    # -e and -r are both true for a fifo, and every read below is a grep: the
    # doctor would wait for a writer that never comes instead of answering.
    report warn log "$LOG is not a regular file (a fifo, a socket or a device), and reading it would block this check; point LOG at a real file"
else
    # -a throughout: GNU grep calls a file with a NUL byte in it binary and
    # prints nothing for it, so one stray byte used to silence every check
    # below - the log was then reported as one nothing had ever run through.
    last_ts="$(grep -a -E '^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}' "$LOG" |
        tail -1 | cut -c1-19 || true)"
    log_age=""
    if [ -n "$last_ts" ]; then
        epoch="$(date -d "$last_ts" +%s 2>/dev/null || true)"
        if [ -n "$epoch" ]; then
            log_age=$(( $(date +%s) - epoch )); [ "$log_age" -lt 0 ] && log_age=0
            log_age="last write $(human_age "$log_age") ago; "
        fi
    fi
    # Line numbers rather than text throughout: the question is whether a
    # successful run came after the hint. Only the tools the doctor may call are
    # used here, so no awk.
    last_ok="$(grep -a -n 'Bisync successful' "$LOG" | tail -1 | cut -d: -f1 || true)"
    hint_at="$(grep -a -n -iE "$ALL_HINTS" "$LOG" | tail -1 | cut -d: -f1 || true)"
    newest_hint="$(grep -a -iE "$ALL_HINTS" "$LOG" | tail -1 || true)"
    tag="none"; [ -n "$newest_hint" ] && tag="$(classify_hint "$newest_hint")"
    # ---- the wrapper's own verdict, when the log carries one ----------------
    # onedrive-sync ends a run with one ONEDRIVE_RESULT line, so a reader does
    # not have to match English. When that line is newer than the newest prose
    # hint it settles the class whatever English sits beside it; the table above
    # is what still reads a log from an older wrapper, or one whose last run was
    # killed before it could write its marker.
    marker_at=""
    # Anchored, and with all four fields required, exactly as the tray reads it:
    # rclone logs file names raw, so a line that merely quotes a name shaped like
    # a marker is not a run's verdict, and a marker truncated mid-write is not
    # one either.
    marker_line="$(grep -a -nE '^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} ONEDRIVE_RESULT v=1 ' "$LOG" | tail -1 || true)"
    if [ -n "$marker_line" ]; then
        marker_at="${marker_line%%:*}"
        marker_text="${marker_line#*:}"
        marker_state="$(marker_field "$marker_text" state)"
        marker_tag="$(marker_field "$marker_text" tag)"
        # Every field the tray's RESULT_RE requires, required here too: a line
        # that stops after state=synced is a truncated write or a name that
        # looks like a marker, and neither is a run's verdict.
        printf '%s\n' "$marker_text" | grep -qaE \
            '^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} ONEDRIVE_RESULT v=1 state=[^ ]+ tag=([a-z]+|none) when=[0-9]{2}:[0-9]{2} msg=' ||
            { marker_state=""; marker_tag=""; }
        # state=synced is this run's success line, which is what the
        # "a later run synced past it" comparison above works from.
        if [ "$marker_state" = synced ] &&
                { [ -z "$last_ok" ] || [ "$marker_at" -gt "$last_ok" ]; }; then
            last_ok="$marker_at"
        fi
        if [ -z "$hint_at" ] || [ "$marker_at" -gt "$hint_at" ]; then
            case "$marker_state" in
                synced) tag="none"; newest_hint="" ;;
                # A tag outside the a-z set (or none) cannot beat the table.
                error|stopped)
                    case "$marker_tag" in
                        ''|none) ;;
                        # The line without its number: everything that reads
                        # newest_hint afterwards wants the timestamped text,
                        # and the number is only for the comparisons above.
                        *) tag="$marker_tag"; newest_hint="$marker_text" ;;
                    esac ;;
            esac
        fi
    fi
    # A hint that a later run synced past is history, which is the difference
    # between "this failed once" and "this is failing": reporting the first as a
    # fault sends a user to reconnect a remote that already works.
    cleared=0
    if [ -n "$hint_at" ] && [ -n "$last_ok" ] && [ "$hint_at" -lt "$last_ok" ]; then
        cleared=1; newest_hint=""; tag="none"
    fi
    # And a hint the next run cannot clear still stands while nothing has synced
    # since it. Reading only the newest line let a network blip, which retries
    # itself, hide the refused sign-in that was the reason nothing was syncing,
    # and the line then said the sign-in was not what failed.
    if [ "$tag" = network ]; then
        standing="$(grep -a -n -iE "$ALL_HINTS" "$LOG" | grep -av -iE "$RE_NETWORK" |
            tail -1 || true)"
        standing_at="${standing%%:*}"
        if [ -n "$standing" ] &&
                { [ -z "$last_ok" ] || [ "$standing_at" -gt "$last_ok" ]; }; then
            newest_hint="${standing#*:}"
            tag="$(classify_hint "$newest_hint")"
        fi
    fi
    hint_age=""
    if [ -n "$newest_hint" ]; then
        hint_secs="$(line_age "$newest_hint")"
        [ -n "$hint_secs" ] && hint_age=" from ${hint_secs} ago"
    fi
    case "$tag" in
        # The wrapper's own sentence, for a class this table has no name for.
        # Every refuse() in onedrive-sync ends state=stopped tag=other, and the
        # report below had no branch for it: a run that cannot start was
        # reported as a log with no failure hint in it.
        other)
            # state=stopped is a refusal before rclone ever ran, which nothing
            # but a person can clear, so it fails; state=error is a run that
            # tried and failed unclassifiably, which the next run retries.
            if [ "${marker_state:-}" = stopped ]; then
                report fail log "${log_age}the wrapper stopped this run before it synced, in a class this check has no name for${hint_age}; the log says why: $LOG"
            else
                report warn log "${log_age}the last run failed with a message this check has no class for${hint_age}; tail the log: $LOG"
            fi ;;
        auth) report fail log "${log_age}a refused or expired sign-in is in the log${hint_age}; re-authorise from the tray's 'Re-authorise OneDrive' item, or run: rclone config reconnect ${REMOTE%%:*}:." ;;
        network) report warn log "${log_age}the newest failure hint${hint_age} is a network problem, which the next run retries; the sign-in is not what failed${newest_hint:+: $(printf '%s\n' "$newest_hint" | head -1 | cut -c1-160)}" ;;
        lock|maxdelete|access|resync|oldrclone|emptyremote) report warn log "${log_age}a [$tag] failure is in the log${hint_age}; tail the log for the full message: $LOG" ;;
        *)
            if [ "$cleared" -eq 1 ]; then
                report ok log "${log_age}every failure hint in it was followed by a sync that worked"
            elif [ -n "$last_ts" ]; then
                report ok log "${log_age}no failure hint in it"
            else
                report warn log "no timestamped line in $LOG yet, so nothing has run through the wrapper"
            fi ;;
    esac
fi

# ---- 8. systemd -----------------------------------------------------------
# The timer is the difference between "broken" and "not scheduled", so both
# states are named. The service's Result is history: it is reported, and one
# failed run does not by itself make the doctor exit 1.
unit="$UNIT_NAME"
if ! have systemctl; then
    report warn systemd "systemctl is not on PATH, so the timer and the service could not be read; the wrapper and the other scripts still work"
else
    timer_path="$(timeout 10 systemctl --user show -p FragmentPath --value "$unit.timer" 2>/dev/null || true)"
    timer_enabled="$(timeout 10 systemctl --user is-enabled "$unit.timer" 2>&1 || true)"
    timer_active="$(timeout 10 systemctl --user is-active "$unit.timer" 2>&1 || true)"
    timer_next="$(timeout 10 systemctl --user show -p NextElapseUSecMonotonic --value "$unit.timer" 2>/dev/null || true)"
    svc_result="$(timeout 10 systemctl --user show -p Result --value "$unit.service" 2>/dev/null || true)"
    if [ -z "$timer_path" ]; then
        case "$timer_enabled" in
            *"Failed to connect"*|*"not been booted"*)
                report warn systemd "no user systemd session is reachable from here, so nothing is scheduled; log in with a session, then run ./install.sh" ;;
            *) report warn systemd "$unit.timer is not in the user manager, so no sync is scheduled; ./install.sh writes it, then: systemctl --user enable --now $unit.timer" ;;
        esac
    else
        verdict=ok
        [ "$timer_enabled" = enabled ] || verdict=warn
        [ "$timer_active" = active ] || verdict=warn
        [ "${svc_result:-unknown}" = success ] || verdict=warn
        next_txt="no next elapse reported"
        [ -n "$timer_next" ] && next_txt="next elapse in $timer_next"
        report "$verdict" systemd "$unit.timer is ${timer_enabled:-unknown}/${timer_active:-unknown}; $next_txt; last $unit.service Result=${svc_result:-unknown}"
        [ "$verdict" = warn ] && report warn systemd "that timer state means the schedule is not doing its job; try: systemctl --user enable --now $unit.timer, then: journalctl --user -u $unit.service"
    fi
fi

# ---- 9. watcher and tray --------------------------------------------------
# Over SSH there is normally no tray and that is not a fault, so its absence is
# a warning that says so. Only the icon directory has to exist on disk.
case "${WATCH,,}" in
    1|true|yes|on|enabled)
        if ! have systemctl; then
            report warn watch "WATCH is on but systemctl is not on PATH, so the watcher unit could not be read"
        else
            watch_active="$(timeout 10 systemctl --user is-active "$unit-watch.service" 2>&1 || true)"
            if [ "$watch_active" = active ]; then
                report ok watch "$unit-watch.service is active"
            elif [ "$watch_active" = failed ]; then
                # The unit's own start limit is what stops the loop a permanent
                # inotifywait failure would otherwise make: the watcher exits 1 on
                # purpose after three of them, Restart=always starts it again, and
                # five starts inside five minutes leaves the unit failed. The
                # recovery is a reset and a start, and the reason the watcher gave
                # is in the journal.
                report warn watch "$unit-watch.service failed, so systemd stopped restarting it; its own reason is in: journalctl --user -u $unit-watch.service -n 20 ; then: systemctl --user reset-failed $unit-watch.service && systemctl --user start $unit-watch.service"
            else
                report warn watch "WATCH is on in the config but $unit-watch.service is ${watch_active:-not reporting a state}; ./install.sh writes the unit, then: systemctl --user enable --now $unit-watch.service"
            fi
        fi
        have inotifywait || report warn watch "inotifywait is missing (inotify-tools), so the watcher cannot start even once its unit is enabled"
        ;;
    *)
        if ! have systemctl; then
            report ok watch "WATCH is off, and systemctl is not on PATH, so the watcher unit cannot be read"
        else
            # WATCH off with the unit still running means syncs keep starting on
            # every local edit. The old line asserted there was no watcher
            # without asking systemd, so it certified exactly this state healthy.
            watch_active="$(timeout 10 systemctl --user is-active "${unit}-watch.service" 2>&1 || true)"
            watch_enabled="$(timeout 10 systemctl --user is-enabled "${unit}-watch.service" 2>&1 || true)"
            if [ "$watch_active" = active ] || [ "$watch_enabled" = enabled ]; then
                report warn watch "WATCH is off in the config but ${unit}-watch.service is ${watch_enabled:-unknown}/${watch_active:-unknown}; turn it off with: systemctl --user disable --now ${unit}-watch.service"
            else
                report ok watch "WATCH is off and ${unit}-watch.service is ${watch_enabled:-unknown}/${watch_active:-unknown}"
            fi
        fi
        ;;
esac

# The tray is found by the fact it publishes about itself, not by scanning the
# machine's process list. It takes an exclusive flock on its own lock file for
# its whole life (bin/onedrive-tray, acquire_lock) in this install's runtime
# directory, so that lock answers "is a tray running for THIS install", and
# nothing else has to be guessed.
#
# The probe this replaces was `timeout 5 pgrep -f` over the
# interpreter-and-script pattern 'python3 .*/onedrive-tray': the `timeout`
# process's own command line holds that pattern, so the probe
# matched itself, and pgrep is machine-wide, so another install's tray matched
# too. Measured in a sandbox with no tray at all, the doctor printed
# "ok tray running (pid N)", with two different, already-dead pids on
# consecutive runs, and the two "no tray process" branches below it were dead
# code. flock -n on a held lock fails, which is the whole test.
tray_lock_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
tray_lock="$tray_lock_dir/rclone-onedrive-tray.lock"
tray_running=0; tray_unknown=0; tray_pid=""
if [ -e "$tray_lock" ]; then
    if have flock; then
        if exec 8<"$tray_lock" 2>/dev/null; then
            flock -n 8 2>/dev/null || tray_running=1
            exec 8<&-
        else
            tray_unknown=1
        fi
    else
        # The flock check above already failed the run; saying "no tray" here
        # would be a second, invented answer.
        tray_unknown=1
    fi
fi
# A pid for the line, read from the kernel: /proc/locks names the holder of a
# FLOCK by pid, and for this lock that is the tray. When it cannot be read the
# word is "unknown" rather than a guess.
if [ "$tray_running" -eq 1 ]; then
    tray_inode="$(stat -c %i -- "$tray_lock" 2>/dev/null || true)"
    if [ -n "$tray_inode" ] && [ -r /proc/locks ]; then
        # The device field is major:minor:inode in hex, and a tmpfs minor such as
        # "2e" is why this is not [0-9]+: on /tmp the all-digits form matched
        # nothing and the pid came out unknown.
        tray_pid="$(grep -E "FLOCK[[:space:]]+ADVISORY[[:space:]]+WRITE[[:space:]]+[0-9]+[[:space:]]+[0-9a-fA-F]+:[0-9a-fA-F]+:${tray_inode}[[:space:]]" \
            /proc/locks 2>/dev/null | head -1 | tr -s ' ' | cut -d' ' -f5 || true)"
    fi
    case "$tray_pid" in ''|*[!0-9]*) tray_pid="unknown" ;; esac
fi
icons_dir="$DATA_DIR/icons"
# The tray draws its status icons into this directory at start. A directory that
# exists is not the same thing as icons in it: an unwritable or full directory
# left the tray with a blank panel icon and no message anywhere, and this line
# called it ok because it tested -d alone. Counted in bash rather than with find,
# because this script runs on the suite's narrow PATH, where only the tools the
# cases symlink exist.
icon_files=0
for icon_file in "$icons_dir"/*.png; do
    if [ -e "$icon_file" ]; then
        icon_files=$((icon_files + 1))
    fi
done
if [ "$tray_running" -eq 1 ] && [ "$icon_files" -gt 0 ]; then
    report ok tray "running (pid $tray_pid), icons in $icons_dir"
elif [ "$tray_running" -eq 1 ] && [ -d "$icons_dir" ]; then
    report warn tray "running (pid $tray_pid) but no icon was written to $icons_dir, so the panel icon is blank; check that the directory is writable and not full"
elif [ "$tray_running" -eq 1 ]; then
    report warn tray "running (pid $tray_pid) but $icons_dir is missing; the tray draws the icons there at start, so check for a cairo or permission problem"
elif [ "$tray_unknown" -eq 1 ]; then
    report warn tray "$tray_lock exists but could not be tested with flock, so whether a tray is running could not be told"
elif [ -d "$icons_dir" ]; then
    report warn tray "no tray process, but $icons_dir exists; that is normal over SSH or without a desktop session"
else
    report warn tray "no tray process and no $icons_dir; start it with onedrive-tray once a graphical session is there"
fi

# ---- 10. the log file -----------------------------------------------------
# The wrapper stops before syncing when its log cannot be opened, so that is a
# failure; a log over MAX_LOG_BYTES is only the next run's rotation.
log_dir="$(dirname "$LOG")"; probe_dir="$log_dir"
while [ ! -d "$probe_dir" ] && [ "$probe_dir" != / ] && [ "$probe_dir" != . ]; do
    probe_dir="$(dirname "$probe_dir")"
done
if [ -e "$LOG" ]; then
    if [ ! -f "$LOG" ] && [ ! -c "$LOG" ]; then
        # A directory passes -e and -w, and stat then answers 4096 bytes for it,
        # so this row said "writable, 4096 of 5242880 bytes" and the summary said
        # nothing failed while the wrapper refused the same path with "cannot
        # write the log ...: Is a directory". A fifo passes both too, and the
        # wrapper blocks on the append it opens the log with. One path, one
        # verdict: what the wrapper will do is what this row says.
        #
        # A character device is the exception, and it is not a regular file
        # either: onedrive-sync opens the log by appending to it, which is what
        # /dev/null is for, and its only other use of the path is the rotation
        # guard `[ -f "$LOG" ]`, which simply skips a file it cannot size. So
        # LOG=/dev/null is a working install, and this row failed it.
        report fail logfile "$LOG is not a regular file, so onedrive-sync cannot open it as a log (a directory makes it stop before it syncs and a fifo blocks it); point LOG at a file or remove the path in $CONFIG_FILE"
    elif [ ! -w "$LOG" ]; then
        report fail logfile "$LOG is not writable, so onedrive-sync stops before it syncs; fix its owner or point LOG somewhere else in $CONFIG_FILE"
    else
        log_size="$(stat -c%s -- "$LOG" 2>/dev/null || echo 0)"
        case "$MAX_LOG_BYTES" in
            # One key, one verdict. The config check above judges MAX_LOG_BYTES
            # too, and this branch used to answer the same value with a warn: a
            # config the wrapper refuses to run with then came out as "nothing
            # failed", exit 0. The sentence stays, including what to put there;
            # only the verdict follows the wrapper's.
            ''|*[!0-9]*) report fail logfile "$LOG is writable, but MAX_LOG_BYTES='$MAX_LOG_BYTES' is not a positive integer, which onedrive-sync refuses to run with; give it a byte count (the default is 5242880) or empty the key" ;;
            *) if [ "$log_size" -gt "$MAX_LOG_BYTES" ]; then
                   report warn logfile "$LOG is writable at $log_size bytes, above MAX_LOG_BYTES=$MAX_LOG_BYTES; the next run rotates it to $LOG.1"
               else
                   report ok logfile "$LOG is writable, $log_size of $MAX_LOG_BYTES bytes"
               fi ;;
        esac
    fi
elif [ -w "$probe_dir" ]; then
    report ok logfile "$LOG does not exist yet and $log_dir is writable; the first run creates it"
else
    report fail logfile "neither $LOG nor its directory exists, and $probe_dir is not writable, so onedrive-sync cannot open its log; create $log_dir or point LOG elsewhere in $CONFIG_FILE"
fi

# ---- 11. the remote -------------------------------------------------------
# The one check that leaves the machine, so --offline skips it entirely. It is a
# read-only listing under timeout, and it is safe while a sync is running.
#
# The verdicts follow the exit contract at the top of this file: a network
# problem or a timeout is a warn, because the next run retries it and an offline
# laptop must not read as a broken install. A refused sign-in is a fail, because
# nothing but a person re-authorising the remote clears it, and so are an unset
# REMOTE and a missing rclone. Those four say different things on the line:
# "unreachable" and "did not answer within 20s" for the two that retry,
# "refused the sign-in" for the one that does not, and a plain statement of what
# is missing for the last two.
if [ "$OFFLINE" -eq 0 ]; then
    if [ -z "$REMOTE" ]; then
        report fail remote "REMOTE is not set in $CONFIG_FILE, so there is nothing to sync with"
    elif ! have "$RCLONE"; then
        report fail remote "rclone is not on PATH, so the remote cannot be probed"
    else
        probe_out="$(timeout 20 "$RCLONE" lsd "$REMOTE" --max-depth 1 2>&1)"
        probe_rc=$?
        probe_line="$(printf '%s\n' "$probe_out" | head -1 | cut -c1-160)"
        if [ "$probe_rc" -eq 0 ]; then
            report ok remote "answers (rclone lsd $REMOTE)"
        elif [ "$probe_rc" -eq 124 ]; then
            report warn remote "$REMOTE did not answer within 20s, so this is a network problem the next run retries, not a sign-in failure; check the connection and any proxy, then try: rclone lsd \"$REMOTE\""
        else
            case "$(classify_hint "$probe_out")" in
                auth) report fail remote "refused the sign-in: $probe_line; that needs a person, so re-authorise with the tray item, or: rclone config reconnect ${REMOTE%%:*}:." ;;
                network) report warn remote "unreachable: $probe_line; that is a network problem the next run retries, not a sign-in failure" ;;
                *) report fail remote "rclone lsd failed (rc=$probe_rc): $probe_line" ;;
            esac
        fi
    fi
fi

# ---- summary --------------------------------------------------------------
if [ "$n_fail" -eq 0 ]; then
    printf '%s: %d ok, %d warn, nothing failed\n' "$APP" "$n_ok" "$n_warn"
    exit 0
fi
printf '%s: %d ok, %d warn, %d failed\n' "$APP" "$n_ok" "$n_warn" "$n_fail"
exit 1
