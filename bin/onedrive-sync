#!/usr/bin/env bash
#
# onedrive-sync: a resilient wrapper around `rclone bisync`.
#
# Why this exists:
#   * rclone bisync is marked EXPERIMENTAL and, on rclone < 1.65, *any*
#     interrupted run (suspend, power loss, network drop) leaves it demanding a
#     manual `--resync` forever. This wrapper enables the modern self-healing
#     flags and adds a few safety nets of its own.
#   * systemd's default TimeoutStartSec for Type=oneshot is 90s, which kills a
#     long first-time sync half way through.
#   * A sync interrupted by suspend leaves a lock file that blocks the next run.
#
# Usage:
#   onedrive-sync              incremental sync (3 attempts, 60s apart)
#   onedrive-sync --resync     rebuild the sync baseline
#   onedrive-sync --dry-run    show what a run would do, change nothing
#   onedrive-sync --verbose    pass --verbose through to rclone (-v works too)
#   onedrive-sync --force      ignore the delete cap for this run
#
# Configuration: ~/.config/rclone-onedrive-tray/config  (see config.example)
#
# The access check (CHECK_ACCESS) is the one setting that changes what bisync
# demands of the tree rather than only how it behaves: with it on, a marker file
# has to exist at the same place on both sides, and bin/onedrive-check-access
# creates it. See docs/TROUBLESHOOTING.md.
#
set -uo pipefail

APP="onedrive-sync"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rclone-onedrive-tray"
CONFIG_FILE="$CONFIG_DIR/config"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/rclone-onedrive-tray"

die() { printf '%s: %s\n' "$APP" "$*" >&2; exit 1; }

# The two refusals that have no log to write to stay with die(): this one, because
# the file that would say where LOG is is the file that is missing, and the
# unwritable-log one below, which is about the log itself. Everything after them
# goes through refuse().
[ -f "$CONFIG_FILE" ] || die "config not found: $CONFIG_FILE (run install.sh first)"
# shellcheck source=/dev/null
. "$CONFIG_FILE"

RCLONE="${RCLONE:-rclone}"
LOG="${LOG:-$CACHE_DIR/sync.log}"
FILTERS_FILE="${FILTERS_FILE:-$CONFIG_DIR/filters.txt}"
EXCLUDE_FOLDERS_FILE="${EXCLUDE_FOLDERS_FILE:-$CONFIG_DIR/exclude-folders.txt}"
MAX_DELETE="${MAX_DELETE:-100}"
# Off unless the config asks for it, so an existing install keeps the command
# line it had. See the access-check paragraph below.
CHECK_ACCESS="${CHECK_ACCESS:-0}"
CHECK_FILENAME="${CHECK_FILENAME:-}"
MAX_LOG_BYTES="${MAX_LOG_BYTES:-5242880}"
RETRIES="${RETRIES:-3}"
RETRY_DELAY="${RETRY_DELAY:-60}"

# ---------------------------------------------------------------- the log
# An unwritable log directory used to be silent: the directory creation hid its
# own failure, the run carried on and could "succeed" having recorded nothing,
# and the failure hint then pointed at a file that could not exist. Open the log
# for append here, before the run, and stop with the path if that fails. The log
# and the cache are this run's own state, so they are still created for a run that
# goes on to refuse below: the refusal has to be readable.
#
# This block comes before every other refusal in the file for that reason. A
# refusal is a run that ends here, and a run whose only trace was a line on
# stderr (the journal) left the log empty, so onedrive-doctor reported that
# nothing had ever run and the tray showed an unknown state with no reason in it.
log_dir="$(dirname "$LOG")"
mkdir -p "$log_dir" "$CACHE_DIR" 2>/dev/null || true
if ! log_err="$({ : >>"$LOG"; } 2>&1)"; then
    # bash's own message ends with the reason ("... : Permission denied").
    log_err="${log_err##*: }"
    [ -n "$log_err" ] || log_err="it could not be opened for append"
    die "cannot write the log $LOG: $log_err (check that $log_dir is writable, or point LOG somewhere else in $CONFIG_FILE)"
fi

# The stamp is pinned to the C locale on purpose: a locale whose %Y is not
# Gregorian (fa_IR writes 1405 where this reads 2026) put a calendar in the log
# that no reader can match. The doctor parses the field with `date -d` and the
# tray parses it with strptime, and neither can know which calendar wrote the
# file, so the writer is the only place this can be settled.
log_line() { printf '%s %s\n' "$(LC_ALL=C date '+%Y/%m/%d %H:%M:%S')" "$*" >>"$LOG"; }

# ---------------------------------------------------------------- result marker
# One machine-readable line per run, written last, so a reader no longer has to
# match English in a log this script shares with rclone. The format is frozen:
#
#   ONEDRIVE_RESULT v=1 state=<synced|error|stopped> tag=<a-z|none> when=HH:MM msg=<text>
#
# state=synced, whose tag is the word none, is a run that succeeded, state=stopped
# is a run that cannot be cleared by another attempt (a permanent class, or a
# refusal before rclone was ever invoked), and state=error is a run that used up
# its attempts (with the tag of the last failure). msg is the sentence the hint
# prints after its "[tag] ", so a reader can show what the log shows without
# parsing it. It goes through log_line, so it carries the same timestamp prefix as
# every other line, and when= is the local HH:MM the tray shows today.
result_line() {  # result_line <state> <tag> <message>
    log_line "ONEDRIVE_RESULT v=1 state=$1 tag=$2 when=$(LC_ALL=C date '+%H:%M') msg=$3"
}

# Stop the run with a message that is also in the log. die() alone goes to stderr,
# which systemd puts in the journal, and the journal is not where the tray or the
# doctor look. The tag is "other", the class whose raw sentence a reader shows
# rather than interpreting, because every message here is this script's own.
refuse() {  # refuse <message>
    log_line "ERROR: $*"
    result_line stopped other "$*"
    die "$*"
}

# Checked here rather than with ${VAR:?}, which is bash printing its own line to
# stderr before this script could write anything. The default expansion is what
# covers an unset key under set -u; the ${VAR:?} form used to cover both.
[ -n "${REMOTE:-}" ] || refuse "REMOTE is not set in $CONFIG_FILE"
[ -n "${LOCAL:-}" ] || refuse "LOCAL is not set in $CONFIG_FILE"

# A numeric key holding something else used to fail in three quiet ways: `seq 1
# three` printed nothing, so the retry loop never ran and a run that never
# invoked rclone ended on "all 0 attempts failed"; RETRY_DELAY="three" killed the
# sleep between two attempts; MAX_LOG_BYTES="5MB" made the rotation comparison
# error out and skip the rotation without a word. Each of the three now stops the
# run with one line naming the key, the value and the file it came from, which is
# the only way the reader can find the typo. MAX_DELETE keeps its own tolerant
# handling below, because a count of 0 and a count larger than the folder are
# both meaningful there.
require_positive_int() {  # require_positive_int <KEY>
    local key="$1" value="${!1}"
    # Trimmed first, so a stray space is read rather than refused: what is judged
    # is the shape of the number, not the whitespace around it.
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    case "$value" in
        ''|*[!0-9]*) refuse "$key='${!1}' is not a positive integer in $CONFIG_FILE" ;;
    esac
    [ "$value" -gt 0 ] || refuse "$key='${!1}' is not a positive integer in $CONFIG_FILE"
    printf -v "$key" '%s' "$value"
}
require_positive_int RETRIES
require_positive_int RETRY_DELAY
require_positive_int MAX_LOG_BYTES
# An absent key keeps the documented defaults. A key that is present and empty
# means exactly that, no extra flags: somebody who empties it is asking for the
# command line rclone would have built on its own. The old :- expansion could not
# tell the two apart and handed the full default set to both.
DEFAULT_BISYNC_ARGS="--resilient --recover --max-lock 2m --conflict-resolve none --conflict-loser num --stats 2s"
if [ -n "${BISYNC_ARGS+x}" ]; then
    bisync_args_origin="config"
else
    BISYNC_ARGS="$DEFAULT_BISYNC_ARGS"
    bisync_args_origin="default"
fi
# Bandwidth cap for the whole run, in rclone size syntax. Empty or absent means
# no limit at all. The tray's settings dialog writes this key, so the value is
# read tolerantly here and its shape judged in the argv block further down.
BW_LIMIT="${BW_LIMIT:-}"
# The lock lives beside the state it protects, not in /tmp: a fixed /tmp name
# would serialise every configuration on the machine against each other, and
# /tmp is world-writable, so any local user could hold it and stall the timer.
LOCK_FILE="$CACHE_DIR/sync.lck"
RCLONE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/rclone"

command -v "$RCLONE" >/dev/null 2>&1 || refuse "rclone not found in PATH"

# Fail loudly if the locking tool is absent. Without this check a missing flock
# makes the command exit 127, `!` turns that into success, and every run reports
# "another sync is already running" while never invoking rclone at all: a silent
# total failure that looks like normal activity in the log.
command -v flock >/dev/null 2>&1 ||
    refuse "flock not found (it ships with util-linux); refusing to run without the lock"

# A missing LOCAL used to be created here, which turned a typo in the path or an
# unmounted tree into a fresh directory that the run then treated as the sync
# root: bisync would read an empty Path1, CHECK_ACCESS is off by default, and only
# the delete cap stands between that emptiness and the cloud. onedrive-check and
# onedrive-watch already refuse the same state, onedrive-doctor already prints
# this mkdir, and setup.sh creates the directory for a config it writes, so the
# wrapper refuses too and names the one command that fixes it.
if [ ! -d "$LOCAL" ]; then
    refuse "$LOCAL does not exist. Create it first:  mkdir -p \"$LOCAL\"  (or point LOCAL at the right directory in $CONFIG_FILE)"
fi

# ---------------------------------------------------------------- mutual exclusion
# A manual run racing the systemd timer corrupts bisync's .lst listings.
exec 9>"$LOCK_FILE" ||
    refuse "cannot open the lock file $LOCK_FILE (is $CACHE_DIR writable?)"
if ! flock -w 120 9; then
    echo "$APP: another sync is already running, skipping this run" >&2
    log_line "NOTICE: another run holds the lock, skipping"
    exit 0
fi

# ---------------------------------------------------------------- stale locks
# bisync's lock file records the owner PID. After a suspend/power loss the lock
# survives; if its owner is gone we can drop it immediately instead of waiting
# for --max-lock to expire. It is a function because rclone can also die in the
# middle of a run (the OOM killer, a kill, a crash) and leave the lock behind for
# every attempt that follows, where only the retry loop can clear it.
sweep_stale_locks() {
    local lck held_pid
    for lck in "$RCLONE_CACHE"/bisync/*.lck; do
        [ -e "$lck" ] || continue
        held_pid=$(grep -o '"PID"[[:space:]]*:[[:space:]]*"[0-9]\+"' "$lck" 2>/dev/null |
            grep -o '[0-9]\+' | head -1)
        if [ -n "$held_pid" ] && ! kill -0 "$held_pid" 2>/dev/null; then
            rm -f "$lck"
            log_line "NOTICE: removed stale lock (owner pid $held_pid is gone): $(basename "$lck")"
        fi
    done
}
sweep_stale_locks

# ---------------------------------------------------------------- log rotation
if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt "$MAX_LOG_BYTES" ]; then
    mv -f "$LOG" "$LOG.1"
fi

# ---------------------------------------------------------------- delete cap
# rclone bisync reads --max-delete as a PERCENTAGE of the file pair, while the
# config and the documentation promise a count. Passing the count straight
# through therefore capped nothing at all. Measured on rclone 1.75.1:
#
#   --max-delete 100, 250 of 300 files deleted -> rc 0, deletions propagated
#   --max-delete 5,   150 of 200 files deleted -> "Safety abort: too many
#                                                  deletes (>5%, 150 of 200)"
#
# So the count is converted into the equivalent percentage, using the size of
# the pair as rclone last recorded it. Flooring the division means the cap
# trips slightly before the configured count rather than after it.
pair_slug() { printf '%s' "$1" | sed -e 's|^/||' -e 's|[/: ]|_|g'; }

pair_size() {
    # rclone names the listing <left>..<right>.path1.lst and keeps one per pair.
    # Only the right half is reliable: with an alias remote rclone resolves the
    # left half to the target path, so anchoring on the local side is what
    # matches in both cases. The -old and -err variants do not match at all.
    local local_slug listing count best=0 left
    local -a halves=()
    local_slug="$(pair_slug "$LOCAL")"
    for listing in "$RCLONE_CACHE"/bisync/*.."$local_slug".path1.lst; do
        [ -f "$listing" ] || continue
        left="${listing##*/}"; left="${left%%..*}"
        case " ${halves[*]:-} " in *" $left "*) ;; *) halves+=("$left") ;; esac
        count="$(grep -c '^-' "$listing" 2>/dev/null || true)"
        count="${count//[^0-9]/}"
        [ -n "$count" ] && [ "$count" -gt "$best" ] && best="$count"
    done
    # More than one left half means more than one pair names this local path.
    # Taking the largest count then produced a denominator several times too big
    # in testing, which made a legitimate deletion look like a mass one, so the
    # size is reported as unknown and the caller falls back to a small cap.
    if [ "${#halves[@]}" -gt 1 ]; then
        log_line "WARNING: ${#halves[@]} bisync pairs share $LOCAL, so the pair size cannot be told apart"
        printf '0'
        return
    fi
    # The local tree is the only measure available before the first run has
    # written a listing. Once one exists it is the count rclone itself compares
    # the percentage against, so the tree is not walked: on a large folder that
    # walk ran before every single sync, timer runs included.
    if [ "$best" -gt 0 ]; then
        printf '%s' "$best"
        return
    fi
    count="$(find "$LOCAL" -type f 2>/dev/null | wc -l)"
    count="${count//[^0-9]/}"
    [ -n "$count" ] && [ "$count" -gt "$best" ] && best="$count"
    printf '%s' "$best"
}

# An empty value leaves the flag off entirely, so rclone's own default applies.
# That default is 50%, which the upstream documentation calls a safety net against
# deleting everything after a network failure or a mistake. Passing 100 would turn
# it off, so it is only passed when the configuration actually asks for it.
max_delete_pct=""
if [ "$MAX_DELETE" -eq 0 ] 2>/dev/null; then
    max_delete_pct=0                  # documented as "no deletions allowed"
elif [ "$MAX_DELETE" -gt 0 ] 2>/dev/null; then
    pair_total="$(pair_size)"
    pair_total="${pair_total//[^0-9]/}"
    if [ -n "$pair_total" ] && [ "$pair_total" -gt 0 ]; then
        max_delete_pct=$(( MAX_DELETE * 100 / pair_total ))
        # rclone takes a whole percentage (measured: --max-delete 0.5 is refused
        # with "parsing \"0.5\" as int64 failed"), so a count below one percent of
        # the pair cannot be expressed as one, and flooring to 0% would refuse
        # every deletion instead. The cap is one percent, which allows MORE files
        # than the count said: measured on rclone 1.75.1, MAX_DELETE=1 over a
        # 397-file pair passed --max-delete 1%, three deletions went through with
        # rc 0, and the run tripped at five ("Safety abort: too many deletes
        # (>1%, 5 of 397)"). The count is therefore reported for what it really
        # is, with the number of files the percentage allows, rather than repeated
        # as if it still held. The number is rounded down, because rclone trips
        # when the deletions exceed the percentage, so that is the largest count
        # which cannot trip it.
        [ "$max_delete_pct" -lt 1 ] && max_delete_pct=1
        max_delete_files=$(( max_delete_pct * pair_total / 100 ))
        if [ "$max_delete_pct" -ge 100 ]; then
            # The configured count is at least the whole pair, so the faithful
            # translation allows everything, including the deletions rclone
            # would have blocked on its own.
            max_delete_pct=100
            log_line "NOTICE: MAX_DELETE=$MAX_DELETE is at least the $pair_total known files, so no delete cap is in effect"
        elif [ "$max_delete_files" -ne "$MAX_DELETE" ]; then
            log_line "NOTICE: delete cap MAX_DELETE=$MAX_DELETE of about $pair_total files = --max-delete ${max_delete_pct}%; rclone takes a whole percentage, so this allows about $max_delete_files deletion(s), not $MAX_DELETE"
        else
            log_line "NOTICE: delete cap MAX_DELETE=$MAX_DELETE of about $pair_total files = --max-delete ${max_delete_pct}%"
        fi
    else
        # Nothing to measure: no listing and an empty local tree. Not knowing is
        # not a reason to allow every deletion, so keep a small cap.
        max_delete_pct=5
        log_line "NOTICE: delete cap MAX_DELETE=$MAX_DELETE with no known pair size, using --max-delete 5%"
    fi
else
    log_line "WARNING: MAX_DELETE='$MAX_DELETE' is not a usable count, using rclone's --max-delete default of 50%"
fi

# ---------------------------------------------------------------- access check
# rclone's --check-access looks for a marker file with the same name in the same
# places on both sides and aborts before changing anything if it is missing on
# one of them. That is the failure this project cares most about: a network,
# authorisation or mount problem leaves one side looking empty, which without the
# check reads as "everything over there was deleted". Measured on rclone 1.75.1,
# a missing RCLONE_TEST on Path2 aborts with
#     "Access test failed: Path1 count 1, Path2 count 0 - RCLONE_TEST"
#     "Bisync critical error: check file check failed"    (rc 7)
# and nothing is copied or deleted. rclone never creates the file, hence
# bin/onedrive-check-access. Off by default: turning it on mid-flight is a
# configuration change, and a run whose marker files are missing would fail.
#
# Measured deviation from the obvious reading: rclone compares names and
# locations, never contents, so an empty marker file passes. Only a missing one
# aborts.
case "${CHECK_ACCESS,,}" in
    1|true|yes|on|enabled) check_access=1 ;;
    ''|0|false|no|off|disabled) check_access=0 ;;
    *) check_access=0
       log_line "WARNING: CHECK_ACCESS='$CHECK_ACCESS' is not a yes/no value, leaving the access check off" ;;
esac
# CHECK_FILENAME only means anything together with the check. An empty value
# leaves rclone on its own default, which upstream documents as RCLONE_TEST.
check_filename=""
if [ "$check_access" -eq 1 ]; then
    if [ -n "$CHECK_FILENAME" ]; then
        check_filename="$CHECK_FILENAME"
        log_line "NOTICE: access check on with an explicit filename: $check_filename"
    else
        log_line "NOTICE: access check on, looking for RCLONE_TEST on both sides"
    fi
fi

# ---------------------------------------------------------------- build argv
# Which of the two BISYNC_ARGS cases this run is in, said out loud: an empty
# value is a decision, and it should be possible to tell it apart in the log from
# a config that never had the key.
case "$bisync_args_origin" in
    config)
        if [ -n "$BISYNC_ARGS" ]; then
            log_line "NOTICE: BISYNC_ARGS is set, using it: $BISYNC_ARGS"
        else
            log_line "NOTICE: BISYNC_ARGS is set but empty, so no extra flags are passed to rclone"
        fi ;;
    default)
        log_line "NOTICE: BISYNC_ARGS is not in the config, using the built-in defaults" ;;
esac
# --force bypasses rclone's delete cap. Typed on the command line it is logged;
# inherited from BISYNC_ARGS it used to pass silently, which made every other
# guard in here look like it was still in force.
case " $BISYNC_ARGS " in
    *" --force "*)
        log_line "WARNING: --force is set in BISYNC_ARGS, so the delete cap cannot stop this run" ;;
esac
read -r -a BISYNC_OPTS <<<"$BISYNC_ARGS"

# ------------------------------------------------------ what this rclone has
# The built-in default set passes four flags that arrived in rclone 1.66:
# --recover, --max-lock, --conflict-resolve and --conflict-loser. The project
# documents a lower floor and install.sh only warns below 1.65, while the wrapper
# handed all four to every rclone. Measured end to end with the 1.65 release
# binary, a plain run ends:
#
#   Fatal error: unknown flag: --recover
#   [oldrclone] this rclone does not know the flags in BISYNC_ARGS;
#   --resilient/--recover need rclone >= 1.65 (check: rclone version)
#
# -- advice a 1.65 user cannot take, and nothing ever syncs. The answer is asked
# of rclone itself rather than compared against a version string hand-copied
# here, one `bisync --help` per run, and the --resync-mode question below reads
# the same answer, so a run never asks twice.
RCLONE_BISYNC_HELP=""
rclone_help_read=0
read_bisync_help() {
    [ "$rclone_help_read" -eq 1 ] && return 0
    rclone_help_read=1
    RCLONE_BISYNC_HELP="$("$RCLONE" bisync --help 2>/dev/null || true)"
}
# The release each capability-gated flag arrived in, for the NOTICE and for the
# failure hint. Measured against the release binaries: 1.63 lists none of them,
# 1.64 lists --resilient, 1.65 adds nothing, 1.66 lists all five.
flag_version() {
    case "$1" in
        --resilient) printf '1.64' ;;
        --recover|--max-lock|--conflict-resolve|--conflict-loser|--resync-mode)
            printf '1.66' ;;
        *) printf '' ;;
    esac
}
# Only the built-in default set is filtered: it is this project's own string, and
# it is the one that names flags a supported rclone may not have. A BISYNC_ARGS
# the user set is used as written, which is what the key documents.
if [ "$bisync_args_origin" = default ]; then
    CAP_FLAGS=" --recover --max-lock --conflict-resolve --conflict-loser "
    CAP_VALUE_FLAGS=" --max-lock --conflict-resolve --conflict-loser "
    dropped=""; kept_opts=()
    cap_i=0
    while [ "$cap_i" -lt "${#BISYNC_OPTS[@]}" ]; do
        cap_opt="${BISYNC_OPTS[$cap_i]}"
        case "$CAP_FLAGS" in
            *" $cap_opt "*)
                read_bisync_help
                if grep -q -- "$cap_opt" <<<"$RCLONE_BISYNC_HELP"; then
                    kept_opts+=("$cap_opt")
                    case "$CAP_VALUE_FLAGS" in
                        *" $cap_opt "*)
                            [ $((cap_i + 1)) -lt "${#BISYNC_OPTS[@]}" ] &&
                                kept_opts+=("${BISYNC_OPTS[$((cap_i + 1))]}")
                            cap_i=$((cap_i + 1)) ;;
                    esac
                else
                    # The flag goes, and with it the value it takes, or rclone
                    # would receive that value as a positional argument.
                    dropped="${dropped:+$dropped, }$cap_opt"
                    case "$CAP_VALUE_FLAGS" in
                        *" $cap_opt "*) cap_i=$((cap_i + 1)) ;;
                    esac
                fi ;;
            *) kept_opts+=("$cap_opt") ;;
        esac
        cap_i=$((cap_i + 1))
    done
    BISYNC_OPTS=("${kept_opts[@]}")
    if [ -n "$dropped" ]; then
        log_line "NOTICE: this rclone does not list $dropped (rclone 1.66 has them), so this run leaves them out; upgrade rclone to get the recovery and conflict handling they give"
    fi
fi

# BISYNC_ARGS is split on whitespace, not by a shell, so a quote in it is a
# character rclone receives rather than grouping: --exclude "/My Docs/**" arrives
# as three words, and the stray positional makes rclone bisync print its usage and
# exit 2, so every run fails until somebody reads the journal. A pattern that needs
# a space cannot be written in this key at all, so a token that begins or ends with
# a quote is refused here with the key named and the place to put it instead. A
# quote inside a word, such as a path like /home/o'brien, is one word and works, so
# it is left alone.
for opt in "${BISYNC_OPTS[@]-}"; do
    case "$opt" in
        \"*|*\"|\'*|*\')
            refuse "BISYNC_ARGS holds a token that begins or ends with a quote ('$opt'). The value is split on whitespace, not by a shell, so a pattern containing a space cannot be written here; put it in FILTERS_FILE or exclude-folders.txt" ;;
    esac
done

ARGS=(bisync "$REMOTE" "$LOCAL")
ARGS+=("${BISYNC_OPTS[@]}")

# verbose_flag <one argv word> -- true when rclone would read it as verbose.
#
# rclone refuses -v together with --log-level ("Can't set -v and --log-level"),
# so asking for verbose used to fail every attempt of the run. Verbose implies
# debug, which is what the flag is for. The check is on the flag rather than on one
# spelling of it: rclone parses -v, -vv and a cluster such as -Pv the same way, and
# -v is the only short flag it gives the letter v to (rclone help flags), so a
# short cluster holding one is verbose. The validator below asks the same question
# of the wrapper's own arguments, so -v works there too and not only in
# BISYNC_ARGS.
verbose_flag() {
    case "$1" in
        --verbose|--verbose=*) return 0 ;;
        --*)                   return 1 ;;
        -*v*)                  return 0 ;;
        *)                     return 1 ;;
    esac
}

verbose_wanted=0
for opt in "${BISYNC_OPTS[@]-}" "${@:-}"; do
    verbose_flag "$opt" && verbose_wanted=1
done
if [ "$verbose_wanted" -eq 1 ]; then
    ARGS+=(--log-file "$LOG")
else
    ARGS+=(--log-level INFO --log-file "$LOG")
fi
[ -n "$max_delete_pct" ] && ARGS+=(--max-delete "$max_delete_pct")

# The tray's settings dialog writes BW_LIMIT. A value rclone cannot parse turns
# every scheduled run into a failure, and the tray has no way to say why, so the
# shape is checked here: digits and letters with at most one dot, starting with a
# digit. The value is read tolerantly, since a dialog may hand it over with
# whitespace or a pair of quotes around it.
bw_limit="${BW_LIMIT#"${BW_LIMIT%%[![:space:]]*}"}"
bw_limit="${bw_limit%"${bw_limit##*[![:space:]]}"}"
case "$bw_limit" in
    \"*\") bw_limit="${bw_limit#\"}"; bw_limit="${bw_limit%\"}" ;;
    \'*\') bw_limit="${bw_limit#\'}"; bw_limit="${bw_limit%\'}" ;;
esac
bw_limit="${bw_limit#"${bw_limit%%[![:space:]]*}"}"
bw_limit="${bw_limit%"${bw_limit##*[![:space:]]}"}"
if [ -n "$bw_limit" ]; then
    if [[ "$bw_limit" =~ ^[0-9][0-9A-Za-z]*(\.[0-9A-Za-z]+)?$ ]]; then
        ARGS+=(--bwlimit "$bw_limit")
        log_line "NOTICE: bandwidth limit $bw_limit, passed as --bwlimit"
    else
        log_line "WARNING: BW_LIMIT='$BW_LIMIT' is not a usable rclone size (for example 1M, 500k, 1.5M), so no --bwlimit is passed"
    fi
fi
if [ "$check_access" -eq 1 ]; then
    ARGS+=(--check-access)
    [ -n "$check_filename" ] && ARGS+=(--check-filename "$check_filename")
fi
if [ -n "$FILTERS_FILE" ] && [ -f "$FILTERS_FILE" ]; then
    ARGS+=(--filters-file "$FILTERS_FILE")
fi

# ---------------------------------------------------------------- selected folders
# Top-level folders the user chose not to keep on this machine, one name per
# line, relative to REMOTE. Measured behaviour on rclone 1.75: excluding a folder
# touches neither side, so the local copy stays where it is and the cloud is left
# alone, and toggling one neither needs --resync nor touches the remote. The tray
# offers to delete the local copy separately, because leaving it there turns the
# folder into a trap.
if [ -n "$EXCLUDE_FOLDERS_FILE" ] && [ -f "$EXCLUDE_FOLDERS_FILE" ]; then
    excluded=0
    while IFS= read -r folder || [ -n "$folder" ]; do
        folder="${folder%%$'\r'}"                 # tolerate CRLF
        # Trim, so a line that holds nothing but spaces is nothing. It used to
        # become --exclude "/   /**", which is not a folder and not a no-op
        # either: rclone tried to match it on every run.
        folder="${folder#"${folder%%[![:space:]]*}"}"
        folder="${folder%"${folder##*[![:space:]]}"}"
        case "$folder" in ''|'#'*) continue ;; esac
        # One top-level folder name per line. A slash or a .. would escape the
        # top level and exclude a subtree the tray never offered, so it is
        # refused here with the reason rather than handed to rclone.
        case "$folder" in
            */*|*..*)
                log_line "WARNING: ignoring exclude entry '$folder': a folder name here must not contain '/' or '..'"
                continue ;;
        esac
        # rclone reads the pattern as a glob, so a folder literally named
        # "Photos [2024]" was handed to it as a character class, matched nothing,
        # and kept syncing while the tray reported it as left out. Each
        # metacharacter is wrapped in a class of its own, which is how a glob
        # spells "this character, literally".
        # The closing bracket first: wrapping a "[" produces a "]" of its own,
        # and a later pass over "]" would corrupt it.
        # One pass, because two would corrupt each other: wrapping "[" produces a
        # "]" for the next replacement to escape. The class holds "]" first, which
        # is how a bracket expression spells it.
        literal="$(printf '%s' "$folder" | sed -e 's/[][*?{}]/[&]/g')"
        ARGS+=(--exclude "/${literal}/**")
        excluded=$((excluded + 1))
    done < "$EXCLUDE_FOLDERS_FILE"
    [ "$excluded" -gt 0 ] && log_line "NOTICE: ${excluded} folder(s) deselected"
fi

resync_wanted=0
for arg in "$@"; do
    case "$arg" in
        --force)
            ARGS+=(--force)
            log_line "NOTICE: --force given, the delete cap will not stop this run" ;;
        --resync)
            resync_wanted=1
            ARGS+=("$arg") ;;
        --dry-run)
            ARGS+=("$arg") ;;
        *)
            # verbose_flag, so the short spellings of verbose are accepted here
            # too: -v and -vv are what an rclone user types, and refusing them
            # while the loop above treats them as verbose was two answers to one
            # question.
            if verbose_flag "$arg"; then
                ARGS+=("$arg")
            else
                printf '%s: unknown option: %s\n' "$APP" "$arg" >&2
                printf 'usage: %s [--resync] [--force] [--dry-run] [--verbose|-v]\n' "$APP" >&2
                exit 2
            fi ;;
    esac
done

# The flag, not $1: --resync used to be recognised in first position only, so
# "onedrive-sync --force --resync" skipped the name check and the log line.
if [ "$resync_wanted" -eq 1 ]; then
    # A name OneDrive refuses turns the first full upload into a retry loop, so
    # the tree is checked once, here, where the cost of a walk is nothing next to
    # the transfer that follows. It reports and carries on: the user may well
    # want the 700 files that are fine before dealing with the one that is not.
    #
    # The sibling script is preferred over the one on PATH because systemd runs
    # this with ExecStart and a minimal PATH, where the installed directory is
    # not necessarily present.
    check_cmd=""
    case "${BASH_SOURCE[0]}" in
        */*) self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
             [ -x "$self_dir/onedrive-check" ] && check_cmd="$self_dir/onedrive-check" ;;
    esac
    [ -n "$check_cmd" ] || check_cmd="$(command -v onedrive-check 2>/dev/null || true)"
    if [ -n "$check_cmd" ]; then
        check_rc=0
        check_report="$("$check_cmd" 2>&1)" || check_rc=$?
        if [ "$check_rc" -ne 0 ]; then
            # onedrive-check documents 1 for findings and 2 for a usage or
            # configuration problem, and the two want different sentences: a
            # LOCAL that does not exist announced as bad file names sends the
            # reader through their filenames for a fault that is in their config.
            check_first="$(printf '%s\n' "$check_report" | head -1)"
            case "$check_rc" in
                1) log_line "WARNING: names or paths OneDrive will refuse were found before the resync" ;;
                2) log_line "WARNING: onedrive-check stopped on a configuration problem, so the names were not checked: $check_first" ;;
                *) log_line "WARNING: onedrive-check exited $check_rc before the resync, so the names were not checked: $check_first" ;;
            esac
            printf '%s\n' "$check_report" >>"$LOG"
            printf '%s\n' "$check_report" >&2
        fi
    fi
    # The flag is already in ARGS: the option loop added it. This used to add it
    # again, which put "--resync --resync" on rclone's command line.
    #
    # Which copy wins when a file differs on both sides. rclone documents
    # --resync as "equivalent to --resync-mode path1", and Path1 here is the
    # REMOTE, so the cloud copy replaces the local one: measured on rclone 1.75.1,
    # a local file edited after the cloud copy was replaced by it, rc 0, no
    # *.conflict* file, and the local revision gone. A replacement is not a
    # delete, so the delete cap never looks at it either.
    #
    # --resync-mode newer keeps the copy that changed last, which is the honest
    # reading of "resync" for a file the user edited on this machine. It is not
    # in every rclone the project supports, so the capability is asked of rclone
    # itself rather than compared against a version string, once per run, here,
    # before the retry loop. On an rclone without it the old behaviour stays and
    # the log says so: a preview of the files cannot be promised (that would be a
    # --dry-run guess), and losing local edits silently is the one thing this
    # must not do. read_bisync_help is the same one call the flag filter above
    # made, so this asks nothing extra when that filter already ran.
    read_bisync_help
    if grep -q -- '--resync-mode' <<<"$RCLONE_BISYNC_HELP"; then
        ARGS+=(--resync-mode newer)
        log_line "NOTICE: --resync: this rclone knows --resync-mode, so where a file differs on both sides the newer copy wins"
    else
        log_line "WARNING: --resync: this rclone has no --resync-mode, so where a file differs on both sides the cloud copy replaces the local one; upgrade rclone to get the newer copy preferred, or copy the local files aside before this run"
    fi
    log_line "NOTICE: --resync requested, rebuilding baseline"
fi

# ---------------------------------------------------------------- failure hints
# Turn rclone's noise into one actionable sentence, prefixed with a stable tag.
# The tag lets a UI localise the message without pattern-matching English text.
# One definition per failure class, used both to pick the newest relevant line
# and to name it. Two copies of these patterns would drift apart.
RE_LOCK='prior lock file found'
RE_MAXDELETE='too many deletes|excessive deletes|deletion limit'
RE_ACCESS='access test failed|check file check failed'
# Anything that failed before the service answered belongs here, including a
# token refresh that never reached Microsoft. That case used to match the auth
# pattern below, because its message contains the word "token", and sent people
# to re-authorise a remote whose credentials were fine. Measured on 2026-09-30: a
# dead proxy produced
#   couldn't fetch token: Post ".../oauth2/v2.0/token": EOF
# and this said "authorisation may have expired" for 90 minutes.
RE_NETWORK='lookup .*:53|dial tcp|no such host|Temporary failure in name resolution|server misbehaving|couldn.t fetch token|connection reset|connection refused|i/o timeout|: EOF|unexpected EOF|no route to host|network is unreachable|TLS handshake|proxyconnect|context deadline exceeded'
RE_OLD='unknown flag|flag provided but not defined|unknown shorthand flag'
# Measured on rclone 1.75.1 against an empty remote: "Empty prior Path1 listing.
# Cannot sync to an empty directory: <lst>", followed by "Bisync critical error:
# empty prior Path1 listing: <lst>". The second line is also a "critical error",
# so before this class existed the generic resync pattern below answered it with
# "run: onedrive-sync --resync", which rebuilds an equally empty baseline and
# fails the same way on the next run.
RE_EMPTY='Empty prior Path1 listing'
RE_RESYNC='must run --resync|resync required|prior listings|critical error'
# A genuine refusal from Microsoft.
RE_AUTH='invalid_grant|401 Unauthorized|403 Forbidden|invalid_token|token expired|AADSTS'
ALL_HINTS="$RE_LOCK|$RE_MAXDELETE|$RE_ACCESS|$RE_NETWORK|$RE_OLD|$RE_EMPTY|$RE_RESYNC|$RE_AUTH"

hint_for() {
    local t tag msg newest
    t=$(tail -n 60 "$LOG" 2>/dev/null)

    # Classify the most recent relevant line. A log holds an hour of failures, and
    # the first branch that matched used to win no matter which line it came from:
    # a network failure followed by a real refusal was reported as the network
    # one, which is the wrong advice at the wrong moment.
    newest="$(printf '%s\n' "$t" | grep -iE "$ALL_HINTS" | tail -1)"
    [ -n "$newest" ] && t="$newest"

    if grep -qiE "$RE_LOCK" <<<"$t"; then
        tag=lock
        msg="a sync lock is still held; if this repeats, delete the *.lck files in ~/.cache/rclone/bisync"
    # Deliberately not matching the bare word max-delete: this wrapper logs its
    # own "--max-delete N%" conversion line just before the run, and matching it
    # tagged every unrelated failure as a delete-cap abort.
    elif grep -qiE "$RE_MAXDELETE" <<<"$t"; then
        tag=maxdelete
        msg="more than MAX_DELETE=$MAX_DELETE files would be deleted; if that is intended run: onedrive-sync --force"
    # Before the generic resync patterns: an access abort also ends with "Bisync
    # aborted. Must run --resync to recover", and answering that with --resync
    # sends the user to the one action that cannot fix a missing marker file.
    elif grep -qiE "$RE_ACCESS" <<<"$t"; then
        tag=access
        msg="the access check did not find ${CHECK_FILENAME:-RCLONE_TEST} on both sides, so nothing was changed. Restore the file (onedrive-check-access) or fix the side that cannot be read. Do not run --resync for this"
    # Before the network patterns, and the remote name is derived here so the
    # message can name the exact command; the tray offers the same thing as a menu
    # item, which is what most people should use. The order matters because
    # rclone 1.75.1 describes a refused sign-in in one line, "couldn't fetch
    # token: invalid_grant: maybe token expired? - try refreshing with rclone
    # config reconnect", which matches both tables: a marker that can only come
    # from Microsoft's answer settles it, while the network patterns also
    # describe a request that never arrived. Getting this wrong retries a
    # sign-in that no retry can fix.
    elif grep -qiE "$RE_AUTH" <<<"$t"; then
        tag=auth
        msg="the sign-in was refused or has expired; use the tray's 'Re-authorise OneDrive' item, or run: rclone config reconnect ${REMOTE%%:*}:"
    elif grep -qiE "$RE_NETWORK" <<<"$t"; then
        tag=network
        msg="network problem reaching the remote, so nothing was changed; the next run will retry"
    elif grep -qiE "$RE_OLD" <<<"$t"; then
        tag=oldrclone
        # rclone names the flag it refused ("Error: unknown flag: --recover"),
        # and the hint used to answer with --resilient/--recover whichever it was
        # while sending the reader to "rclone >= 1.65" -- the version a 1.65
        # install already has, and the one whose missing --recover caused the
        # failure. The flag that was really refused is read back out of rclone's
        # own line, and the version that has it comes from flag_version.
        old_flag="$(grep -oiE 'unknown flag: *-{1,2}[A-Za-z0-9-]+|unknown shorthand flag: *-{1,2}[A-Za-z0-9-]+|flag provided but not defined: *-{1,2}[A-Za-z0-9-]+' <<<"$t" |
            grep -oE -- '-{1,2}[A-Za-z0-9-]+' | tail -1 || true)"
        old_ver=""; [ -n "$old_flag" ] && old_ver="$(flag_version "$old_flag")"
        if [ -n "$old_flag" ] && [ -n "$old_ver" ]; then
            msg="this rclone does not know $old_flag; that flag arrived in rclone $old_ver (check: rclone version)"
        elif [ -n "$old_flag" ]; then
            msg="this rclone does not know $old_flag; the flags this wrapper passes need rclone 1.66 (check: rclone version)"
        else
            msg="this rclone does not know the flags in BISYNC_ARGS; the ones this wrapper passes need rclone 1.66 (check: rclone version)"
        fi
    # Before the generic resync patterns: an empty remote is refused with "Bisync
    # critical error" too, and answering it with --resync rebuilds an equally
    # empty baseline, so the next run fails identically. That is the advice loop
    # the README's no-account trial walks into.
    elif grep -qiE "$RE_EMPTY" <<<"$t"; then
        tag=emptyremote
        msg="the remote side is empty, which rclone refuses on an incremental run; put one file on either side, or add one and run onedrive-sync --resync, then the scheduled runs continue"
    elif grep -qiE "$RE_RESYNC" <<<"$t"; then
        tag=resync
        msg="sync baseline is invalid; run: onedrive-sync --resync"
    else
        tag=other
        msg="see log: $LOG"
    fi

    printf '[%s] %s' "$tag" "$msg"
}

# ---------------------------------------------------------------- main loop
# rclone only writes to --log-file once it has parsed its flags, so a bad flag
# (an rclone older than the arguments this config passes) would leave nothing
# behind but a journal line. Catch stderr here, copy it into the log, and let
# the journal keep it too.
ERRS="$(mktemp)"
trap 'rm -f "$ERRS"' EXIT

# The classes whose hint asks for something only a person can do: an expired
# sign-in, an access-check abort, a tripped delete cap and an rclone that does
# not know the flags. Retrying those spends the remaining attempts and their
# waits on a rerun that cannot succeed. Everything else (a network problem, a
# held lock, an unclassified failure) is retried as before.
PERMANENT_TAGS=" auth access maxdelete oldrclone "

# 0 until a permanent class stops the loop. The closing marker has to say
# state=stopped for that run and state=error for one that spent every attempt,
# and both reach the same exit below, so this is what tells them apart.
stopped=0

for i in $(seq 1 "$RETRIES"); do
    # Again at the top of every attempt: an attempt that was killed leaves its
    # lock behind with a dead owner, and without this the remaining attempts fail
    # on a lock the sweep above would have removed, spending their RETRY_DELAY to
    # report the same [lock] failure (the tag is not in PERMANENT_TAGS).
    sweep_stale_locks
    : >"$ERRS"
    "$RCLONE" "${ARGS[@]}" 2>"$ERRS"
    rc=$?

    if [ -s "$ERRS" ]; then
        cat "$ERRS" >>"$LOG"
        cat "$ERRS" >&2
    fi

    if [ "$rc" -eq 0 ]; then
        [ "$i" -gt 1 ] && echo "$APP: succeeded on attempt $i"
        result_line synced none "sync completed"
        exit 0
    fi

    hint=$(hint_for)
    # hint_for prints "[tag] message", and it runs in a subshell, so the tag is
    # read back out of the line it printed rather than left in a variable. The
    # sentence after the tag is what the closing marker carries as msg, so the
    # prose a person reads and the line a reader parses cannot drift apart.
    hint_tag="${hint#[}"
    hint_tag="${hint_tag%%]*}"
    hint_msg="${hint#*] }"
    printf '%s: attempt %d/%d failed (rc=%d) %s\n' "$APP" "$i" "$RETRIES" "$rc" "$hint" >&2
    log_line "ERROR: attempt $i/$RETRIES failed (rc=$rc) $hint"

    case "$PERMANENT_TAGS" in
        *" $hint_tag "*)
            log_line "NOTICE: not retrying: [$hint_tag] cannot be cleared by another attempt, so this round stops after $i"
            stopped=1
            break ;;
    esac

    [ "$i" -lt "$RETRIES" ] && sleep "$RETRY_DELAY"
done

# $i, not $RETRIES: a run that stopped at the first permanent failure made one
# attempt, and saying it made three is the same kind of lie as "all 0 attempts".
printf '%s: all %d attempts failed, giving up this round\n' "$APP" "$i" >&2
if [ "$stopped" -eq 1 ]; then
    result_line stopped "$hint_tag" "$hint_msg"
else
    result_line error "$hint_tag" "$hint_msg"
fi
exit 1
