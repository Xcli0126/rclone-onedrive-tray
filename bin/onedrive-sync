#!/usr/bin/env bash
#
# onedrive-sync: a resilient wrapper around `rclone bisync`.
#
# Why this exists:
#   * rclone bisync is marked EXPERIMENTAL and, on rclone < 1.65, *any*
#     interrupted run (suspend, power loss, network drop) leaves it demanding a
#     manual `--resync` forever. This wrapper enables the modern self-healing
#     flags and adds a few safety nets of its own.
#   * systemd's default TimeoutStartSec for Type=oneshot is 90s, which kills a
#     long first-time sync half way through.
#   * A sync interrupted by suspend leaves a lock file that blocks the next run.
#
# Usage:
#   onedrive-sync              incremental sync (3 attempts, 60s apart)
#   onedrive-sync --resync     rebuild the sync baseline
#
# Configuration: ~/.config/rclone-onedrive-tray/config  (see config.example)
#
# The access check (CHECK_ACCESS) is the one setting that changes what bisync
# demands of the tree rather than only how it behaves: with it on, a marker file
# has to exist at the same place on both sides, and bin/onedrive-check-access
# creates it. See docs/TROUBLESHOOTING.md.
#
set -uo pipefail

APP="onedrive-sync"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rclone-onedrive-tray"
CONFIG_FILE="$CONFIG_DIR/config"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/rclone-onedrive-tray"

die() { printf '%s: %s\n' "$APP" "$*" >&2; exit 1; }

[ -f "$CONFIG_FILE" ] || die "config not found: $CONFIG_FILE (run install.sh first)"
# shellcheck source=/dev/null
. "$CONFIG_FILE"

: "${REMOTE:?REMOTE is not set in $CONFIG_FILE}"
: "${LOCAL:?LOCAL is not set in $CONFIG_FILE}"

RCLONE="${RCLONE:-rclone}"
LOG="${LOG:-$CACHE_DIR/sync.log}"
FILTERS_FILE="${FILTERS_FILE:-$CONFIG_DIR/filters.txt}"
EXCLUDE_FOLDERS_FILE="${EXCLUDE_FOLDERS_FILE:-$CONFIG_DIR/exclude-folders.txt}"
MAX_DELETE="${MAX_DELETE:-100}"
# Off unless the config asks for it, so an existing install keeps the command
# line it had. See the access-check paragraph below.
CHECK_ACCESS="${CHECK_ACCESS:-0}"
CHECK_FILENAME="${CHECK_FILENAME:-}"
MAX_LOG_BYTES="${MAX_LOG_BYTES:-5242880}"
RETRIES="${RETRIES:-3}"
RETRY_DELAY="${RETRY_DELAY:-60}"
BISYNC_ARGS="${BISYNC_ARGS:---resilient --recover --max-lock 2m --conflict-resolve none --conflict-loser num --stats 2s}"
# The lock lives beside the state it protects, not in /tmp: a fixed /tmp name
# would serialise every configuration on the machine against each other, and
# /tmp is world-writable, so any local user could hold it and stall the timer.
LOCK_FILE="$CACHE_DIR/sync.lck"
RCLONE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/rclone"

command -v "$RCLONE" >/dev/null 2>&1 || die "rclone not found in PATH"

# Fail loudly if the locking tool is absent. Without this check a missing flock
# makes the command exit 127, `!` turns that into success, and every run reports
# "another sync is already running" while never invoking rclone at all: a silent
# total failure that looks like normal activity in the log.
command -v flock >/dev/null 2>&1 ||
    die "flock not found (it ships with util-linux); refusing to run without the lock"

mkdir -p "$(dirname "$LOG")" "$LOCAL" "$CACHE_DIR" 2>/dev/null

log_line() { printf '%s %s\n' "$(date '+%Y/%m/%d %H:%M:%S')" "$*" >>"$LOG"; }

# ---------------------------------------------------------------- mutual exclusion
# A manual run racing the systemd timer corrupts bisync's .lst listings.
exec 9>"$LOCK_FILE" ||
    die "cannot open the lock file $LOCK_FILE (is $CACHE_DIR writable?)"
if ! flock -w 120 9; then
    echo "$APP: another sync is already running, skipping this run" >&2
    log_line "NOTICE: another run holds the lock, skipping"
    exit 0
fi

# ---------------------------------------------------------------- stale locks
# bisync's lock file records the owner PID. After a suspend/power loss the lock
# survives; if its owner is gone we can drop it immediately instead of waiting
# for --max-lock to expire.
for lck in "$RCLONE_CACHE"/bisync/*.lck; do
    [ -e "$lck" ] || continue
    held_pid=$(grep -o '"PID"[[:space:]]*:[[:space:]]*"[0-9]\+"' "$lck" 2>/dev/null |
        grep -o '[0-9]\+' | head -1)
    if [ -n "$held_pid" ] && ! kill -0 "$held_pid" 2>/dev/null; then
        rm -f "$lck"
        log_line "NOTICE: removed stale lock (owner pid $held_pid is gone): $(basename "$lck")"
    fi
done

# ---------------------------------------------------------------- log rotation
if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt "$MAX_LOG_BYTES" ]; then
    mv -f "$LOG" "$LOG.1"
fi

# ---------------------------------------------------------------- delete cap
# rclone bisync reads --max-delete as a PERCENTAGE of the file pair, while the
# config and the documentation promise a count. Passing the count straight
# through therefore capped nothing at all. Measured on rclone 1.75.1:
#
#   --max-delete 100, 250 of 300 files deleted -> rc 0, deletions propagated
#   --max-delete 5,   150 of 200 files deleted -> "Safety abort: too many
#                                                  deletes (>5%, 150 of 200)"
#
# So the count is converted into the equivalent percentage, using the size of
# the pair as rclone last recorded it. Flooring the division means the cap
# trips slightly before the configured count rather than after it.
pair_slug() { printf '%s' "$1" | sed -e 's|^/||' -e 's|[/: ]|_|g'; }

pair_size() {
    # rclone names the listing <left>..<right>.path1.lst and keeps one per pair.
    # Only the right half is reliable: with an alias remote rclone resolves the
    # left half to the target path, so anchoring on the local side is what
    # matches in both cases. The -old and -err variants do not match at all.
    local local_slug listing count best=0 left
    local -a halves=()
    local_slug="$(pair_slug "$LOCAL")"
    for listing in "$RCLONE_CACHE"/bisync/*.."$local_slug".path1.lst; do
        [ -f "$listing" ] || continue
        left="${listing##*/}"; left="${left%%..*}"
        case " ${halves[*]:-} " in *" $left "*) ;; *) halves+=("$left") ;; esac
        count="$(grep -c '^-' "$listing" 2>/dev/null || true)"
        count="${count//[^0-9]/}"
        [ -n "$count" ] && [ "$count" -gt "$best" ] && best="$count"
    done
    # More than one left half means more than one pair names this local path.
    # Taking the largest count then produced a denominator several times too big
    # in testing, which made a legitimate deletion look like a mass one, so the
    # size is reported as unknown and the caller falls back to a small cap.
    if [ "${#halves[@]}" -gt 1 ]; then
        log_line "WARNING: ${#halves[@]} bisync pairs share $LOCAL, so the pair size cannot be told apart"
        printf '0'
        return
    fi
    # The local tree is a second opinion, and the only one available before the
    # first run has written a listing. The larger of the two is used, so a small
    # local side cannot inflate the percentage into uselessness.
    count="$(find "$LOCAL" -type f 2>/dev/null | wc -l)"
    count="${count//[^0-9]/}"
    [ -n "$count" ] && [ "$count" -gt "$best" ] && best="$count"
    printf '%s' "$best"
}

# An empty value leaves the flag off entirely, so rclone's own default applies.
# That default is 50%, which the upstream documentation calls a safety net against
# deleting everything after a network failure or a mistake. Passing 100 would turn
# it off, so it is only passed when the configuration actually asks for it.
max_delete_pct=""
if [ "$MAX_DELETE" -eq 0 ] 2>/dev/null; then
    max_delete_pct=0                  # documented as "no deletions allowed"
elif [ "$MAX_DELETE" -gt 0 ] 2>/dev/null; then
    pair_total="$(pair_size)"
    pair_total="${pair_total//[^0-9]/}"
    if [ -n "$pair_total" ] && [ "$pair_total" -gt 0 ]; then
        max_delete_pct=$(( MAX_DELETE * 100 / pair_total ))
        [ "$max_delete_pct" -lt 1 ] && max_delete_pct=1
        if [ "$max_delete_pct" -ge 100 ]; then
            # The configured count is at least the whole pair, so the faithful
            # translation allows everything, including the deletions rclone
            # would have blocked on its own.
            max_delete_pct=100
            log_line "NOTICE: MAX_DELETE=$MAX_DELETE is at least the $pair_total known files, so no delete cap is in effect"
        else
            log_line "NOTICE: delete cap MAX_DELETE=$MAX_DELETE of about $pair_total files = --max-delete ${max_delete_pct}%"
        fi
    else
        # Nothing to measure: no listing and an empty local tree. Not knowing is
        # not a reason to allow every deletion, so keep a small cap.
        max_delete_pct=5
        log_line "NOTICE: delete cap MAX_DELETE=$MAX_DELETE with no known pair size, using --max-delete 5%"
    fi
else
    log_line "WARNING: MAX_DELETE='$MAX_DELETE' is not a usable count, using rclone's --max-delete default of 50%"
fi

# ---------------------------------------------------------------- access check
# rclone's --check-access looks for a marker file with the same name in the same
# places on both sides and aborts before changing anything if it is missing on
# one of them. That is the failure this project cares most about: a network,
# authorisation or mount problem leaves one side looking empty, which without the
# check reads as "everything over there was deleted". Measured on rclone 1.75.1,
# a missing RCLONE_TEST on Path2 aborts with
#     "Access test failed: Path1 count 1, Path2 count 0 - RCLONE_TEST"
#     "Bisync critical error: check file check failed"    (rc 7)
# and nothing is copied or deleted. rclone never creates the file, hence
# bin/onedrive-check-access. Off by default: turning it on mid-flight is a
# configuration change, and a run whose marker files are missing would fail.
#
# Measured deviation from the obvious reading: rclone compares names and
# locations, never contents, so an empty marker file passes. Only a missing one
# aborts.
case "${CHECK_ACCESS,,}" in
    1|true|yes|on|enabled) check_access=1 ;;
    ''|0|false|no|off|disabled) check_access=0 ;;
    *) check_access=0
       log_line "WARNING: CHECK_ACCESS='$CHECK_ACCESS' is not a yes/no value, leaving the access check off" ;;
esac
# CHECK_FILENAME only means anything together with the check. An empty value
# leaves rclone on its own default, which upstream documents as RCLONE_TEST.
check_filename=""
if [ "$check_access" -eq 1 ]; then
    if [ -n "$CHECK_FILENAME" ]; then
        check_filename="$CHECK_FILENAME"
        log_line "NOTICE: access check on with an explicit filename: $check_filename"
    else
        log_line "NOTICE: access check on, looking for RCLONE_TEST on both sides"
    fi
fi

# ---------------------------------------------------------------- build argv
# --force bypasses rclone's delete cap. Typed on the command line it is logged;
# inherited from BISYNC_ARGS it used to pass silently, which made every other
# guard in here look like it was still in force.
case " $BISYNC_ARGS " in
    *" --force "*)
        log_line "WARNING: --force is set in BISYNC_ARGS, so the delete cap cannot stop this run" ;;
esac
read -r -a BISYNC_OPTS <<<"$BISYNC_ARGS"
ARGS=(bisync "$REMOTE" "$LOCAL")
ARGS+=("${BISYNC_OPTS[@]}")
ARGS+=(--log-level INFO --log-file "$LOG")
[ -n "$max_delete_pct" ] && ARGS+=(--max-delete "$max_delete_pct")
if [ "$check_access" -eq 1 ]; then
    ARGS+=(--check-access)
    [ -n "$check_filename" ] && ARGS+=(--check-filename "$check_filename")
fi
if [ -n "$FILTERS_FILE" ] && [ -f "$FILTERS_FILE" ]; then
    ARGS+=(--filters-file "$FILTERS_FILE")
fi

# ---------------------------------------------------------------- selected folders
# Top-level folders the user chose not to keep on this machine, one name per
# line, relative to REMOTE. Measured behaviour on rclone 1.75: excluding a folder
# touches neither side, so the local copy stays where it is and the cloud is left
# alone, and toggling one neither needs --resync nor touches the remote. The tray
# offers to delete the local copy separately, because leaving it there turns the
# folder into a trap.
if [ -n "$EXCLUDE_FOLDERS_FILE" ] && [ -f "$EXCLUDE_FOLDERS_FILE" ]; then
    excluded=0
    while IFS= read -r folder || [ -n "$folder" ]; do
        folder="${folder%%$'\r'}"                 # tolerate CRLF
        case "$folder" in ''|'#'*) continue ;; esac
        ARGS+=(--exclude "/${folder}/**")
        excluded=$((excluded + 1))
    done < "$EXCLUDE_FOLDERS_FILE"
    [ "$excluded" -gt 0 ] && log_line "NOTICE: ${excluded} folder(s) deselected"
fi

for arg in "$@"; do
    case "$arg" in
        --force)
            ARGS+=(--force)
            log_line "NOTICE: --force given, the delete cap will not stop this run" ;;
        --resync|--dry-run|--verbose)
            ARGS+=("$arg") ;;
        *)
            printf '%s: unknown option: %s\n' "$APP" "$arg" >&2
            printf 'usage: %s [--resync] [--force]\n' "$APP" >&2
            exit 2 ;;
    esac
done

if [ "${1:-}" = "--resync" ]; then
    # A name OneDrive refuses turns the first full upload into a retry loop, so
    # the tree is checked once, here, where the cost of a walk is nothing next to
    # the transfer that follows. It reports and carries on: the user may well
    # want the 700 files that are fine before dealing with the one that is not.
    #
    # The sibling script is preferred over the one on PATH because systemd runs
    # this with ExecStart and a minimal PATH, where the installed directory is
    # not necessarily present.
    check_cmd=""
    case "${BASH_SOURCE[0]}" in
        */*) self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
             [ -x "$self_dir/onedrive-check" ] && check_cmd="$self_dir/onedrive-check" ;;
    esac
    [ -n "$check_cmd" ] || check_cmd="$(command -v onedrive-check 2>/dev/null || true)"
    if [ -n "$check_cmd" ]; then
        if ! check_report="$("$check_cmd" 2>&1)"; then
            log_line "WARNING: names or paths OneDrive will refuse were found before the resync"
            printf '%s\n' "$check_report" >>"$LOG"
            printf '%s\n' "$check_report" >&2
        fi
    fi
    ARGS+=(--resync)
    log_line "NOTICE: --resync requested, rebuilding baseline"
fi

# ---------------------------------------------------------------- failure hints
# Turn rclone's noise into one actionable sentence, prefixed with a stable tag.
# The tag lets a UI localise the message without pattern-matching English text.
hint_for() {
    local t tag msg
    t=$(tail -n 60 "$LOG" 2>/dev/null)

    if grep -qiE 'prior lock file found' <<<"$t"; then
        tag=lock
        msg="a sync lock is still held; if this repeats, delete the *.lck files in ~/.cache/rclone/bisync"
    # Deliberately not matching the bare word max-delete: this wrapper logs its
    # own "--max-delete N%" conversion line just before the run, and matching it
    # tagged every unrelated failure as a delete-cap abort.
    elif grep -qiE 'too many deletes|excessive deletes|deletion limit' <<<"$t"; then
        tag=maxdelete
        msg="more than MAX_DELETE=$MAX_DELETE files would be deleted; if that is intended run: onedrive-sync --force"
    # Before the generic resync patterns: an access abort also ends with "Bisync
    # aborted. Must run --resync to recover", and answering that with --resync
    # sends the user to the one action that cannot fix a missing marker file.
    elif grep -qiE 'access test failed|check file check failed' <<<"$t"; then
        tag=access
        msg="the access check did not find ${CHECK_FILENAME:-RCLONE_TEST} on both sides, so nothing was changed. Restore the file (onedrive-check-access) or fix the side that cannot be read. Do not run --resync for this"
    elif grep -qiE 'lookup .*:53|dial tcp|no such host|Temporary failure in name resolution|server misbehaving' <<<"$t"; then
        tag=network
        msg="network or DNS temporarily unavailable; will retry"
    elif grep -qiE 'unknown flag|flag provided but not defined|unknown shorthand flag' <<<"$t"; then
        tag=oldrclone
        msg="this rclone does not know the flags in BISYNC_ARGS; --resilient/--recover need rclone >= 1.65 (check: rclone version)"
    elif grep -qiE 'must run --resync|resync required|prior listings|critical error' <<<"$t"; then
        tag=resync
        msg="sync baseline is invalid; run: onedrive-sync --resync"
    elif grep -qiE 'invalid_grant|401 Unauthorized|403 Forbidden|token' <<<"$t"; then
        tag=auth
        msg="authorisation may have expired; re-authorise the rclone remote"
    else
        tag=other
        msg="see log: $LOG"
    fi

    printf '[%s] %s' "$tag" "$msg"
}

# ---------------------------------------------------------------- main loop
# rclone only writes to --log-file once it has parsed its flags, so a bad flag
# (an rclone older than the arguments this config passes) would leave nothing
# behind but a journal line. Catch stderr here, copy it into the log, and let
# the journal keep it too.
ERRS="$(mktemp)"
trap 'rm -f "$ERRS"' EXIT

for i in $(seq 1 "$RETRIES"); do
    : >"$ERRS"
    "$RCLONE" "${ARGS[@]}" 2>"$ERRS"
    rc=$?

    if [ -s "$ERRS" ]; then
        cat "$ERRS" >>"$LOG"
        cat "$ERRS" >&2
    fi

    if [ "$rc" -eq 0 ]; then
        [ "$i" -gt 1 ] && echo "$APP: succeeded on attempt $i"
        exit 0
    fi

    hint=$(hint_for)
    printf '%s: attempt %d/%d failed (rc=%d) %s\n' "$APP" "$i" "$RETRIES" "$rc" "$hint" >&2
    log_line "ERROR: attempt $i/$RETRIES failed (rc=$rc) $hint"

    [ "$i" -lt "$RETRIES" ] && sleep "$RETRY_DELAY"
done

printf '%s: all %d attempts failed, giving up this round\n' "$APP" "$RETRIES" >&2
exit 1
