DEFAULT_LANG = "en"


def normalize_lang(value) -> str:
    """The language the table names, from any spelling a config can hold.

    UI_LANG is hand-edited, and the value a person reaches for is the one their
    own locale holds: `zh_CN.UTF-8`, `zh-CN`, `ZH`. The table names one Chinese,
    so the territory, the script modifier and the encoding are not part of the
    answer: `_` and `-` are one separator, everything from the first `.` or `@`
    goes, and what is left has to name a language here. "" when it does not,
    which is the answer an unsupported value already got.
    """
    text = str(value or "").strip().lower()
    text = text.split("@", 1)[0].split(".", 1)[0].replace("_", "-")
    for candidate in (text, text.split("-", 1)[0]):
        if candidate in STRINGS or candidate == DEFAULT_LANG:
            return candidate
    return ""


def resolve_lang(cfg: dict) -> str:
    """UI_LANG wins; otherwise follow the locale, defaulting to English."""
    pref = normalize_lang(cfg.get("UI_LANG"))
    if pref:
        return pref
    env = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
           or os.environ.get("LANG") or "").lower()
    if env.startswith("zh"):
        return "zh"
    return DEFAULT_LANG


def make_translator(lang: str):
    table = STRINGS.get(lang, {})

    def t(text: str, **kw) -> str:
        out = table.get(text, text)
        if not kw:
            return out
        try:
            return out.format(**kw)
        except (KeyError, IndexError):
            return out

    return t


def icon_dir_ok() -> bool:
    try:
        os.makedirs(ICON_DIR, exist_ok=True)
        return True
    except OSError:
        return False


# ---------------------------------------------------------------- icon drawing
# Each icon is a 64x64 cloud with one badge, because a panel draws it at about
# 22px: the cloud keeps a visible outline at that size and every badge glyph is a
# stroke at least 3px thick at 64, which is what survives the downscale.
ICON_SIZE = 64
BADGE_CENTER = (46.5, 46.5)
BADGE_RADIUS = 14.0
GLYPH_SCALE = BADGE_RADIUS / 15.0


def _rounded_rect(cr, x, y, w, h, r):
    """Add a rounded rectangle as its own sub-path."""
    r = min(r, w / 2.0, h / 2.0)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
    cr.close_path()


def _cloud_path(cr, grow=0.0):
    """Add the cloud silhouette to the current path.

    A rounded base with three bumps over it, as separate sub-paths filled in one
    go: the union has no seams and no stray lines, which drawing each circle and
    stroking it separately cannot manage. `grow` inflates every part by the same
    amount, and that is how the outline is made: the inflated silhouette is
    filled in the darker blue first, then the cloud itself on top of it.
    """
    _rounded_rect(cr, 11.0 - grow, 22.0 - grow,
                  35.0 + 2 * grow, 17.0 + 2 * grow, 8.0 + grow)
    for cx, cy, r in ((20.0, 27.0, 8.5), (30.0, 21.5, 10.0), (40.0, 26.5, 7.0)):
        cr.new_sub_path()
        cr.arc(cx, cy, r + grow, 0, 2 * math.pi)


def _check(cr, cx, cy, s=1.0):
    cr.set_line_width(3.6 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.move_to(cx - 5.5 * s, cy + 0.5 * s)
    cr.line_to(cx - 1.5 * s, cy + 4.5 * s)
    cr.line_to(cx + 5.5 * s, cy - 4.0 * s)
    cr.stroke()


def _exclaim(cr, cx, cy, s=1.0):
    cr.set_line_width(3.6 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.move_to(cx, cy - 6.0 * s)
    cr.line_to(cx, cy + 1.5 * s)
    cr.stroke()
    cr.arc(cx, cy + 5.0 * s, 1.9 * s, 0, 2 * math.pi)
    cr.fill()


def _pause(cr, cx, cy, s=1.0):
    # Two bars wide enough to survive the downscale to a panel: at 3.2 they wash
    # out to a grey smudge at 22px.
    cr.rectangle(cx - 5.2 * s, cy - 5.2 * s, 4.0 * s, 10.4 * s)
    cr.fill()
    cr.rectangle(cx + 1.2 * s, cy - 5.2 * s, 4.0 * s, 10.4 * s)
    cr.fill()


def _arrows(cr, cx, cy, s=1.0):
    """Two arrows chasing each other: the badge for a run in progress."""
    cr.set_line_width(3.2 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    for direction in (-1, 1):
        y = cy + direction * 3.9 * s
        tip = cx + direction * 6.2 * s
        cr.move_to(cx - direction * 5.6 * s, y)
        cr.line_to(tip - direction * 4.4 * s, y)
        cr.stroke()
        cr.move_to(tip, y)
        cr.line_to(tip - direction * 5.0 * s, y - 2.9 * s)
        cr.line_to(tip - direction * 5.0 * s, y + 2.9 * s)
        cr.close_path()
        cr.fill()


def _question(cr, cx, cy, s=1.0):
    """A question mark drawn as paths, not text: no font is required."""
    cr.set_line_width(3.6 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.move_to(cx - 4.6 * s, cy - 3.4 * s)
    cr.curve_to(cx - 4.6 * s, cy - 9.4 * s,
                cx + 4.8 * s, cy - 9.4 * s,
                cx + 4.8 * s, cy - 3.0 * s)
    cr.curve_to(cx + 4.8 * s, cy + 0.6 * s,
                cx, cy - 0.6 * s,
                cx, cy + 1.4 * s)
    cr.stroke()
    cr.arc(cx, cy + 5.0 * s, 1.9 * s, 0, 2 * math.pi)
    cr.fill()


def _progress(cr, cx, cy, pct, s=1.0):
    """An arc for the percentage rclone last reported."""
    pct = max(0.0, min(100.0, float(pct)))
    radius = 8.2 * s
    cr.set_line_width(3.4 * s)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    # The track first, faintly: an arc at 3% would otherwise be a dot.
    cr.set_source_rgba(1, 1, 1, 0.35)
    cr.arc(cx, cy, radius, 0, 2 * math.pi)
    cr.stroke()
    cr.set_source_rgb(1, 1, 1)
    start = -math.pi / 2
    cr.arc(cx, cy, radius, start, start + 2 * math.pi * pct / 100.0)
    cr.stroke()


def draw_icon(path: str, state: str, pct=None) -> None:
    """Render a 64x64 cloud with the badge for `state`.

    `pct` is the percentage the log last reported, and only the syncing icon has
    a use for it: with a number the badge becomes an arc, without one it keeps
    the two arrows.
    """
    if cairo is None:
        return
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, ICON_SIZE, ICON_SIZE)
    cr = cairo.Context(surf)
    cr.set_source_rgba(0, 0, 0, 0)
    cr.paint()

    _cloud_path(cr, 1.5)
    cr.set_source_rgb(*CLOUD_OUTLINE)
    cr.fill()
    _cloud_path(cr)
    cr.set_source_rgb(*CLOUD_COLOR)
    cr.fill()

    bx, by = BADGE_CENTER
    # The white ring is what keeps the badge readable where it sits on the
    # cloud, and what gives it an edge on a white panel.
    cr.set_source_rgb(1, 1, 1)
    cr.arc(bx, by, BADGE_RADIUS + 2.4, 0, 2 * math.pi)
    cr.fill()
    cr.set_source_rgb(*BADGE_COLORS.get(state, BADGE_COLORS["unknown"]))
    cr.arc(bx, by, BADGE_RADIUS, 0, 2 * math.pi)
    cr.fill()

    cr.set_source_rgb(1, 1, 1)
    s = GLYPH_SCALE
    if state == "synced":
        _check(cr, bx, by, s)
    elif state == "error":
        _exclaim(cr, bx, by, s)
    elif state == "paused":
        _pause(cr, bx, by, s)
    elif state == "syncing" and pct is not None:
        _progress(cr, bx, by, pct, s)
    elif state == "syncing":
        _arrows(cr, bx, by, s)
    else:
        _question(cr, bx, by, s)

    surf.write_to_png(path)


def ensure_icons() -> dict:
    """Redraw every icon, always from the same five states.

    Nothing here depends on the clock or on the machine, so running it again
    writes byte-identical files; the suite checks that. The directory is made
    here as well as in main(): write_to_png() cannot create it, and a caller
    that built a Tray without going through main() (the test suite, for one)
    would otherwise get five paths to files that do not exist.
    """
    icon_dir_ok()
    icons = {}
    failed = []
    for state in STATES:
        path = os.path.join(ICON_DIR, f"{state}.png")
        try:
            draw_icon(path, state)
        except OSError:
            # Swallowing this handed the indicator a path to a file nobody had
            # written, and main()'s own guard cannot see it: icon_dir_ok() only
            # proves the directory exists and is not what cairo writes into. A
            # read-only or full icon directory therefore produced a blank tray
            # icon, no warning on any stream, and a settings dialog and a
            # onedrive-doctor run that both reported the icons as fine.
            failed.append(state)
        icons[state] = path
    if failed:
        print(f"{APP_ID}: Warning: could not write the status icons "
              f"({', '.join(failed)}) in {ICON_DIR}; the tray icon will be "
              f"blank. Check that the directory is writable and not full.",
              file=sys.stderr)
    return icons


# ---------------------------------------------------------------- helpers
def sh(cmd: str, timeout: int = 30):
    """Run a short command and capture its output.

    Used for systemctl, systemd-run and the read-only rclone queries. Callers on
    the GTK main loop must not use this at all: a slow or hung command would
    freeze the tray (see poll() and the handlers behind it).

    The output is decoded as UTF-8 explicitly, the way every file the tray reads
    is opened. text=True would decode with the ambient locale, and on a desktop
    whose locale is not UTF-8 that mis-decodes the folder names rclone prints:
    the menu then labels them with the wrong text and unticking one writes that
    text into exclude-folders.txt, where it matches no folder the wrapper syncs.
    """
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True,
                             encoding="utf-8", errors="replace",
                             timeout=timeout)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as exc:  # noqa: BLE001
        return 1, "", str(exc)


def spawn(argv) -> bool:
    """Launch a GUI program fully detached.

    Never use subprocess.run() with capture_output for this: the child inherits
    the pipes, so run() blocks until every descendant closes them and the GTK
    main loop freezes with it.
    """
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, close_fds=True)
        return True
    except Exception:  # noqa: BLE001
        return False


def terminal_command(script: str):
    """Wrap an interactive command in this desktop's terminal, if it has one.

    rclone's OAuth flow asks one question before it opens the browser, and a
    process started from a tray item has no terminal to ask it in. Running it in
    one also keeps the sign-in URL, and any message from Microsoft, on screen.
    """
    for name, prefix in (("xdg-terminal-exec", []), ("ptyxis", ["--"]),
                         ("gnome-terminal", ["--"]), ("konsole", ["-e"]),
                         ("xfce4-terminal", ["-x"]), ("xterm", ["-e"])):
        path = shutil.which(name)
        if path:
            return [path] + prefix + ["sh", "-c", script]
    return None


def tail_text(path: str, max_bytes: int = 64 * 1024) -> str:
    """Read only the tail of a file that grows forever."""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            if size > max_bytes:
                fh.seek(size - max_bytes)
                fh.readline()          # discard a possibly truncated line
            return fh.read().decode("utf-8", "replace")
    except OSError:
        return ""


TS_RE = re.compile(r"^(\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2})")
HINT_RE = re.compile(r"\[(\w+)\]\s*(.*)$")
# The sync wrapper states the outcome of a run in one machine-readable line,
# written last, so the tray does not have to match English out of a log rclone
# shares with it. msg is the last field and runs to the end of the line, so it
# may hold spaces, commas, semicolons and a URL. Every field is required: a line
# missing one is a truncated write or a rotation inside the line, and the prose
# scan below answers it the way it answered a log an older wrapper wrote.
#
# The state is read as any token rather than as the three this format freezes.
# A value this build does not know has to land on the failure side, because the
# other side of the choice is a green icon for a run nobody has classified; a
# state missing altogether still fails the match and takes the prose path.
RESULT_RE = re.compile(
    r"ONEDRIVE_RESULT v=\d+ state=(\S+) tag=([a-z]+|none) "
    r"when=(\d{2}:\d{2}) msg=(.*)$")


def read_last_result(text: str):
    """Return (state, 'HH:MM', tag, raw_hint) parsed from the tail of the log.

    A line carrying ONEDRIVE_RESULT is the wrapper stating what a run did, and it
    is what the caller reads in preference: the outcome and the tag come from the
    wrapper's own classification rather than from matching English fragments in a
    log shared with rclone. `msg` is the raw hint, and `tag=none` is the empty
    tag, which is what the prose path gives a success too.

    A log with no marker, or with a marker missing a field, takes the prose scan
    unchanged: that is what an older wrapper wrote, and the [tag] it prefixes its
    hint with is what the caller localises without matching English text. The
    caller passes the text, so one poll reads the log once rather than twice.
    """
    kind, when, tag, raw = "unknown", "", "", ""
    marker = None                  # (line index, line) of the newest marker
    success_at = -1                # line index of the newest prose success
    for index, line in enumerate(text.splitlines()):
        if "ONEDRIVE_RESULT " in line:
            marker = (index, line)
        match = TS_RE.match(line)
        if not match:
            continue
        ts = match.group(1)
        if "Bisync successful" in line:
            kind, when, tag, raw = "synced", ts, "", ""
            success_at = index
        elif ("ERROR" in line or "Failed to" in line
              or "Bisync aborted" in line or "critical error" in line):
            kind, when = "error", ts
            found = HINT_RE.search(line)
            if found:
                tag, raw = found.group(1), found.group(2)
            else:
                tag, raw = "other", line
    if marker is not None:
        index, line = marker
        found = RESULT_RE.search(line)
        # The marker beats prose written before it. Prose written after it loses
        # only to a success, which is a later run finishing: rclone can flush a
        # line from this run's own subprocess after the wrapper wrote its marker,
        # and that line still describes the same run. The index test is inclusive,
        # because the marker's own msg can carry the prose word - a success whose
        # message reads "Bisync successful" - and a marker outranked by the line
        # holding it would report that line's clock instead of the run's own
        # when=. The state carries only two meanings the tray has - a success and
        # everything else - so a state this build does not know, `stopped`
        # included, is a failure rather than a green icon.
        if found and index >= success_at:
            state, mark_tag, mark_when, raw = found.groups()
            return ("synced" if state == "synced" else "error", mark_when,
                    "" if mark_tag == "none" else mark_tag, raw)
    if " " in when:
        when = when.split(" ")[1][:5]
    return kind, when, tag, raw


# ---------------------------------------------------------------- selected folders
def remote_folders(remote: str, rclone: str = "rclone"):
    """Top-level folder names under REMOTE, or None when the listing failed.

    `rclone` is the binary the config names: RCLONE exists so a build outside
    PATH can be used, and the tray asking the one on PATH would describe a
    different build's remote than the one onedrive-sync syncs.
    """
    rc, out, _ = sh(
        f"{shlex.quote(rclone)} lsf --dirs-only --max-depth 1 {shlex.quote(remote)}",
        timeout=120)
    if rc != 0:
        return None
    return [line.rstrip("/") for line in out.splitlines() if line.strip()]


def read_excluded_folders(path: str):
    """Folder names listed as not synced. Missing file means none."""
    try:
        with open(path, encoding="utf-8") as fh:
            return [line.strip() for line in fh
                    if line.strip() and not line.startswith("#")]
    except OSError:
        return []


def write_excluded_folders(path: str, names):
    """Write the list of folders not kept here. Returns (ok, reason).

    A name the readers would not give back unchanged is refused rather than
    written: the menu says "not synced" from this file and onedrive-sync reads it
    too, so a name that does not round-trip would leave the two disagreeing about
    what is being synced. The reason is a t() key either way, because whoever
    shows it has to be able to translate it.
    """
    for name in sorted(names):
        problem = exclusion_problem(name)
        if problem:
            return False, problem
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        text = ("# Folders not kept on this machine, one per line.\n"
                "# Edited by the tray. The cloud keeps them either way.\n")
        for name in sorted(names):
            text += f"{name}\n"
        write_atomic(path, text)
        return True, ""
    except OSError:
        return False, "Could not save the folder list"


def exclusion_problem(name: str) -> str:
    """Why `name` cannot go in exclude-folders.txt, or "" when it can.

    Both readers of that file drop a line starting with # and both trim the line
    before using it, so a name only means the same thing to the menu and to
    onedrive-sync when it survives that unchanged. The sentence returned here is
    also the t() key of the message that says so, folder name and all.
    """
    if not name or not name.strip():
        return "Cannot leave {name} out of the sync: the folder name is empty"
    if name != name.strip():
        return ("Cannot leave {name} out of the sync: the folder name has a space "
                "at one end")
    if name.startswith("#"):
        return ("Cannot leave {name} out of the sync: a name starting with # is "
                "read as a comment")
    if "\n" in name or "\r" in name:
        return ("Cannot leave {name} out of the sync: the folder name has a line "
                "break in it")
    return ""


# ---------------------------------------------------------------- quota
def fmt_size(n) -> str:
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PiB"


def read_quota(remote: str, rclone: str = "rclone"):
    """Ask the remote how much of the account is used. Returns (used, total)."""
    name = remote.split(":", 1)[0] + ":"
    _, out, _ = sh(f"{shlex.quote(rclone)} about {shlex.quote(name)} --json",
                   timeout=90)
    try:
        data = json.loads(out)
        total = data.get("total")
        if total:
            return data.get("used") or 0, total
    except (ValueError, TypeError):
        pass
    return None


# ---------------------------------------------------------------- progress
# rclone prints a stats block every --stats seconds. Only the last one matters.
PROG_RE = re.compile(
    r"Transferred:\s+([\d.]+\s*\S+)\s*/\s*([\d.]+\s*\S+),\s*(\d+)%,\s*([\d.]+\s*\S+/s)")
# rclone writes the file it is working on after a "*", then a colon, then the
# percentage, and it puts a space after the colon while the transfer is in flight
# but not once it has finished ("note.md:  0% ..." against "note.md:100% ...").
# Requiring that space lost the name on every finished block, which is the shape
# most stats blocks end with. Matching the percentage instead of the space keeps
# both shapes and still walks past a colon inside the name: "archive:2026.md" is
# one name, and stopping at the first colon reported "archive", a file that does
# not exist, on the line that is the tray's only per-file signal.
BUSY_RE = re.compile(r"^\s*\*\s+(.+?):\s*\d+%", re.M)
STAMP_RE = re.compile(r"^(\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2})", re.M)


def read_progress(text: str, max_age: int = 30):
    """Summarise the most recent stats block in the tail of the log.

    Returns None when there is no block, or when the newest one is older than
    max_age seconds. Without that age check an idle tray reports the final
    numbers of the previous run as if a transfer were in flight.
    """
    last = None
    for match in PROG_RE.finditer(text):
        last = match
    if last is None:
        return None

    stamps = STAMP_RE.findall(text[:last.start()])
    if stamps:
        try:
            age = time.time() - time.mktime(
                time.strptime(stamps[-1], "%Y/%m/%d %H:%M:%S"))
            if age > max_age:
                return None
        except (ValueError, OverflowError):
            pass

    pct = int(last.group(3))
    busy = BUSY_RE.findall(text)
    return {"pct": pct, "speed": last.group(4), "done": last.group(1),
            "total": last.group(2), "file": busy[-1].strip() if busy else ""}


# ---------------------------------------------------------------- tray
# How many poll ticks may pass before the timer's enabled state is asked again
# while the active state has not moved. Twelve ticks are thirty-six seconds at
# the tray's own three-second cadence, which is short enough that a unit switched
# over by something other than this tray is noticed promptly and long enough to
# take the second systemctl fork out of almost every tick.
ENABLED_EVERY = 12


def failure_identity(failure):
    """The part of an announced failure that says which failure it is.

    _announce_finish() is handed (when, tag, raw) for a run the wrapper
    classified, or (when, hint) from a caller that did not tag it. `when` is the
    failing run's own clock, and comparing it made two runs of the same failure
    five minutes apart look like news: on a five-minute timer the guard that
    exists to stop a repeat announced every one of them, one desktop
    notification per failing run, 2016 a week, each carrying the same sentence.
    The tag and the raw line are what tell one failure from another; the clock is
    for the status row, which shows it.
    """
    if failure is None or len(failure) < 2:
        return failure
    return failure[1:]


class Tray:
    """The status icon and the menu that drives one bisync pair.

    Every slow query (systemctl, rclone) runs on a worker thread and comes back
    through GLib.idle_add(); the *_busy flags stop a second query from stacking
    up behind a first one that has not answered yet.
    """

    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.unit = cfg["UNIT_NAME"]
        self.service = f"{self.unit}.service"
        self.timer = f"{self.unit}.timer"
        self.watch = f"{self.unit}-watch.service"
        # cfg.get(), not cfg["REMOTE"]: load_config() leaves REMOTE to the config
        # file because it has no sensible default, so a hand-edited config with
        # the key commented out used to end in a traceback and no icon at all.
        # main() refuses such a config before it gets here, and this keeps a
        # caller that builds a Tray itself from raising.
        self.remote = cfg.get("REMOTE") or ""
        # The rclone binary every query below runs. RCLONE is documented as the
        # build to use, and onedrive-sync, onedrive-check-access and
        # onedrive-doctor all honour it; asking the one on PATH here described a
        # different build's remote - and account - than the one that syncs.
        self.rclone = cfg.get("RCLONE") or "rclone"
        self.local = cfg["LOCAL"]
        self.log = cfg["LOG"]
        self.exclude_file = cfg["EXCLUDE_FOLDERS_FILE"]
        self.open_cmd = cfg["OPEN_APP_CMD"]
        self.open_name = cfg["OPEN_APP_NAME"]
        self.sync_script = os.path.join(
            os.path.dirname(os.path.realpath(__file__)), "onedrive-sync")
        self.t = make_translator(resolve_lang(cfg))

        self.icons = ensure_icons()
        self.state = None
        # The path most recently handed to the indicator. Indicator.new() has
        # already set the "unknown" icon, so that is what is on screen now.
        self.shown_icon = self.icons["unknown"]
        self.sync_pct = None       # percentage last drawn into the syncing icon
        # The progress arc is redrawn on every poll, so a failure to draw it is
        # reported once rather than once every three seconds.
        self.sync_icon_warned = False
        self.was_syncing = False
        # The failure the log is showing, as the parse saw it, and whether the
        # log has been read at all. The falling edge of was_syncing is not the
        # only thing that ends a run - one short enough to start and finish
        # between two polls is never seen as running - so the failure left in
        # the log is tracked as well. See _announce_finish().
        self.log_failure = None
        self.log_looked = False
        self.manual_requested = False
        self.busy = False
        # The re-authorise row runs a terminal and a flow that waits minutes for
        # the remote to answer, and rclone's config file has no cross-process
        # locking: two of them are last-writer-wins over the same remote's
        # credentials, and the first to finish reports a sign-in while the other
        # terminal is still open.
        self.reauth_busy = False
        # The first line of what systemd said the last time it refused a start,
        # or "". The status row reads it so a start that did not happen cannot
        # be dressed up as a run in flight.
        self.start_error = ""
        # One flag per piece of state a worker fills in. Each is set before the
        # thread starts and cleared on the main loop when its answer lands.
        self.quota = None          # (used, total) once a query has succeeded
        self.quota_busy = False
        self.auto_seen = None      # "on" / "off" / "paused" / "unknown"
        self.state_busy = False
        self.folders = None        # top-level names, None until the first listing
        self.folders_busy = False
        self.folders_seen = None
        # What the last listing attempt answered when it failed, or "". A listing
        # that has never arrived and one that is on its way look identical in
        # self.folders, and the submenu has to say which it is.
        self.folders_error = ""
        self.folders_error_seen = ""
        self.building_folders = False
        self.check_busy = False
        self.icon_visible = truthy(self.cfg.get("SHOW_ICON", "1"))
        # The config file's size and mtime as of the last read. The tray does not
        # own that file: --show-icon/--hide-icon and a --settings window in
        # another process write it and exit, and nothing else tells this process,
        # so poll() stats it and reloads the two settings that are meant to be
        # live. One stat per tick is the whole cost of watching it.
        self.config_seen = self._config_signature()
        # The last log read, kept between ticks. Re-reading 64 KB and running
        # every parser over it every three seconds was most of what an idle tray
        # did, and both answers only change while the file does.
        self.log_signature = None
        self.log_tail = ""
        self.log_result = ("unknown", "", "", "")
        # The timer's enabled state and the last active state seen. is-enabled is
        # the second systemctl fork of a tick and its answer only changes when the
        # units do, so it is asked on a change of the active state or every
        # ENABLED_EVERY ticks, and the previous answer is reused in between.
        self.timer_state = None
        self.active_seen = None
        self.poll_count = 0
        # Bumped whenever the tray changes the units itself. Every state answer
        # carries the value it was computed under, because a worker that asked
        # before a pause can answer after it, and that answer is about a state
        # that no longer exists.
        self.units_generation = 0

        if Notify is not None:
            Notify.init(APP_ID)
        else:
            print("rclone-onedrive-tray: desktop notifications unavailable "
                  "(gir1.2-notify-0.7 missing); continuing without them.",
                  file=sys.stderr)

        self.ind = AppIndicator.Indicator.new(
            APP_ID, self.icons["unknown"],
            AppIndicator.IndicatorCategory.APPLICATION_STATUS)
        # An icon can be asked to stay out of the panel from the settings dialog
        # (or by --hide-icon). PASSIVE is what hides it; the process keeps
        # running either way, so the timer, the watcher and the notifications are
        # unaffected.
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE
                            if self.icon_visible
                            else AppIndicator.IndicatorStatus.PASSIVE)

        self._build_menu()
        self.ind.set_menu(self.menu)

        GLib.timeout_add_seconds(3, self.poll)
        self.poll()
        # A pause is only as long-lived as the transient timer that ends it, so
        # what the stamp claims is checked against systemd before the menu is
        # allowed to promise a resume.
        self.recover_pause()
        GLib.timeout_add_seconds(1800, self.refresh_quota)
        self.refresh_quota()
        GLib.timeout_add_seconds(1800, self.refresh_folders)
        self.refresh_folders()

    def refresh_folders(self):
        """List the remote's top-level folders off the main loop.

        The request carries the remote and the binary it was made for. A reload
        can move either while the worker is asking - a settings save, a hand
        edit, the poll's own reload - and the answer that comes back then
        describes an account or a build the tray has just left. The re-ask that
        move wants is refused while this flag is set, so without the tag the
        stale answer landed: the submenu showed the old account's folders, and
        unticking one wrote that name into the exclusion file that now governs
        the new remote. `folders_error` is part of that answer and is dropped
        with it, or a listing that failed for the old remote would be stored as
        "could not list" the new one.
        """
        if not self.folders_busy:
            self.folders_busy = True
            tag = (self.remote, self.rclone)

            def worker():
                stale = False
                try:
                    listed = remote_folders(tag[0], tag[1])
                    stale = tag != (self.remote, self.rclone)
                    # None means the listing failed. Storing it turned the submenu
                    # into one greyed "Loading…" row, and a folder the user had
                    # deselected could not be ticked again until the next
                    # half-hour refresh. The failure is remembered instead, so a
                    # listing that has never arrived can say so and offer the
                    # retry rather than wait for that refresh.
                    if not stale:
                        if listed is not None:
                            self.folders = listed
                            self.folders_error = ""
                        else:
                            self.folders_error = tag[0] or tag[1]
                finally:
                    self.folders_busy = False
                    if stale:
                        # The ask this answer's move wanted was refused while
                        # this worker held the flag; it happens now, once the
                        # flag is down and the stale answer is out of the way.
                        GLib.idle_add(self._ask_folders_again)

            threading.Thread(target=worker, daemon=True).start()
        return True

    def _ask_folders_again(self):
        """Ask for the listing once more, from an idle callback."""
        self.refresh_folders()
        return False

    def _build_folder_menu(self):
        """One check item per remote folder; checked means kept locally."""
        self.building_folders = True
        sub = Gtk.Menu()
        if self.folders is None:
            if self.folders_error:
                # Nothing has ever been listed and the last attempt failed, so
                # the row says which remote could not be listed and is itself the
                # retry: waiting up to 1800 seconds is not a way out of a state
                # the user can see. The quota row hides itself in the same state.
                entry = Gtk.MenuItem(label=self.t(
                    "Could not list the folders of {remote}; click to try again",
                    remote=self.folders_error))
                entry.connect("activate", lambda *_: self.refresh_folders())
            else:
                entry = Gtk.MenuItem(label=self.t("Loading…"))
                entry.set_sensitive(False)
            sub.append(entry)
        elif not self.folders:
            entry = Gtk.MenuItem(label=self.t("No sub-folders"))
            entry.set_sensitive(False)
            sub.append(entry)
        else:
            excluded = set(read_excluded_folders(self.exclude_file))

            def add(name):
                check = Gtk.CheckMenuItem(label=name)
                check.set_active(name not in excluded)
                check.connect("toggled", self.on_toggle_folder, name)
                sub.append(check)

            # Dot-directories are still worth offering (.rag alone can be
            # hundreds of MB), but they belong below the user's own folders
            # rather than mixed in alphabetically ahead of them.
            visible = sorted(n for n in self.folders if not n.startswith("."))
            hidden = sorted(n for n in self.folders if n.startswith("."))
            for name in visible:
                add(name)
            if visible and hidden:
                sub.append(Gtk.SeparatorMenuItem())
            for name in hidden:
                add(name)
        sub.show_all()
        self.item_folders.set_submenu(sub)
        self.building_folders = False

    def _revert_folder_tick(self, item):
        """Put a check item back where it was, without re-entering the handler."""
        self.building_folders = True
        try:
            item.set_active(not item.get_active())
        finally:
            self.building_folders = False

    def _exclusion_in_effect(self, name) -> bool:
        """Whether exclude-folders.txt really holds `name` right now.

        Asked of the same reader the menu is built from, so this is the file's
        own answer and not what the tray meant to write.
        """
        return name in read_excluded_folders(self.exclude_file)

    def on_toggle_folder(self, item, name):
        # set_active() during a rebuild also emits "toggled"; ignore those.
        if self.building_folders:
            return
        # A name the file cannot hold is dropped from what was read, so one
        # hand-written line no reader gives back cannot stop every later change
        # from being written.
        excluded = {found for found in read_excluded_folders(self.exclude_file)
                    if not exclusion_problem(found)}
        if item.get_active():
            excluded.discard(name)
        else:
            excluded.add(name)
        written, problem = write_excluded_folders(self.exclude_file, excluded)
        if not written:
            # Put the tick back. Leaving it where the click put it would show a
            # change that was never written, so the menu and the file would
            # disagree about which folders are synced. The message names the
            # folder when the name is the reason, because that is the part the
            # user can do something about.
            self._revert_folder_tick(item)
            self.notify(APP_NAME, self.t(problem, name=name))
            return
        if item.get_active():
            self.notify(APP_NAME, self.t("{name} will sync", name=name))
        elif self._exclusion_in_effect(name):
            self.notify(APP_NAME, self.t("{name} will not sync", name=name))
            self._offer_local_delete(name)
        else:
            # The write said it worked and the reader does not see the name, so
            # nothing may be offered on the strength of it.
            self._revert_folder_tick(item)
            self.notify(APP_NAME, self.t("Could not save the folder list"))
            return

        # A filter change needs no --resync, so the next run can simply be asked
        # to happen. systemctl runs in a worker: it can take seconds to answer.
        threading.Thread(target=self._start_service, daemon=True).start()

    def _sc(self, *args, timeout: int = 30):
        """Run `systemctl --user`, every argument quoted for sh()'s shell.

        The unit names come from the hand-edited config; unquoted, one is a
        word-splitting bug at best and a command injection at worst.
        """
        return sh("systemctl --user "
                  + " ".join(shlex.quote(str(a)) for a in args), timeout=timeout)

    def _start_service(self):
        """Ask systemd for one run, and say so when it will not take the job.

        The (rc, out, err) `systemctl start` answers with used to be dropped, so
        a refused start left whatever the caller had already drawn - the "Syncing…"
        notification - standing over a run that never began. The wrapper is the
        same sync without needing the user manager to be reachable, which is the
        road the resync item already takes; what systemd said is still said out
        loud, so a unit that cannot start stays visible.
        """
        rc, out, err = self._sc("start", "--no-block", self.service)
        if rc != 0:
            return self._run_wrapper(err or out)
        self._clear_start_error()
        return rc

    def _run_wrapper(self, detail):
        """Run onedrive-sync directly, off systemd, and report what happened.

        systemd is the scheduler here, not the sync: the wrapper takes the same
        flock and applies the same delete cap, so a manager that will not
        schedule the run does not have to mean no run.
        """
        rc, out, err = sh(shlex.quote(self.sync_script), timeout=3600)
        if rc == 0:
            self._started_directly(detail)
        else:
            self._start_failed(err or out or detail)
        return rc

    def _start_reason(self, detail) -> str:
        """The first line of what systemd said, short enough to show."""
        lines = [line.strip() for line in str(detail or "").splitlines()
                 if line.strip()]
        return lines[0][:120] if lines else "?"

    def _started_directly(self, detail):
        """Say the run is happening without systemd, from the main loop.

        Only a notification: a run really is under way, so there is nothing for
        the status row to retract. The start_error sentence is for the case where
        the fallback failed as well and nothing is running.
        """
        why = self._start_reason(detail)

        def report():
            self.notify(APP_NAME, self.t(
                "systemd could not start the sync ({why}); running "
                "onedrive-sync directly", why=why))
            return False

        GLib.idle_add(report)

    def _start_failed(self, detail):
        """Put a start that did not happen on screen, from the main loop.

        The sentence names what systemd said, the way the settings window and a
        pause that cannot be re-armed already report a systemd failure, and the
        status row reads the same value so nothing on screen claims a run.
        """
        why = self._start_reason(detail)

        def report():
            self.start_error = why
            # The request was never a run, so the bookkeeping that watches for
            # one has to let it go rather than announce a success that is not
            # coming.
            self.manual_requested = False
            self.manual_seen_syncing = False
            self.manual_ticks = 0
            self.notify(APP_NAME, self.t("Could not start the sync: {why}", why=why))
            self._refresh_now()
            return False

        GLib.idle_add(report)

    def _clear_start_error(self):
        """A start systemd accepted: nothing may still claim it did not."""
        self.start_error = ""

    def _confirm(self, kind, text, body, cancel: str, confirm: str) -> bool:
        """Ask a question; True when the second button was chosen.

        The labels are explicit, not Gtk.ButtonsType.*: the stock ones follow the
        system locale, so an English dialog on a Chinese desktop read 取消/确定.
        """
        dialog = Gtk.MessageDialog(
            transient_for=None, flags=0, message_type=kind,
            buttons=Gtk.ButtonsType.NONE, text=text)
        dialog.format_secondary_text(body)
        dialog.add_button(cancel, Gtk.ResponseType.CANCEL)
        dialog.add_button(confirm, Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def on_reauth(self, *_):
        """Re-run rclone's sign-in for this remote.

        Until now the tray could only tell the user that authorisation had
        expired, leaving them to find `rclone config reconnect` themselves. The
        flow needs one answer and a browser, so it gets a terminal when there is
        one: the URL and Microsoft's own error text stay on screen.

        One flow at a time, the way every other worker in this class is guarded:
        rclone has no lock on its own config file, so a second reconnect is a
        second writer over the same credentials.
        """
        if self.reauth_busy:
            return
        remote = self.remote.split(":", 1)[0] + ":"
        if not self._confirm(
                Gtk.MessageType.QUESTION,
                self.t("Sign in again?"),
                self.t("This opens a terminal and your browser so you can sign in to "
                       "Microsoft again for {remote}. The sync keeps using the current "
                       "credentials until it finishes.", remote=remote),
                self.t("Cancel"), self.t("Sign in again")):
            return
        self.reauth_busy = True
        self.item_reauth.set_sensitive(False)
        self.notify(APP_NAME, self.t("Waiting for the sign-in to finish…"))
        threading.Thread(target=self._reauth_worker, args=(remote,),
                         daemon=True).start()

    def _reauth_worker(self, remote):
        quoted = shlex.quote(remote)
        # The status file is what the terminal leaves when the reconnect is over.
        # `$?` is read immediately after the reconnect, before the pause for the
        # reader, so what it holds is rclone's status and not the shell's last
        # command.
        for stale in (REAUTH_STATUS, REAUTH_OUTPUT):
            try:
                os.remove(stale)
            except OSError:
                pass
        reconnect = (f"printf 'y\\n' | {shlex.quote(self.rclone)} "
                     f"config reconnect {quoted} >{shlex.quote(REAUTH_OUTPUT)} 2>&1; "
                     f"printf '%s' \"$?\" >{shlex.quote(REAUTH_STATUS)}")
        script = (f"{reconnect}; printf '\\nDone. You can close this window.\\n'; "
                  "read -r _ || true")
        term = terminal_command(script)
        if term and spawn(term):
            # The terminal owns the exit status; the script writes it where this
            # can read it, so success is decided by the sign-in having finished and
            # the remote then answering, rather than by asking the remote while the
            # sign-in window is still open.
            ok = self._wait_for_remote(remote)
            if not ok:
                # A terminal that never led to a working remote still ends the
                # flow here: otherwise the guard would stay up for the life of
                # the process and the row could never be tried again.
                self._reauth_finished(False, self._reauth_detail())
            else:
                self._reauth_finished(True)
            return
        rc, out, err = sh(reconnect, timeout=900)
        self._reauth_finished(rc == 0, (err or out).strip())

    def _reauth_detail(self) -> str:
        """Why the sign-in did not finish, in rclone's own words when it spoke."""
        try:
            with open(REAUTH_OUTPUT, encoding="utf-8", errors="replace") as fh:
                lines = [line.strip() for line in fh if line.strip()]
        except OSError:
            lines = []
        if lines:
            return lines[-1]
        return "the sign-in window never reported finishing"

    def _wait_for_remote(self, remote, seconds: int = 600) -> bool:
        """Wait for the sign-in to finish, then for the remote to answer.

        The wait used to be for the remote alone, and a remote whose credentials
        were still valid answered at once: the flow reported "Signed in. Syncing
        now." about a second after the terminal opened, dropped the guard that
        keeps a second `rclone config reconnect` from starting over the same
        credentials, and began a sync over a sign-in that was still on screen. The
        script in the terminal writes the reconnect's status to REAUTH_STATUS, so
        this waits for the file, checks the status in it, and only then asks the
        remote. The file is asked for every quarter second rather than every five
        seconds: it is a stat call, and the sign-in is over the moment the
        terminal's script writes it, so there is nothing to be gained by noticing
        late. `seconds` is ten minutes, because a person signing in through a
        browser takes as long as they take and the row stays disabled until then.
        """
        deadline = time.time() + seconds
        while time.time() < deadline:
            if os.path.exists(REAUTH_STATUS):
                break
            time.sleep(0.25)
        else:
            return False
        try:
            with open(REAUTH_STATUS, encoding="utf-8", errors="replace") as fh:
                status = fh.read().strip()
        except OSError:
            return False
        if status != "0":
            return False
        # The reconnect is over; a token refresh can still take a moment, which is
        # the only thing this loop is for now.
        for _ in range(12):
            rc, _, _ = sh(f"{shlex.quote(self.rclone)} lsd {shlex.quote(remote)} "
                          f"--max-depth 1", timeout=30)
            if rc == 0:
                return True
            time.sleep(5)
        return False

    def _reauth_finished(self, ok: bool, detail: str = ""):
        def report():
            # The guard comes down with the flow, whichever way it ended, and the
            # row is usable again.
            self.reauth_busy = False
            self.item_reauth.set_sensitive(True)
            if ok:
                self.notify(APP_NAME, self.t("Signed in. Syncing now."))
                self.state = None
                threading.Thread(target=self._start_service, daemon=True).start()
            else:
                self.notify(APP_NAME, self.t("The sign-in did not finish: {why}",
                                             why=(detail or "?")[:120]))
            return False
        GLib.idle_add(report)

    def _local_delete_path(self, name):
        """The absolute path to delete for `name`, or None when it is refused.

        One rule, in one place, because `name` arrives from a remote listing and
        `shutil.rmtree` runs on whatever comes back: the name has to be exactly
        one path component that is neither "." nor "..", the joined path has to
        resolve to a real directory strictly inside the resolved sync root, and
        that directory must not be the root itself. Anything else is refused, so
        a listing cannot have the tray delete a parent, a sibling, a nested
        path, or the target of a symlink that points out of the root.

        A LOCAL that is not absolute is refused first, and for the same reason:
        every check below would be made against a path resolved from this
        process's own working directory rather than from the directory rclone
        syncs, and all of them would pass. The sentence that says so is
        local_path_problem()'s, the one main() prints.
        """
        if local_path_problem(self.local):
            return None
        if not name or name in (".", "..") or os.path.basename(name) != name:
            return None
        root = os.path.realpath(self.local)
        # Belt and braces with local_path_problem(), which refuses this value
        # first: for the filesystem root the separator-anchored prefix below is
        # "/" itself, so every top-level directory would pass as "inside the
        # sync root". A root with no parent is never a sync root.
        if os.path.dirname(root) == root:
            return None
        target = os.path.realpath(os.path.join(self.local, name))
        # The separator on the end matters: without it a sibling directory such
        # as "/data/OneDrive-old" would pass for the root "/data/OneDrive".
        prefix = root if root.endswith(os.sep) else root + os.sep
        if target == root or not target.startswith(prefix):
            return None
        if not os.path.isdir(target):
            return None
        return target

    def _offer_local_delete(self, name):
        """Offer to reclaim the space a deselected folder occupies.

        bisync leaves the local copy alone when a folder stops being synced,
        which turns it into a trap: edits there go nowhere. It is a delete, so it
        only happens on an explicit click, and the remote is never involved.

        The offer stands on the exclusion being real, which is the file's answer
        and not the tray's intention: the dialog promises the folder stays in
        OneDrive, and that promise holds only while onedrive-sync is really
        ignoring the folder. Without the exclusion, deleting the local copy is an
        ordinary local delete, and the next bisync propagates it to the cloud.
        """
        target = self._local_delete_path(name)
        if target is None:
            return
        if not self._exclusion_in_effect(name):
            return

        if not self._confirm(
                Gtk.MessageType.QUESTION,
                self.t("Delete the local copy of {name}?", name=name),
                self.t("This deletes {path}. The folder stays in OneDrive: only the "
                       "copy on this machine is removed, and ticking the folder "
                       "again downloads it back.", path=target),
                self.t("Keep local copy"), self.t("Delete local copy")):
            return
        self._delete_local(target)

    def _delete_local(self, target):
        """Delete a local copy off the main loop, then report what happened.

        shutil.rmtree() over a large tree would freeze the menu, so it runs in a
        worker and only the result comes back through the main loop.
        """
        def worker():
            try:
                shutil.rmtree(target)
            except OSError:
                GLib.idle_add(self.notify, APP_NAME,
                              self.t("Could not delete the local copy"))
            else:
                GLib.idle_add(self.notify, APP_NAME,
                              self.t("Local copy deleted"))

        threading.Thread(target=worker, daemon=True).start()

    def _check_names(self, *_):
        """Look for names OneDrive will refuse, without freezing the menu.

        It reads every path under the sync folder, so it runs in a thread and
        reports through a dialog.
        """
        if self.check_busy:
            return
        cmd = sibling_script("onedrive-check")
        if not cmd:
            self.notify(APP_NAME, self.t("onedrive-check is not installed"))
            return

        self.check_busy = True
        self.notify(APP_NAME, self.t("Checking file names…"))

        def worker():
            status, report = run_script_status(cmd)
            # onedrive-check answers 1 for "names were found" and 2 for a
            # configuration or usage fault; describing the second as file names
            # sends the user to look at names instead of at the config, so the
            # fault keeps its own words, which the checker prints.
            if status not in (0, 1):
                first = next((line for line in report.splitlines() if line.strip()),
                             report)
                GLib.idle_add(self._show_check, report, False,
                              self.t("onedrive-check could not run:"), first.strip())
                return
            GLib.idle_add(self._show_check, report, status == 0)

        threading.Thread(target=worker, daemon=True).start()

    def _show_check(self, report, clean, title=None, blurb=None):
        self.check_busy = False
        dialog = Gtk.Dialog(title or self.t("Check file names"))
        dialog.add_button(self.t("Close"), Gtk.ResponseType.CLOSE)
        box = dialog.get_content_area()
        box.set_spacing(6)
        if blurb is None:
            blurb = (self.t("Nothing needs fixing.") if clean else
                     self.t("These will fail or be renamed:"))
        label = Gtk.Label(label=blurb)
        label.set_xalign(0)
        box.pack_start(label, False, False, 0)

        view = Gtk.TextView()
        view.set_editable(False)
        view.set_monospace(True)
        view.get_buffer().set_text(report)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_width(560)
        scroll.set_min_content_height(300)
        scroll.add(view)
        box.pack_start(scroll, True, True, 0)

        dialog.show_all()
        dialog.run()
        dialog.destroy()
        return False

    def _diagnose(self, *_):
        """Run onedrive-doctor and show its report.

        The README tells a user to run this first when something looks wrong, and
        the point of the tray is not needing a terminal. The script is read-only
        and takes a moment, so it runs off the main loop the way the name check
        does.
        """
        if self.check_busy:
            return
        cmd = sibling_script("onedrive-doctor")
        if not cmd:
            self.notify(APP_NAME, self.t("onedrive-doctor is not installed"))
            return

        self.check_busy = True
        self.notify(APP_NAME, self.t("Running the diagnostics…"))

        def worker():
            ok, report = run_script(cmd)
            GLib.idle_add(self._show_check, report, ok,
                          self.t("Diagnostics"),
                          self.t("What onedrive-doctor found:"))

        threading.Thread(target=worker, daemon=True).start()

    def _refresh_now(self):
        """Run one state refresh from an idle callback, exactly once."""
        self.poll()
        return False

    def refresh_quota(self):
        """Query the account quota off the main loop; never block the menu.

        The same tag as the folder listing, and for the same reason: an
        account's usage read through a binary the config has since left is not
        this remote's usage either, and the ask that move wanted was refused
        while this worker was busy.
        """
        if not self.quota_busy:
            self.quota_busy = True
            tag = (self.remote, self.rclone)

            def worker():
                stale = False
                try:
                    result = read_quota(tag[0], tag[1])
                    stale = tag != (self.remote, self.rclone)
                    if result and not stale:
                        self.quota = result
                        # Show it now, not at the next poll tick up to three
                        # seconds later: the suite once caught that gap as a
                        # flaky assertion. poll() returns True because it is also
                        # a repeating GLib timeout, so this needs a one-shot
                        # wrapper rather than an idle_add(poll) of its own.
                        GLib.idle_add(self._refresh_now)
                finally:
                    self.quota_busy = False
                    if stale:
                        GLib.idle_add(self._ask_quota_again)

            threading.Thread(target=worker, daemon=True).start()
        return True

    def _ask_quota_again(self):
        """Ask for the quota once more, from an idle callback."""
        self.refresh_quota()
        return False

    # -------------------------------------------------- menu
    def _build_menu(self):
        """Build the whole menu, from the current language and config.

        The settings dialog calls this again after a language change: the
        indicator is handed a new menu in the new language, and nothing has to
        restart for the labels to follow.
        """
        self.menu = Gtk.Menu()
        self._build_status_items()
        self._build_pause_item()
        self._build_action_items()

        self.menu.show_all()
        # show_all() re-shows the quota row even though there is nothing to put
        # in it. no_show_all keeps the row out of the layout until poll() has a
        # quota line and asks for it explicitly.
        self.item_quota.set_no_show_all(True)
        self.item_quota.set_visible(bool(self.quota))
        self._refresh_checks()

    def _build_status_items(self):
        """Header, status, quota and folder rows, and the commands under them."""
        # A header, so the version is one hover away from the item that opens
        # the About window and there is something naming the app at the top.
        self.item_header = Gtk.MenuItem(label=f"{APP_NAME} {VERSION}")
        self.item_header.set_sensitive(False)
        self.menu.append(self.item_header)

        self.item_status = Gtk.MenuItem(label=self.t("Reading status…"))
        self.item_status.set_sensitive(False)
        self.menu.append(self.item_status)

        self.item_quota = Gtk.MenuItem(label="")
        self.item_quota.set_sensitive(False)
        self.item_quota.set_visible(False)
        self.menu.append(self.item_quota)

        self.menu.append(Gtk.SeparatorMenuItem())

        self._add(self.t("Sync now"), self.on_sync_now)
        if self.open_cmd:
            self._add(self.t("Open {app}", app=self.open_name), self.open_app)
        self._add(self.t("Open sync folder"), lambda *_: self.open_path(self.local))
        self._add(self.t("View sync log"), lambda *_: self.open_path(self.log))

        self.item_folders = Gtk.MenuItem(label=self.t("Folders to sync"))
        self._build_folder_menu()
        self.menu.append(self.item_folders)

        self.menu.append(Gtk.SeparatorMenuItem())

    def _build_pause_item(self):
        """The pause row and its submenu of durations."""
        self.item_pause = Gtk.MenuItem(label=self.t("Pause automatic sync"))
        pause_menu = Gtk.Menu()
        for minutes, key in PAUSE_CHOICES:
            entry = Gtk.MenuItem(label=self.t(key))
            entry.connect("activate",
                          lambda *_, m=minutes: self.pause_for(m))
            pause_menu.append(entry)
        pause_menu.append(Gtk.SeparatorMenuItem())
        resume = Gtk.MenuItem(label=self.t("Resume now"))
        resume.connect("activate", lambda *_: self.resume_now())
        pause_menu.append(resume)
        pause_menu.show_all()
        self.item_pause.set_submenu(pause_menu)
        self.menu.append(self.item_pause)

    def _build_action_items(self):
        """The rows below the pause entry: boot, the two dialogs, and the rest."""
        self.item_boot = Gtk.CheckMenuItem(label=self.t("Start tray at login"))
        self.item_boot.set_active(os.path.exists(AUTOSTART))
        self.item_boot.connect("activate", self.on_toggle_boot)
        self.menu.append(self.item_boot)

        self.menu.append(Gtk.SeparatorMenuItem())
        self._add(self.t("Check file names"), self._check_names)
        self._add(self.t("Diagnostics…"), self._diagnose)
        # Kept: the handler takes it out of action while a sign-in is in flight.
        self.item_reauth = self._add(self.t("Re-authorise OneDrive…"),
                                     self.on_reauth)
        self._add(self.t("Rebuild sync baseline (resync)…"), self.on_resync)

        self.menu.append(Gtk.SeparatorMenuItem())
        self._add(self.t("Settings…"), self.on_settings)
        self._add(self.t("About"), self.on_about)
        self._add(self.t("Quit"), lambda *_: Gtk.main_quit())

    def _add(self, label, handler):
        item = Gtk.MenuItem(label=label)
        item.connect("activate", handler)
        self.menu.append(item)
        return item

    def _refresh_checks(self):
        """Re-label the pause entry from the last known systemd state.

        This never shells out itself: it is called from the menu build and from
        poll()/pause_for()/resume_now(), and is_enabled() used to make every one
        of those block the main loop on systemctl.
        """
        auto = self.auto_seen
        if auto in (None, "on"):
            self.item_pause.set_label(self.t("Pause automatic sync"))
        elif auto == "paused":
            until = self._paused_until()
            self.item_pause.set_label(
                self.t("Paused until {when}", when=until) if until
                else self.t("Automatic sync paused (click to resume)"))
        elif auto == "off":
            self.item_pause.set_label(self.t("Automatic sync is off"))
        else:
            self.item_pause.set_label(self.t("Automatic sync state unknown"))

    def _paused_until(self) -> str:
        """Time the automatic resume is due, as HH:MM, or an empty string."""
        try:
            with open(PAUSE_STAMP, encoding="utf-8") as fh:
                due = int(fh.read().strip())
        except (OSError, ValueError):
            return ""
        if due <= time.time():
            return ""
        return time.strftime("%H:%M", time.localtime(due))

    def _clear_stamp(self):
        try:
            os.remove(PAUSE_STAMP)
        except OSError:
            pass

    # -------------------------------------------------- settings
    def set_icon_visible(self, visible: bool):
        """Show or hide the panel icon without stopping the process.

        Only the indicator's status changes. The timer, the watcher and the
        notifications carry on, so hiding the icon is not a way to stop syncing.
        """
        self.icon_visible = bool(visible)
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE
                            if self.icon_visible
                            else AppIndicator.IndicatorStatus.PASSIVE)

    def set_language(self, pref: str):
        """Switch language and re-label every item, without a restart."""
        self.cfg["UI_LANG"] = pref or ""
        self.t = make_translator(resolve_lang(self.cfg))
        self._build_menu()
        self.ind.set_menu(self.menu)

    def apply_settings(self, values: dict):
        """Put the settings the dialog just saved into effect.

        The two that can be applied to a running process are the language and
        whether the icon is in the panel. Everything else is read when it is
        used: NOTIFY_ON_SUCCESS and MAX_DELETE are properties of the config, the
        interval and the watcher are systemd's, and the access check is
        rclone's.
        """
        was_visible = self.icon_visible
        was_lang = resolve_lang(self.cfg)
        if "WATCH" in values:
            # The dialog has just enabled or disabled the watcher unit.
            self._units_changed()
        self.cfg.update(values)
        visible = truthy(values.get("SHOW_ICON", "1"))
        if visible != was_visible:
            self.set_icon_visible(visible)
        if resolve_lang(self.cfg) != was_lang:
            self.set_language(values.get("UI_LANG", ""))

    def _config_signature(self):
        """The config file's size and mtime, or None when it cannot be read.

        Both are in the tuple because a rewrite that keeps the size still moves
        the mtime. This is the entire cost of noticing that somebody else edited
        the file, and it runs on every poll.
        """
        try:
            info = os.stat(CONFIG_FILE)
        except OSError:
            return None
        return (info.st_size, info.st_mtime_ns)

    def _config_changed(self, fresh: dict) -> bool:
        """Re-resolve the config values that are read as attributes.

        __init__ turns these into attributes once and every later read goes
        through the attribute: the two menu rows that open a path, the "Open
        {app}" label and its command, the exclusion file the folder submenu reads,
        the remote the quota and folder listing ask about, the rclone binary all
        four of those queries run, and the root the delete guard checks against.
        Refilling self.cfg alone left every one of them pointing at the old file
        while the menu and the settings window said otherwise.

        Returns True when one of them actually moved, because then the menu has to
        be rebuilt: the labels and the handlers were built from the old paths.

        A remote that moved takes its answers with it. self.folders and self.quota
        were fetched from the remote being left behind, so keeping them left the
        old account's folders in the submenu - unticking one wrote that name into
        the exclusion file that now governs the new remote - and showed the old
        account's usage in the quota row, until the 1800-second refresh replaced
        them. A binary that moved is the same case with a different name on it:
        the two answers were read through the build being left behind, so they go
        with it as well and both are asked again.

        UNIT_NAME is deliberately not one of them. self.service, self.timer and
        self.watch were resolved from it when the tray started and the poll keeps
        asking about those; letting the file move it would have the settings
        window write a drop-in for a unit nothing polls.
        """
        wanted = {
            "remote": fresh.get("REMOTE") or "",
            "local": fresh["LOCAL"],
            "log": fresh["LOG"],
            "exclude_file": fresh["EXCLUDE_FOLDERS_FILE"],
            "open_cmd": fresh["OPEN_APP_CMD"],
            "open_name": fresh["OPEN_APP_NAME"],
            "rclone": fresh.get("RCLONE") or "rclone",
        }
        moved = False
        answers_moved = False
        for name, value in wanted.items():
            if getattr(self, name) != value:
                moved = True
                if name == "log":
                    # The cached tail belongs to the file that was being read
                    # until now, and _log_snapshot() decides by size and mtime
                    # alone. A new log that matches the old one's pair, which is
                    # what a `cp -p` of a log leaves behind, was therefore read as
                    # unchanged: the status line kept describing the old file for
                    # as long as the new one stayed still.
                    self.log_signature = None
                    self.log_tail = ""
                    self.log_result = ("unknown", "", "", "")
                elif name in ("remote", "rclone"):
                    # The listing and the quota are answers about the remote that
                    # was just left behind - read through the binary that was - so
                    # they go with it. The caller's _build_menu() paints the
                    # cleared state before an answer lands: the folder row says
                    # Loading… and the quota row is hidden rather than showing the
                    # old account.
                    self.folders = None
                    self.folders_seen = None
                    self.folders_error = ""
                    self.folders_error_seen = ""
                    self.quota = None
                    answers_moved = True
                setattr(self, name, value)
        if answers_moved:
            # The functions that already run on the 1800-second timers, called now
            # instead of waited on. An ask that is refused because a worker is
            # still busy is made again by that worker, which knows its answer is
            # about the thing being left behind.
            self.refresh_folders()
            self.refresh_quota()
        return moved

    def _reload_config(self):
        """Apply the two live settings after the config file changed.

        --show-icon, --hide-icon and a --settings window in a process that does
        not own the icon all write the file and exit, so the file is the only way
        they can reach a tray that is already running: without this, the icon
        stayed hidden and the language stayed put until the process was killed,
        which with no icon also means no menu.

        The two settings that mean anything to a running process are applied;
        the rest go into self.cfg for the code that reads them when it needs
        them, because that code is running too.

        A file that cannot be trusted is not applied at all: see the REMOTE and
        LOCAL checks below. The tray keeps what it was using rather than moving
        onto the defaults an unreadable file comes back as, and a save that puts
        REMOTE back is applied normally on the tick that notices it. What is
        refused is said out loud: this process has no window of its own, so a
        notification is the only way it can tell the user that the edit it just
        picked up is not in use.
        """
        # Every key, not only the two the window applies: NOTIFY_ON_SUCCESS is
        # read when a run ends, so a standalone --settings save has to land in
        # self.cfg as well, and apply_settings stores the rest for the callers
        # that read them later.
        #
        # UNIT_NAME is the exception. self.service, self.timer and self.watch were
        # resolved from it when the tray started, and the poll keeps asking about
        # those; letting the file move it would have the dialog write a drop-in
        # for a unit nothing polls.
        try:
            fresh = load_config()
        except ConfigFault as exc:
            # A file that cannot be read is not a file with no news in it, and it
            # is not a file that says "use the defaults" either: both arrived here
            # as the defaults from load_config(), which is the state that moved
            # LOCAL onto the delete guard's root. It arrives as a fault now, with
            # the file and the reason, so the sentence names those instead of
            # blaming a key that is in the file.
            self.notify(APP_NAME, self.t("The config file was not applied: {why}",
                                         why=str(exc)))
            return
        if not fresh.get("REMOTE"):
            # The rule main() applies to a config before it builds a tray:
            # load_config() leaves REMOTE alone because nothing sensible can be
            # defaulted for it, and everything the tray does needs one. A deleted
            # or unreadable file arrives here as the defaults, and applying them
            # moved LOCAL to ~/OneDrive, the root the delete guard checks, so the
            # folder menu would offer to delete a directory under a root the
            # confirmation dialog never mentioned. Refusing keeps what is already
            # in use; the file coming back with REMOTE set is a change like any
            # other. The LOCAL refusal below says why it refused; this one is the
            # same kind of news about the same file, so it speaks the same way
            # rather than leaving a tray that stopped following its config looking
            # like one that has nothing to report.
            self.notify(APP_NAME, self.t("The config file was not applied: {why}",
                                         why=self.t("REMOTE is not set in it")))
            return
        bad_local = local_path_problem(fresh.get("LOCAL"))
        if bad_local:
            # The other rule main() applies before it builds a tray, applied to
            # the file a running one just picked up. A relative LOCAL is resolved
            # against whatever directory this process happens to run in - systemd
            # starts the tray with no WorkingDirectory, so that is the user's home
            # - and the delete guard then checks a tree rclone never syncs while
            # the tray goes on running on it. The guard already refuses every
            # deletion in that state; this is the sentence that says why, and
            # keeps the value that works.
            self.notify(APP_NAME, self.t("The config file was not applied: {why}",
                                         why=bad_local))
            return
        fresh["UNIT_NAME"] = self.cfg.get("UNIT_NAME", fresh.get("UNIT_NAME", ""))
        self.apply_settings(fresh)
        # After apply_settings, so a menu the language change already rebuilt is
        # not built a second time here, and before anything reads the new paths.
        # set_language() is the existing way a rebuild is handed to the indicator;
        # this is the same thing, for a label or a handler that moved.
        if self._config_changed(fresh):
            self._build_menu()
            self.ind.set_menu(self.menu)

    def on_settings(self, *_):
        """Open the settings window; it applies its changes to this tray."""
        dialog = SettingsDialog(self)
        dialog.show_all()
        dialog.run()
        dialog.destroy()

    def show_settings_now(self):
        """Open the settings window from an idle callback (--settings)."""
        self.on_settings()
        return False

    def about_text(self) -> str:
        return "\n".join([
            self.t("A tray icon that shows and drives an rclone bisync pair."),
            self.t("Version {version}", version=VERSION),
            self.t("Config file: {path}", path=CONFIG_FILE),
            PROJECT_URL,
        ])

    def on_about(self, *_):
        dialog = Gtk.MessageDialog(
            transient_for=None, flags=0, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.NONE, text=f"{APP_NAME} {VERSION}")
        dialog.format_secondary_text(self.about_text())
        dialog.add_button(self.t("Close"), Gtk.ResponseType.CLOSE)
        dialog.run()
        dialog.destroy()

    # -------------------------------------------------- actions
    def on_sync_now(self, *_):
        if self.busy:
            return
        self.busy = True
        self.manual_requested = True
        self.manual_seen_syncing = False
        self.manual_ticks = 0
        # No "Syncing…" here: it was announced before systemd had answered, and a
        # refused start then left that sentence standing over nothing. The status
        # row says what is happening three seconds later, and the same notification
        # is dropped by _start_failed when the start really did not happen.
        threading.Thread(target=self._run, args=("start",), daemon=True).start()

    def _run(self, mode):
        try:
            if mode == "resync":
                rc, out, err = sh(f"{shlex.quote(self.sync_script)} --resync",
                                  timeout=3600)
                if rc != 0:
                    # The resync runs the wrapper itself, so this is the run's
                    # own failure and not a start systemd refused. It is still
                    # reported: nothing else watches a resync, which the poll
                    # never sees as a run of the unit.
                    self._resync_failed(err or out)
                else:
                    self._clear_start_error()
                return
            # --no-block first: its exit status is systemd's answer about the job.
            # The status of the blocking start below also carries the sync's own
            # failure, and reading that as "the start failed" would report a run
            # that really happened - and would run the fallback over it.
            rc, out, err = self._sc("start", "--no-block", self.service)
            if rc != 0:
                self._run_wrapper(err or out)
                return
            self._clear_start_error()
            # The job is queued, and this waits for it the way this always did, so
            # self.busy still covers the whole run.
            self._sc("start", self.service, timeout=3600)
        finally:
            self.busy = False

    def _resync_failed(self, detail):
        """Report a resync that ended non-zero, from the main loop."""
        why = self._start_reason(detail)

        def report():
            self.notify(APP_NAME, self.t("The resync did not finish: {why}",
                                         why=why))
            self._refresh_now()
            return False

        GLib.idle_add(report)

    def on_resync(self, *_):
        # Explicit buttons, not Gtk.ButtonsType.*: the stock ones follow the
        # system locale, so an English dialog on a Chinese desktop read 取消/确定.
        confirmed = self._confirm(
            Gtk.MessageType.WARNING,
            self.t("Rebuild the sync baseline?"),
            self.t("The next run compares both sides from scratch and rebuilds the "
                   "baseline. On a large folder it takes a while and must not be "
                   "interrupted. Where a file changed on both sides the copy that "
                   "changed last wins, and on an older rclone the cloud copy "
                   "replaces the local one, so copy local edits aside first."),
            self.t("Cancel"), self.t("Rebuild"))
        if not confirmed or self.busy:
            return
        self.busy = True
        self.notify(APP_NAME, self.t("Rebuilding sync baseline…"))
        threading.Thread(target=self._run, args=("resync",), daemon=True).start()

    def _units_changed(self):
        """Forget what systemctl last said about the units, and say they moved.

        The enabled answer is cached because asking costs a fork, and the tray
        changes the units itself when it pauses, resumes or toggles the watcher.
        Clearing the cache is only half of it, and the half that was missing: an
        is-enabled answer already on its way back from systemctl was computed
        before the change and still describes the old state, so clearing the cache
        did nothing about it. Reusing it reported automatic sync as on during a
        pause, which deleted the pause stamp three seconds after the pause began
        and left the menu claiming sync was off. The counter below is what such an
        answer is compared against; see _query_state() and _apply_state().
        """
        self.timer_state = None
        self.active_seen = None
        self.units_generation = getattr(self, "units_generation", 0) + 1

    def _set_units(self, *action):
        """start/stop/enable the timer and the watcher together."""
        for unit in (self.timer, self.watch):
            self._sc(*action, unit)
        # Here rather than at each caller: forgetting one left the cached answer
        # describing the units as they were before, and the next poll then deleted
        # a pause stamp or claimed sync was off.
        self._units_changed()

    def pause_for(self, minutes: int):
        """Stop syncing for a while and let systemd bring it back by itself.

        Both units are stopped, not just the timer: leaving the watcher running
        would let a local edit start a sync during the pause. Every systemctl
        call happens in a worker: a slow user manager used to freeze the tray
        for the whole pause.

        The resume timer is the only thing that ends the pause, so when arming it
        fails the pause cannot be kept. That repair happens here, in the worker
        and before the notification, because it is a systemctl call: the units go
        back on, which is the same repair _recover_pause_worker() runs when the
        same call fails at startup. Leaving them off wrote no stamp and left the
        menu saying automatic sync was off, with a manual Resume now as the only
        way back.
        """
        def worker():
            self._set_units("stop")
            self._sc("disable", self.timer, self.watch)
            sh(f"systemctl --user stop {PAUSE_UNIT}.timer {PAUSE_UNIT}.service "
               f"2>/dev/null", timeout=30)
            _, _, err = sh(
                f"systemd-run --user --on-active={minutes}min --unit={PAUSE_UNIT} "
                f"systemctl --user enable --now "
                f"{shlex.quote(self.timer)} {shlex.quote(self.watch)}",
                timeout=30)
            if err and "Running timer" not in err:
                self._set_units("enable", "--now")
            GLib.idle_add(self._after_pause, minutes, err)

        threading.Thread(target=worker, daemon=True).start()

    def _after_pause(self, minutes, err):
        if err and "Running timer" not in err:
            # One fault, one outcome: this is the sentence the startup recovery
            # uses for the same failure, and the units are already back on by the
            # time it is shown. The reason is still reported beside it.
            # The colon is part of the sentence, not glued on beside it: the zh
            # table writes "：" and an ASCII ":" after a Chinese clause is the
            # tell that the two halves were assembled rather than translated.
            self.notify(APP_NAME,
                        self.t("Could not schedule the resume: {why}",
                               why=err[:70]))
            return self._pause_lost()
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            with open(PAUSE_STAMP, "w", encoding="utf-8") as fh:
                fh.write(str(int(time.time()) + minutes * 60))
        except OSError:
            pass
        key = PAUSE_LABELS.get(minutes, f"{minutes} min")
        self.notify(APP_NAME, self.t("Paused for {n}", n=self.t(key)))
        self.auto_seen = "paused"
        self._units_changed()
        self._refresh_checks()
        return False

    def resume_now(self):
        def worker():
            sh(f"systemctl --user stop {PAUSE_UNIT}.timer {PAUSE_UNIT}.service "
               f"2>/dev/null", timeout=30)
            self._set_units("enable", "--now")
            GLib.idle_add(self._after_resume)

        threading.Thread(target=worker, daemon=True).start()

    def _after_resume(self):
        self._clear_stamp()
        self.auto_seen = "on"
        self._units_changed()
        self.notify(APP_NAME, self.t("Automatic sync resumed"))
        self._refresh_checks()
        return False

    def _pause_due(self):
        """The time the pause stamp says the resume is due, or None."""
        try:
            with open(PAUSE_STAMP, encoding="utf-8") as fh:
                return int(fh.read().strip())
        except (OSError, ValueError):
            return None

    def recover_pause(self):
        """Make the pause stamp and the resume timer agree, at startup.

        The timer that ends a pause is a transient systemd unit, so it lives and
        dies with the running user manager: a reboot or a logout during the pause
        leaves both units disabled and no timer behind, while the stamp in
        ~/.cache still holds the old due time. Reading only the stamp made the
        menu promise a resume that could never come, so the stamp is checked
        against systemd itself, off the main loop because systemctl can take
        seconds to answer.
        """
        threading.Thread(target=self._recover_pause_worker, daemon=True).start()

    def _recover_pause_worker(self):
        due = self._pause_due()
        if due is None:
            return
        if due <= time.time():
            # The pause is over and the stamp is all that is left of it. The
            # units are the next poll's business, and its answer is the truth.
            GLib.idle_add(self._pause_over)
            return
        _, out, _ = self._sc("is-active", f"{PAUSE_UNIT}.timer")
        answer = out.splitlines()[0].strip() if out.strip() else ""
        if answer == "active":
            return
        _, _, err = sh(
            f"systemd-run --user --on-active={max(1, int(due - time.time()))}s "
            f"--unit={PAUSE_UNIT} systemctl --user enable --now "
            f"{shlex.quote(self.timer)} {shlex.quote(self.watch)}",
            timeout=30)
        if err and "Running timer" not in err:
            # The pause cannot be kept, so it ends here instead of being left as
            # a promise nothing will keep: the units go back on now, and the
            # notification says so rather than letting the menu claim a resume.
            self._set_units("enable", "--now")
            GLib.idle_add(self._pause_lost)
        else:
            GLib.idle_add(self._pause_rearmed)

    def _pause_over(self):
        """The stamp has expired: drop it, so nothing claims a pause."""
        self._clear_stamp()
        self.auto_seen = None
        self._refresh_checks()
        return False

    def _pause_rearmed(self):
        """The resume timer is back, so the stamp is true again."""
        self.auto_seen = "paused"
        self._refresh_checks()
        return False

    def _pause_lost(self):
        """The resume could not be restored: end the pause, and say so."""
        self._clear_stamp()
        self.auto_seen = None
        self.notify(APP_NAME, self.t(
            "Could not restore the resume timer, so automatic sync is on again"))
        self._refresh_checks()
        return False

    def on_toggle_boot(self, item):
        """The menu checkbox and the settings dialog write the same file."""
        err = write_autostart(item.get_active())
        if err:
            # The click has already moved the tick, so swallowing the error left
            # the menu claiming autostart was on while no file existed.
            self.notify(APP_NAME, self.t("Could not change the login setting: {why}",
                                         why=err[:120]))
            item.set_active(not item.get_active())

    def open_app(self, *_):
        # The command is quoted shell-style ("my app" --flag), so it needs the
        # same splitting a shell would do; str.split() kept the quote characters
        # and handed spawn() an argv[0] that does not exist.
        try:
            argv = shlex.split(self.open_cmd)
        except ValueError:
            argv = []
        if not argv or not spawn(argv):
            self.notify(APP_NAME, self.t("Could not start {app}", app=self.open_name))

    def open_path(self, path):
        if not os.path.exists(path):
            self.notify(APP_NAME, self.t("Path does not exist: {path}", path=path))
            return
        # spawn() answers False for a program that is not on PATH at all, which is
        # what a machine without xdg-utils has: install.sh treats the package as
        # optional, so both rows are there and open nothing. open_app() checks the
        # same answer; discarding it here left the two rows silent.
        if not spawn(["xdg-open", path]):
            self.notify(APP_NAME, self.t(
                "Could not open {path}: it needs xdg-open, from the xdg-utils "
                "package", path=path))

    def notify(self, title, body):
        if Notify is None:
            return
        try:
            note = Notify.Notification.new(title, body, self.icons.get("synced"))
            note.set_urgency(Notify.Urgency.NORMAL)
            note.show()
        except Exception:  # noqa: BLE001
            pass

    # -------------------------------------------------- polling
    def _set_icon(self, path):
        """Hand a new icon to the indicator, and only a new one.

        set_icon_full() makes libayatana-appindicator look up the scale factor of
        an internal widget, which does not exist without a StatusNotifier host
        (this machine has none), so the call can print
        `gtk_widget_get_scale_factor: assertion 'GTK_IS_WIDGET (widget)' failed`.
        Touching GLib log handlers does not silence it; calling this only on a
        real change keeps it to at most one message per state change.
        """
        if path == self.shown_icon:
            return
        self.shown_icon = path
        self.ind.set_icon_full(path, APP_NAME)

    def _set_sync_progress(self, pct):
        """Redraw the syncing icon with the percentage rclone last reported.

        The badge becomes an arc, so the icon says how far along the run is
        without the menu being opened. pct is None between runs, and the plain
        arrows come back.
        """
        if pct == self.sync_pct:
            return
        self.sync_pct = pct
        try:
            draw_icon(self.icons["syncing"], "syncing", pct)
        except OSError as exc:
            # Same swallow as ensure_icons(), and the same silence, but this one
            # runs from the poll: a line per tick would be a line every three
            # seconds for the length of a sync. The first failure is the news,
            # and the flag keeps it to one.
            if not self.sync_icon_warned:
                self.sync_icon_warned = True
                print(f"{APP_ID}: Warning: could not redraw the syncing icon: "
                      f"{exc}", file=sys.stderr)
            return
        if self.state == "syncing":
            # The path is unchanged, so _set_icon would skip the hand-off even
            # though the file it points at has just been redrawn.
            self.shown_icon = None
            self._set_icon(self.icons["syncing"])

    def unit_states(self):
        """Return (service_active, timer_state).

        timer_state is "enabled" (automatic sync on), "off" (the unit exists but
        is disabled) or "unknown" (systemctl could not be asked, or does not know
        the unit). The last one used to be reported as a pause, which invented a
        pause that never happened.

        `systemctl is-active` reports "activating" (not "active") while a
        Type=oneshot service runs, so both are accepted, and it exits non-zero
        when any named unit is inactive, which is a normal answer and not a
        failure here.

        `systemctl is-enabled` is the second fork of the tick, and its answer only
        changes when the units do. It is asked when the active state moved since
        the last tick, every ENABLED_EVERY ticks, or the first time; otherwise the
        previous answer is reused, which is what took a fork out of almost every
        tick of an idle tray.

        This needs `service` and `timer` and nothing else, so the three throttle
        attributes are read through getattr: a caller that hands it a minimal
        stand-in instead of a constructed Tray has to keep working.
        """
        # Which units this answer is about, taken before the forks below: the
        # tray can move the units while systemctl is being asked, and an answer
        # from before that must not become the cache the next tick reuses.
        generation = getattr(self, "units_generation", 0)
        _, out, _ = sh("systemctl --user is-active "
                       f"{shlex.quote(self.service)} {shlex.quote(self.timer)}",
                       timeout=30)
        lines = [line.strip() for line in out.splitlines() if line.strip()]
        active = bool(lines) and lines[0] in ("active", "activating")

        self.poll_count = getattr(self, "poll_count", 0) + 1
        moved = active != getattr(self, "active_seen", None)
        self.active_seen = active
        known = getattr(self, "timer_state", None)
        if known is None or moved or self.poll_count % ENABLED_EVERY == 0:
            _, out, _ = sh(f"systemctl --user is-enabled {shlex.quote(self.timer)}",
                           timeout=30)
            answer = out.splitlines()[0].strip() if out.strip() else ""
            # The answer decides, not the exit status: `systemctl is-enabled`
            # exits non-zero for a unit that exists and is disabled, and reading
            # that as "unknown" hid a real state behind a vague message. An empty
            # answer is what an unreadable or unknown unit looks like.
            if not answer:
                timer = "unknown"
            elif answer.startswith(("enabled", "linked", "alias")):
                timer = "enabled"
            elif answer.startswith(("disabled", "masked", "static", "indirect",
                                    "generated", "transient", "bad")):
                timer = "off"
            else:
                timer = "unknown"
            if generation == getattr(self, "units_generation", 0):
                self.timer_state = timer
            return active, timer
        return active, self.timer_state

    def poll(self):
        """Ask for the state in the background and return at once.

        systemctl can take seconds, or hang, when the user manager is busy, so
        the subprocess work happens in a worker and _apply_state() runs back on
        the main loop through GLib.idle_add().

        The config file is stat'ed here as well, and reloaded when it moved: it is
        the only channel an external writer (--show-icon, --hide-icon, a
        standalone --settings window) has into this process. A file that cannot be
        read has not moved; see the guard below.
        """
        signature = self._config_signature()
        # None is "the file could not be read", which is not news about the
        # config. Comparing it against the last signature made the absence look
        # like a change on every tick, and the defaults load_config() answers in
        # that case moved LOCAL to ~/OneDrive: the root the folder menu's delete
        # guard checks, so the menu offered to delete a directory under a root the
        # confirmation dialog never mentioned.
        if signature is not None and signature != self.config_seen:
            self.config_seen = signature
            self._reload_config()
        self._query_state()
        return True

    def _query_state(self):
        if self.state_busy:
            return
        self.state_busy = True
        # Snapshotted here, before the worker starts: the tray can pause or
        # resume while the worker is forking systemctl, and the answer it brings
        # back then describes the units as they were before that.
        generation = getattr(self, "units_generation", 0)

        def worker():
            try:
                syncing, timer_state = self.unit_states()
            except Exception:  # noqa: BLE001
                syncing, timer_state = False, "unknown"
            GLib.idle_add(self._apply_state, syncing, timer_state, generation)

        threading.Thread(target=worker, daemon=True).start()

    def _auto_state(self, timer_state) -> str:
        """"on", "off", "paused" or "unknown", from systemctl's own answer.

        "off" is an answer (automatic sync was turned off); "unknown" is the
        absence of one. Only a stamp from pause_for() means the tray paused the
        units itself, and the stamp goes when the timer brings them back.
        """
        if timer_state == "enabled":
            auto = "on"
        elif timer_state == "unknown":
            auto = "unknown"
        elif self._paused_until():
            auto = "paused"
        else:
            auto = "off"
        if auto != "paused" and os.path.exists(PAUSE_STAMP):
            self._clear_stamp()
        return auto

    def _hint(self, tag, raw) -> str:
        """The localised failure hint, or the log line when the tag has none.

        The `other` tag is the wrapper saying it could not classify the failure,
        and what follows it is the wrapper's own "see log: <path>" text. That is
        the wrapper's data and not prose for the tray to rewrite, and it is the
        only one of the two that carries the path, so it is shown as it was
        written in every language. The rest of the tags are the contract between
        the two programs and are translated.
        """
        if tag == "other":
            return raw
        hint = self.t(tag)
        return raw if hint == tag else hint

    def _announce_finish(self, syncing, kind, when, hint, identity=None):
        """Notify once when a run ends: a failure always, a success on request.

        The falling edge of the running state is one witness that a run ended,
        and not the only one. A run short enough to start and finish between two
        polls is never seen as running, so the failure it wrote raised nothing
        at all while the icon went red; the log's own failure is the witness
        that catches it. `identity` is that failure as the parse saw it - time,
        tag and raw line - and is deliberately not the localised hint, because a
        language change must not turn the failure already on screen into a new
        one.

        What may not happen either way: a failure that was in the log before
        this process started is not news (the first look only records it), and
        the same failure is not announced twice. "The same failure" is the tag
        and the raw line, not the run's clock - see failure_identity().
        """
        if self.manual_requested:
            # A manual run can start and finish between two polls, and then there
            # is nothing to announce: without forgetting the request, the next
            # scheduled success was announced as though the user had started it.
            # While the start is still in flight nothing is counted, or a run
            # that is slow to come up would be forgotten before it began.
            if syncing or self.busy:
                self.manual_seen_syncing = True
                self.manual_ticks = 0
            else:
                self.manual_ticks = getattr(self, "manual_ticks", 0) + 1
                if not getattr(self, "manual_seen_syncing", False) and self.manual_ticks >= 2:
                    self.manual_requested = False
        failure = None if kind != "error" else (
            identity if identity is not None else (when, hint))
        ended = self.was_syncing and not syncing
        first_look = not self.log_looked
        self.log_looked = True
        if failure is not None and (
                failure_identity(failure) != failure_identity(self.log_failure)):
            if ended or not first_look:
                self.notify(self.t("{app} sync failed", app=APP_NAME),
                            hint or self.t("see the sync log"))
        self.log_failure = failure
        if ended:
            if kind == "error":
                # Announced above, whichever of the two witnesses saw it first.
                pass
            elif self.manual_requested:
                # The setting is about the good news only: a failure is always
                # worth a notification.
                if truthy(self.cfg.get("NOTIFY_ON_SUCCESS", "1")):
                    self.notify(APP_NAME, self.t("Sync finished {when}", when=when))
            # The run is over whichever way it ended. Clearing this only on the
            # success path left a manual run that failed marked as manual for the
            # life of the process, so the next scheduled success was announced as
            # if the user had started it.
            self.manual_requested = False
            self.manual_seen_syncing = False
            self.manual_ticks = 0
        self.was_syncing = syncing

    def _status_text(self, syncing, prog, auto, kind, when, hint) -> str:
        """The sentence under the header: what is happening, and when it last did."""
        if not syncing and self.start_error:
            # A start systemd refused is the newest thing that happened, and
            # "No sync recorded yet" or the last run's date would both read as
            # though the click had done something. Cleared by the first poll that
            # sees a real run, or by a start systemd accepted.
            return self.t("systemd did not start the sync: {why}",
                          why=self.start_error)
        if syncing:
            if not prog:
                return self.t("Syncing…")
            text = f"{self.t('Syncing…')} {prog['pct']}%"
            if prog["speed"]:
                text += f" · {prog['speed']}"
            if prog["file"]:
                text += f" · {prog['file'][:34]}"
            return text
        if auto == "paused":
            return self.t("Automatic sync paused · last {when}", when=when or "—")
        if auto == "off":
            return self.t("Automatic sync is off · last {when}", when=when or "—")
        if kind == "error":
            text = self.t("⚠ Sync failed {when}", when=when)
            return text + (f" · {hint[:40]}" if hint else "")
        if kind == "synced":
            return self.t("Last sync {when}", when=when)
        return self.t("No sync recorded yet")

    def _show_quota(self):
        """Put the usage line in the menu, or leave the row hidden without one."""
        if not self.quota:
            return
        used, total = self.quota
        pct = int(used * 100 / total) if total else 0
        self.item_quota.set_label(self.t(
            "{used} of {total} used ({pct}%)",
            used=fmt_size(used), total=fmt_size(total), pct=pct))
        self.item_quota.set_visible(True)

    def _show_folders(self):
        """Rebuild the folder submenu when, and only when, what it shows changed.

        The failure is part of what is shown: a listing that fails before one has
        ever arrived moves the row from "Loading…" to the retry, and comparing
        self.folders alone never noticed that.
        """
        if (self.folders != self.folders_seen
                or self.folders_error != self.folders_error_seen):
            self.folders_seen = self.folders
            self.folders_error_seen = self.folders_error
            self._build_folder_menu()

    def _log_snapshot(self):
        """The parsed tail of the log, re-read only when the file changed.

        tail_text() reads up to 64 KB and read_last_result() runs its regexes over
        it, and an idle tray did both on every three-second tick for a file that
        only changes while a sync runs. Size and mtime together are the cheap
        test: a rewrite that keeps the size still moves the mtime, and a rotation
        changes both.
        """
        try:
            info = os.stat(self.log)
            signature = (info.st_size, info.st_mtime_ns)
        except OSError:
            signature = None
        if signature != self.log_signature:
            self.log_signature = signature
            self.log_tail = tail_text(self.log)
            self.log_result = read_last_result(self.log_tail)
        return self.log_tail, self.log_result

    def _apply_state(self, syncing, timer_state, generation=None):
        """Put one worker's answer on screen, on the main loop.

        `generation` is the value of the units counter when the worker started.
        An answer older than the current counter was computed before the tray
        paused, resumed or toggled the watcher itself, so it describes a state
        that no longer exists: _auto_state() reads its "enabled" as automatic
        sync being on and deletes the pause stamp with it. A caller that does not
        tag its answer (generation=None) is applied the way it always was.

        Must return False: GLib.idle_add() re-calls an idle callback that
        returns True, forever.
        """
        self.state_busy = False
        if (generation is not None
                and generation != getattr(self, "units_generation", 0)):
            # Dropped, not applied: the next tick asks again and answers about
            # the units as they are now.
            return False

        # A run really in flight is proof the units are working again, so the
        # start failure stops being the newest thing on screen. The log is not
        # used for this: a success from before the failure is still in the tail
        # and would wipe the sentence the click just earned.
        if self.start_error and syncing:
            self.start_error = ""

        auto = self._auto_state(timer_state)
        if auto != self.auto_seen:
            self.auto_seen = auto
            self._refresh_checks()

        log_tail, (kind, when, tag, raw) = self._log_snapshot()
        hint = self._hint(tag, raw)

        # The order decides: a run in progress outranks everything, then a pause
        # the tray itself arranged, then the last result in the log.
        if syncing:
            state = "syncing"
        elif auto in ("paused", "off"):
            state = "paused"
        elif kind == "error":
            state = "error"
        elif kind == "synced":
            state = "synced"
        else:
            state = "unknown"
        if state != self.state:
            self.state = state
            self._set_icon(self.icons[state])

        self._announce_finish(syncing, kind, when, hint,
                              (when, tag, raw) if kind == "error" else None)

        prog = read_progress(log_tail) if syncing else None
        self.item_status.set_label(
            self._status_text(syncing, prog, auto, kind, when, hint))
        self._set_sync_progress(prog["pct"] if prog else None)

        self._show_quota()
        self._show_folders()
        return False


# ---------------------------------------------------------------- settings dialog
def _as_int(value, fallback: int) -> int:
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return fallback


def _settings_dialog_class():
    """Build the settings window class, which has to inherit from Gtk.Dialog.

    A class statement runs when the module is imported, and the bindings are
    imported on demand, so the class is built here and handed to the module by
    load_bindings(). Nothing else about it is dynamic.
    """
    class SettingsDialog(Gtk.Dialog):
        """The settings window.

        Widget values are read on the main loop; the config write, the systemctl
        calls and the access-check script all run on a worker thread and come back
        through GLib.idle_add(). Any of them can take seconds, and a frozen window is
        worse than a slow one. Failures are collected and shown in the window: a
        systemd or autostart action that failed silently would leave the window
        claiming a change that never happened.

        `tray` may be None. That is the --settings case where another process owns
        the icon: the config, systemd and autostart changes still go through, and
        the two live ones (language, icon) have nothing to apply to here.
        """

        def __init__(self, tray=None, cfg=None, translate=None):
            source = cfg if cfg is not None else (
                tray.cfg if tray is not None else load_config())
            if translate is None:
                translate = (tray.t if tray is not None
                             else make_translator(resolve_lang(source)))
            super().__init__(title=translate("Settings"), parent=None, flags=0)
            self.tray = tray
            self.cfg = dict(source)
            self.t = translate
            self.original = {key: str(self.cfg.get(key, default))
                             for key, default in SETTINGS_DEFAULTS.items()}
            self.original_boot = os.path.exists(AUTOSTART)
            self.failures: list = []
            self.done = False
            self.busy = False
            self.markers_busy = False
            self.set_modal(True)
            self._build()

        # -------------------------------------------------- widgets
        def _build(self):
            box = self.get_content_area()
            box.set_spacing(10)
            box.set_border_width(12)
            self._build_options(box)
            self._build_labels(box)
            self._build_buttons()
            self.notice_check_access()

        def _build_options(self, box):
            """The grid of controls, one row each, in the order they are shown."""
            grid = Gtk.Grid()
            grid.set_row_spacing(8)
            grid.set_column_spacing(14)
            box.pack_start(grid, False, False, 0)

            def row(index, text, widget):
                label = Gtk.Label(label=text)
                label.set_xalign(0)
                grid.attach(label, 0, index, 1, 1)
                if widget is not None:
                    grid.attach(widget, 1, index, 1, 1)

            self.combo_lang = Gtk.ComboBoxText()
            for value, text in (("", self.t("Follow the system")),
                                ("en", "English"), ("zh", "中文")):
                self.combo_lang.append(value, text)
            # The row is set by the language the resolver read, not by the string
            # the config happens to spell: `zh_CN.UTF-8` and `ZH` are both Chinese
            # to resolve_lang() and neither is a combo id, so the raw value left
            # the row blank and a Save then wrote "" over a setting that was in
            # use. A value naming no language here falls back to the row for
            # "follow the system", which is what it already meant.
            wanted = normalize_lang(self.original["UI_LANG"])
            self.combo_lang.set_active_id(wanted)
            row(0, self.t("Language"), self.combo_lang)

            self.check_show = Gtk.CheckButton(label=self.t("Show the icon in the panel"))
            self.check_show.set_active(truthy(self.original["SHOW_ICON"]))
            grid.attach(self.check_show, 0, 1, 2, 1)

            self.check_boot = Gtk.CheckButton(label=self.t("Start tray at login"))
            self.check_boot.set_active(self.original_boot)
            grid.attach(self.check_boot, 0, 2, 2, 1)

            self.spin_interval = Gtk.SpinButton.new_with_range(1, 1440, 1)
            self.spin_interval.set_value(_as_int(self.original["INTERVAL_MIN"], 5))
            row(3, self.t("Sync interval (minutes)"), self.spin_interval)

            self.check_watch = Gtk.CheckButton(label=self.t("Realtime sync"))
            self.check_watch.set_active(truthy(self.original["WATCH"]))
            grid.attach(self.check_watch, 0, 4, 2, 1)

            self.check_notify = Gtk.CheckButton(
                label=self.t("Tell me when a sync I start succeeds"))
            self.check_notify.set_active(truthy(self.original["NOTIFY_ON_SUCCESS"]))
            grid.attach(self.check_notify, 0, 5, 2, 1)

            self.spin_delete = Gtk.SpinButton.new_with_range(0, 1000000, 1)
            self.spin_delete.set_value(_as_int(self.original["MAX_DELETE"], 100))
            row(6, self.t("Delete cap (files)"), self.spin_delete)

            self.combo_bw = Gtk.ComboBoxText()
            for value in BANDWIDTH_CHOICES:
                self.combo_bw.append(bw_id(value),
                                     self.t("Unlimited") if not value else value)
            # A value set by hand, 1.5M say, is not one of the choices. Appending
            # it keeps it visible and round-trips it; without this the combo had
            # no matching id, get_active_id() returned None, and any Save wrote
            # BW_LIMIT="" over a setting that was working.
            if self.original["BW_LIMIT"] and self.original["BW_LIMIT"] not in BANDWIDTH_CHOICES:
                self.combo_bw.append(bw_id(self.original["BW_LIMIT"]),
                                     self.original["BW_LIMIT"])
            self.combo_bw.set_active_id(bw_id(self.original["BW_LIMIT"]))
            row(7, self.t("Bandwidth limit"), self.combo_bw)

            self.check_access = Gtk.CheckButton(label=self.t("Access check"))
            self.check_access.set_active(truthy(self.original["CHECK_ACCESS"]))
            self.check_access.connect("toggled", self.on_access_toggled)
            self.button_markers = Gtk.Button(label=self.t("Create the marker files"))
            self.button_markers.connect("clicked", self.on_create_markers)
            access_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            access_row.pack_start(self.check_access, False, False, 0)
            access_row.pack_start(self.button_markers, False, False, 0)
            grid.attach(access_row, 0, 8, 2, 1)

        def _build_labels(self, box):
            """The two message rows, and the path of the file being edited."""
            self.label_notice = Gtk.Label()
            self.label_notice.set_xalign(0)
            self.label_notice.set_line_wrap(True)
            self.label_notice.set_max_width_chars(64)
            self.label_notice.set_no_show_all(True)
            box.pack_start(self.label_notice, False, False, 0)

            self.label_status = Gtk.Label()
            self.label_status.set_xalign(0)
            self.label_status.set_line_wrap(True)
            self.label_status.set_max_width_chars(64)
            self.label_status.set_no_show_all(True)
            box.pack_start(self.label_status, False, False, 0)

            self.label_config = Gtk.Label(
                label=self.t("Config file: {path}", path=CONFIG_FILE))
            self.label_config.set_xalign(0)
            self.label_config.set_selectable(True)
            box.pack_start(self.label_config, False, False, 0)

        def _build_buttons(self):
            """Cancel and Save. Each closes the window through its own response."""
            self.cancel_button = Gtk.Button(label=self.t("Cancel"))
            self.cancel_button.connect("clicked", self.on_cancel)
            self.add_action_widget(self.cancel_button, Gtk.ResponseType.CANCEL)
            self.save_button = Gtk.Button(label=self.t("Save"))
            self.save_button.connect("clicked", self.on_save)
            self.add_action_widget(self.save_button, Gtk.ResponseType.OK)

        def _bool_value(self, key, widget) -> str:
            """The checkbox's answer, spelled the way the file already spells it.

            A hand-edited CHECK_ACCESS="enabled" is on to onedrive-sync and to the
            doctor's WATCH reader, so the box opens ticked. Writing "1" over it
            would be a rewrite nobody asked for, and a Save that touched nothing
            must leave the file as it found it; a real change is still written as
            the 1/0 this dialog has always produced.
            """
            active = bool(widget.get_active())
            original = self.original.get(key, "")
            if truthy(original) == active:
                return original
            return "1" if active else "0"

        def values(self) -> dict:
            """The config values the widgets hold right now."""
            return {
                "UI_LANG": self.combo_lang.get_active_id() or "",
                "SHOW_ICON": self._bool_value("SHOW_ICON", self.check_show),
                "INTERVAL_MIN": str(int(self.spin_interval.get_value())),
                "WATCH": self._bool_value("WATCH", self.check_watch),
                "NOTIFY_ON_SUCCESS": self._bool_value("NOTIFY_ON_SUCCESS",
                                                      self.check_notify),
                "MAX_DELETE": str(int(self.spin_delete.get_value())),
                # No matching entry means the combo lost the value rather than
                # the user clearing it, so the config keeps what it had.
                "BW_LIMIT": (bw_value(self.combo_bw.get_active_id())
                             if self.combo_bw.get_active_id() is not None
                             else self.original["BW_LIMIT"]),
                "CHECK_ACCESS": self._bool_value("CHECK_ACCESS", self.check_access),
            }

        def set_status(self, text):
            self.label_status.set_text(text or "")
            self.label_status.set_visible(bool(text))

        def set_notice(self, text):
            self.label_notice.set_text(text or "")
            self.label_notice.set_visible(bool(text))

        def notice_check_access(self):
            """Warn before the switch is saved, not after the sync has failed."""
            if not self.check_access.get_active():
                self.set_notice("")
                return
            marker = marker_file_path(self.cfg)
            if os.path.exists(marker):
                self.set_notice("")
                return
            self.set_notice(self.t(
                "The markers rclone's access check looks for are missing, so the "
                "next sync will fail until they exist. This side needs {path}, and "
                "the same name on the remote.", path=marker))

        # -------------------------------------------------- actions
        def on_access_toggled(self, *_):
            self.notice_check_access()

        def on_cancel(self, *_):
            self.response(Gtk.ResponseType.CANCEL)

        def on_save(self, *_):
            if self.busy:
                return
            self.busy = True
            self.save_button.set_sensitive(False)
            self.set_status("")
            # Read the widgets here: GTK is not thread safe, so nothing below may
            # touch them from the worker.
            values = self.values()
            boot = self.check_boot.get_active()
            threading.Thread(target=self._save_worker, args=(values, boot),
                             daemon=True).start()

        def _save_worker(self, values, boot):
            """Run one Save off the main loop, and report what it found.

            The one place that knows the worker runs on a thread: _worker() does
            the work and answers with the failures, _finish() puts them on
            screen, and neither has to know about the other.
            """
            GLib.idle_add(self._finish, values, self._worker(values, boot))

        def _unit(self) -> str:
            return self.cfg.get("UNIT_NAME") or "onedrive-sync"

        def _worker(self, values, boot):
            """Apply one Save, and return the failures it found.

            Answers with a list rather than storing it: what is shown is
            _finish()'s job, and a worker that wrote into self.failures as well
            was the last method here that both computed and stored, so there was
            no way to ask it what it found without a window to read.
            """
            failures = []
            changed = {key: value for key, value in values.items()
                       if self.original.get(key) != value}
            if changed:
                try:
                    update_config_file(CONFIG_FILE, changed)
                except (OSError, ConfigFault) as exc:
                    # ConfigFault is the config that is not the UTF-8 this format
                    # has to be. Left uncaught it killed this worker before
                    # _finish() was scheduled: busy stayed True, the Save button
                    # stayed insensitive and the window reported nothing.
                    failures.append(self.t("Could not write the config file: {why}",
                                           why=str(exc)))
            if values["INTERVAL_MIN"] != self.original["INTERVAL_MIN"]:
                err = write_timer_dropin(self._unit(), values["INTERVAL_MIN"])
                if err:
                    failures.append(self.t("Could not apply the sync interval: {why}",
                                           why=err[:160]))
            if values["WATCH"] != self.original["WATCH"]:
                err = set_watch_unit(self._unit(), values["WATCH"] == "1")
                if err:
                    failures.append(self.t(
                        "Could not change the realtime sync unit: {why}",
                        why=err[:160]))
            if boot != self.original_boot:
                err = write_autostart(boot)
                if err:
                    failures.append(self.t(
                        "Could not change the login setting: {why}", why=err[:160]))
            return failures

        def _finish(self, values, failures):
            self.busy = False
            self.failures = failures
            if failures:
                # Stay open with the reasons on screen, rather than closing over a
                # failure the user would never see.
                self.set_status("\n".join(failures))
                self.save_button.set_sensitive(True)
                return False
            self.done = True
            if self.tray is not None:
                self.tray.apply_settings(values)
            self.response(Gtk.ResponseType.OK)
            return False

        def on_create_markers(self, *_):
            if self.markers_busy:
                return
            self.markers_busy = True
            self.button_markers.set_sensitive(False)
            self.set_status(self.t("Creating the marker files…"))
            threading.Thread(target=self._markers_worker, daemon=True).start()

        def _markers_worker(self):
            ok, report = run_check_access()
            GLib.idle_add(self._markers_done, ok, report)

        def _markers_done(self, ok, report):
            self.markers_busy = False
            self.button_markers.set_sensitive(True)
            if ok:
                text = (report + "\n") if report else ""
                self.set_status(text + self.t("The marker files are there."))
            else:
                self.set_status(self.t("Could not create the marker files: {why}",
                                       why=(report or "?")[:300]))
            # Either way the warning follows the file system, not the attempt: a
            # failed creation leaves the next sync failing as it did before.
            self.notice_check_access()
            return False
    return SettingsDialog


def show_settings_standalone():
    """Show the settings window in a process that does not own the tray icon.

    This is the --settings case where a tray is already running: it holds the
    single-instance lock, and hiding its icon does not stop it. There is no
    indicator here, so the language and icon switches have nothing to apply to;
    the config file is what carries every change to the running tray.
    """
    try:
        cfg = load_config()
    except ConfigFault as exc:
        # The dialog would otherwise open on the defaults for a file it could not
        # read, which is how a save could have written over a config that was
        # simply mode 000. One sentence and exit 1, the rule main() applies.
        print(f"{APP_ID}: {exc}", file=sys.stderr)
        return 1
    dialog = SettingsDialog(None, cfg=cfg)
    dialog.show_all()
    response = dialog.run()
    dialog.destroy()
    return response


def acquire_lock():
    """Take the single-instance lock.

    Returns the file object, or None when another tray already holds it. Raises
    OSError when the file cannot be created at all: callers need to tell those
    two apart, because both used to print the same sentence, so an unwritable
    directory looked like a running tray and exited 0.

    O_NOFOLLOW is what keeps the fallback path, a fixed name in a directory every
    local user can write, from being a file somebody else chose: a symlink is
    refused instead of being truncated. The refusal has to come from the open and
    not from a check before it, because the link can be swapped in between.

    The flock alone is not enough while the file is removed on the way out. A tray
    that opens the path, then waits, can flock it after the holder released and
    unlinked it: the descriptor then holds an inode no other process will ever
    open, so the next tray creates a fresh file and locks that one, and two trays
    run at once. What makes the lock real is that the path still names the inode
    this descriptor holds; when it does not, this is a lock on nobody's file and
    the attempt starts again.
    """
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW
    for _ in range(8):
        handle = os.fdopen(os.open(LOCK_FILE, flags, 0o600), "w")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            handle.close()
            return None
        try:
            ours = (os.stat(LOCK_FILE).st_ino
                    == os.fstat(handle.fileno()).st_ino)
        except OSError:
            ours = False
        if ours:
            return handle
        # The path was unlinked between the open and the flock and something may
        # have taken it since; close and look again. No other process can unlink
        # it now that this flock is held, so the next round either finds the file
        # it holds at the path or loses the race to the process that has it.
        handle.close()
    # Eight whole rounds of that is a machine worth not starting a second tray on.
    return None


def release_lock(handle):
    """Drop the lock and remove the file this process created.

    The lock itself is the flock on the descriptor, and the file carries no
    state; it is removed so a later run does not find a stale lock sitting there.
    Only the inode this handle holds may go: os.remove() was unconditional, so a
    tray on its way out deleted whatever was at the path, including a lock another
    process had just created and was holding.

    The remove happens before the close, while this flock still keeps every other
    tray out. Closing first would leave the window the check in acquire_lock()
    exists for: another tray that had already opened this inode could flock it and
    find the path still naming it, and then this process would unlink the file out
    from under that tray.
    """
    try:
        ours = (os.stat(LOCK_FILE).st_ino == os.fstat(handle.fileno()).st_ino)
    except OSError:
        ours = False
    if ours:
        try:
            os.remove(LOCK_FILE)
        except OSError:
            pass
    try:
        handle.close()
    except OSError:
        pass


USAGE = f"""usage: {APP_ID} [--settings] [--show-icon | --hide-icon] [--version] [--help]

The rclone bisync status icon. With no arguments it starts the icon and, if one
is already running, says so and exits.

  --settings     open the settings window. Starts the icon as well when it is
                 not already running, so the two live settings have somewhere to
                 land; when it is, the window opens on its own.
  --show-icon    write SHOW_ICON="1" to the config and exit
  --hide-icon    write SHOW_ICON="0" to the config and exit
                 given both, the last one wins
  --version      print the version and exit
  --help         print this text and exit

Configuration: {CONFIG_FILE}
"""


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)

    # --version and --help are the two answers that have to work where the tray
    # itself cannot run: over SSH, from a script, on a machine with no session.
    # They are therefore settled before the display guard below.
    if "--version" in args:
        print(f"{APP_ID} {VERSION}")
        return 0
    if "--help" in args or "-h" in args:
        print(USAGE, end="")
        return 0

    known = ("--settings", "--show-icon", "--hide-icon")
    unknown = [arg for arg in args if arg not in known]
    if unknown:
        print(f"{APP_ID}: unknown option: {unknown[0]}\n"
              f"Try '{APP_ID} --help'.", file=sys.stderr)
        return 2

    if "--show-icon" in args or "--hide-icon" in args:
        # One value, one file, then out. A running tray picks it up the next time
        # it starts, or from the settings dialog. Given both flags, the last one
        # wins: --show-icon used to win wherever it sat, which made a
        # contradictory pair quietly mean "show".
        last = max(i for i, arg in enumerate(args)
                   if arg in ("--show-icon", "--hide-icon"))
        value = "1" if args[last] == "--show-icon" else "0"
        try:
            update_config_file(CONFIG_FILE, {"SHOW_ICON": value})
        except ConfigFault as exc:
            # A file that is not UTF-8 is the fault load_config() already has a
            # sentence for, and rewriting it from what could be decoded would
            # replace bytes nobody asked about.
            print(f"{APP_ID}: {exc}", file=sys.stderr)
            return 1
        except OSError as exc:
            print(f"{APP_ID}: could not write {CONFIG_FILE}: {exc}",
                  file=sys.stderr)
            return 1
        print(f"SHOW_ICON={value} written to {CONFIG_FILE}")
        return 0

    # The bindings come next, before the display guard and before anything is
    # built, so a headless machine still gets the dependency report first: which
    # package is missing is the more useful answer when both are wrong. GTK does
    # not fail politely in this situation, it aborts the process and leaves a
    # core dump.
    load_bindings()

    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        print("rclone-onedrive-tray: this is the tray icon, and it needs a "
              "graphical session.\n"
              "    There is no DISPLAY or WAYLAND_DISPLAY here.\n"
              "    On a server or over SSH, use onedrive-sync and the timer:\n"
              "        onedrive-sync --resync && "
              "systemctl --user enable --now onedrive-sync.timer",
              file=sys.stderr)
        return 1

    settings = "--settings" in args
    try:
        lock = acquire_lock()
    except OSError as exc:
        if not settings:
            if exc.errno == errno.ELOOP:
                print(f"Refusing to use the lock file {LOCK_FILE}: it is a "
                      f"symbolic link.\n"
                      f"A link there can be aimed at any file on the machine, so "
                      f"it is never followed. Remove it and start again.",
                      file=sys.stderr)
            else:
                print(f"Could not create the lock file {LOCK_FILE}: {exc}\n"
                      f"Check that {LOCK_DIR} points at a directory that exists "
                      f"and is writable.", file=sys.stderr)
            return 1
        lock = None
    if lock is None:
        if not settings:
            print("rclone-onedrive-tray is already running.", file=sys.stderr)
            return 0
        # A tray is already running, which is exactly who --settings is for: it
        # may be running with its icon hidden. There is no second icon here, and
        # the config file carries the changes to the process that has one. It
        # answers 1 when the config could not be read, the exit status main()
        # uses for the same fault, and a GTK response otherwise.
        if show_settings_standalone() == 1:
            return 1
        return 0

    # Everything past this point owns the lock file, so every return path
    # removes it again.
    try:
        if not os.path.exists(CONFIG_FILE):
            print(f"Config not found: {CONFIG_FILE}\nRun install.sh first.",
                  file=sys.stderr)
            return 1

        try:
            cfg = load_config()
        except ConfigFault as exc:
            # One sentence and exit 1, the way the missing-REMOTE case below is
            # handled: the autostart entry has Terminal=false, so a traceback
            # goes nowhere and the tray simply never appears.
            print(f"{APP_ID}: {exc}", file=sys.stderr)
            return 1
        if not cfg.get("REMOTE"):
            # load_config() leaves REMOTE alone: it has no sensible default, and
            # everything the tray does needs one. Hand-edited configs do lose the
            # line, and a tray started from the autostart entry has no terminal to
            # show a traceback in, so this is one sentence and exit 1.
            #
            # The repair named has to be one that can write the file: this key is
            # missing, and onedrive-doctor is read-only by construction - its own
            # header says so. A REMOTE that is present but wrong is the doctor's
            # business, and the tray's other rows say so.
            print(f'{APP_ID}: REMOTE is not set in {CONFIG_FILE}; run setup.sh, '
                  f'or add REMOTE="yourremote:" to that file.',
                  file=sys.stderr)
            return 1
        local_problem = local_path_problem(cfg.get("LOCAL"))
        if local_problem:
            # A relative LOCAL is resolved against this process's own working
            # directory, and the tray is started by an autostart entry with no
            # terminal: the one place it is used as a root is the delete guard,
            # where "which directory is this?" decides whether a tree outside the
            # sync pair is handed to shutil.rmtree. One sentence and exit 1, the
            # way the missing-REMOTE case above is handled.
            print(f"{APP_ID}: {local_problem}\n"
                  f"    Fix LOCAL in {CONFIG_FILE} and start again.",
                  file=sys.stderr)
            return 1
        if not icon_dir_ok():
            print("Warning: cannot write icons, the tray icon may be blank.",
                  file=sys.stderr)

        tray = Tray(cfg)
        if settings:
            # Straight away, before the first poll has even answered: someone
            # whose icon is hidden asked for the window, not for the icon.
            GLib.idle_add(tray.show_settings_now)
        Gtk.main()
    finally:
        release_lock(lock)
    return 0


if __name__ == "__main__":
    sys.exit(main())
