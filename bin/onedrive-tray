#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""rclone-onedrive-tray: a OneDrive-style status icon for `rclone bisync`.

A small GTK/AppIndicator tray app that shows the state of an rclone bisync pair
and lets you drive it without a terminal:

    * live status icon (synced / syncing / failed / paused / unknown)
    * desktop notification when a sync fails
    * "sync now", "open folder", "view log", "pause", "rebuild baseline"
    * remembers whether the icon should start at login

Everything is driven by ~/.config/rclone-onedrive-tray/config.

Requires: python3-gi, gir1.2-ayatanaappindicator3-0.1 (or appindicator3),
          a running AppIndicator-compatible shell extension on GNOME.
"""
from __future__ import annotations

import errno
import fcntl
import json
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time


def _die(problem, fix):
    """Report a missing dependency the way a person can act on.

    A traceback from deep inside an import tells the reader nothing about what
    to install, and a missing tray icon with no message at all is worse.
    """
    print(f"rclone-onedrive-tray: {problem}", file=sys.stderr)
    print(f"\nTo fix it:\n    {fix}\n", file=sys.stderr)
    raise SystemExit(1)


# What the program calls itself, as literals, before anything that can fail:
# --version and --help have to be answered on a machine where the toolkit below
# cannot be imported at all, and USAGE is built from these.
APP_ID = "rclone-onedrive-tray"
APP_NAME = "OneDrive"
VERSION = "1.4.0"
PROJECT_URL = "https://github.com/Xcli0126/rclone-onedrive-tray"
APT = ("sudo apt install python3-gi python3-cairo gir1.2-gtk-3.0 "
       "gir1.2-ayatanaappindicator3-0.1 gir1.2-notify-0.7")

# Filled in by load_bindings(). Every one of them is None until it has run, which
# is what lets this module be imported, and --version and --help be answered, on
# a machine with no PyGObject.
Gtk = GLib = AppIndicator = Notify = cairo = None
# The settings window class, built by load_bindings() for the same reason: it
# inherits from Gtk.Dialog, and a class statement runs when the module is
# imported.
SettingsDialog = None


def load_bindings() -> None:
    """Import the bindings the tray needs, or die saying which one is missing.

    Called from main() before anything is built. These guards used to run at
    import time, which made `--version` and `--help` fail with the apt hint on
    exactly the machine most likely to be asked for them: one that has no
    PyGObject, and so cannot run the tray at all.
    """
    global Gtk, GLib, AppIndicator, Notify, cairo, SettingsDialog
    if Gtk is not None:
        return

    try:
        import gi
    except ImportError:
        _die("PyGObject is not installed, so there are no GTK bindings at all.",
             APT)

    try:
        gi.require_version("Gtk", "3.0")
        from gi.repository import GLib, Gtk  # noqa: F811
    except (ValueError, ImportError):
        _die("The GTK 3 bindings are missing.", APT)

    try:
        gi.require_version("AyatanaAppIndicator3", "0.1")
        from gi.repository import AyatanaAppIndicator3 as AppIndicator
    except ValueError:
        try:
            gi.require_version("AppIndicator3", "0.1")
            from gi.repository import AppIndicator3 as AppIndicator
        except ValueError:
            _die("No AppIndicator bindings were found, so no tray icon can be "
                 "shown.",
                 APT + "\nOn GNOME you also need the AppIndicator shell extension "
                       "(Ubuntu ships it as part of gnome-shell-extension-appindicator).")

    # Notifications are a nicety, not a requirement: degrade instead of refusing
    # to start, and say so once.
    try:
        gi.require_version("Notify", "0.7")
        from gi.repository import Notify  # noqa: F811
    except ValueError:
        Notify = None

    # The icons are drawn at startup, so without cairo the tray would appear as
    # an empty space with no explanation.
    try:
        import cairo
    except ImportError:
        _die("pycairo is missing, so the status icons cannot be drawn.", APT)

    SettingsDialog = _settings_dialog_class()


CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or
                          os.path.expanduser("~/.config"), "rclone-onedrive-tray")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or
                         os.path.expanduser("~/.cache"), "rclone-onedrive-tray")
ICON_DIR = os.path.join(os.environ.get("XDG_DATA_HOME") or
                        os.path.expanduser("~/.local/share"),
                        "rclone-onedrive-tray", "icons")
AUTOSTART = os.path.join(os.environ.get("XDG_CONFIG_HOME") or
                         os.path.expanduser("~/.config"), "autostart",
                         "rclone-onedrive-tray.desktop")
# The interval lives in a drop-in beside the unit rather than in the unit file,
# so a later install.sh (which rewrites the unit from its template) cannot undo
# the setting. Resolved the same way systemd resolves it.
SYSTEMD_USER_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or
                                os.path.expanduser("~/.config"),
                                "systemd", "user")
# Where the single-instance lock lives. $XDG_RUNTIME_DIR is 0700 and belongs to
# this user, so a fixed name in it cannot be created first by anyone else, which
# is the same reasoning that moved the sync lock out of /tmp
# (docs/TROUBLESHOOTING.md). Without a runtime directory there is nothing
# private to use, so the old path stays, and acquire_lock() refuses to follow a
# symlink there.
LOCK_DIR = (os.environ.get("XDG_RUNTIME_DIR") or os.environ.get("TMPDIR")
            or "/tmp")
LOCK_FILE = os.path.join(LOCK_DIR, "rclone-onedrive-tray.lock")

# A timed pause creates a transient systemd timer under this name. It is what
# brings the timer and the watcher back, so a pause survives the tray exiting.
PAUSE_UNIT = f"{APP_ID}-resume"
PAUSE_STAMP = os.path.join(CACHE_DIR, "paused-until")

# What the re-authorise terminal leaves behind: the reconnect's exit status, and
# its output for the sentence when it failed. The tray hands `rclone config
# reconnect` to a terminal and cannot read that process's status, so the script the
# terminal runs writes it here, which is what makes "the sign-in finished" a fact
# rather than a guess from a remote that still answers with the old credentials.
REAUTH_STATUS = os.path.join(CACHE_DIR, "reauth-status")
REAUTH_OUTPUT = os.path.join(CACHE_DIR, "reauth-status.log")

STATES = ("synced", "syncing", "error", "paused", "unknown")
CLOUD_COLOR = (0.20, 0.51, 0.89)
# A darker blue so the silhouette keeps an edge on a light panel without turning
# into a black blob on a dark one.
CLOUD_OUTLINE = (0.10, 0.28, 0.54)
BADGE_COLORS = {
    "synced": (0.18, 0.66, 0.31),
    "syncing": (0.95, 0.62, 0.11),
    "error": (0.86, 0.21, 0.18),
    "paused": (0.55, 0.56, 0.58),
    "unknown": (0.55, 0.56, 0.58),
}

# What the settings dialog edits, and the value each key has when the config does
# not mention it. Kept in one place so the dialog, the CLI flags and the tray all
# agree on what "unset" means.
SETTINGS_DEFAULTS = {
    "UI_LANG": "",
    "SHOW_ICON": "1",
    "INTERVAL_MIN": "5",
    "WATCH": "1",
    "NOTIFY_ON_SUCCESS": "1",
    "MAX_DELETE": "100",
    "BW_LIMIT": "",
    "CHECK_ACCESS": "0",
}
# An rclone size string, or "" for no limit. onedrive-sync turns the value into
# --bwlimit.
BANDWIDTH_CHOICES = ("", "1M", "5M", "10M", "20M")
# The combo needs a real id for the empty choice: GTK treats an empty id as
# "nothing selected".
BW_UNLIMITED = "unlimited"

# The pause durations the menu offers, each with the string it is called by. One
# table, so the submenu and the notification that follows it cannot drift apart.
PAUSE_CHOICES = ((30, "30 minutes"), (120, "2 hours"), (480, "8 hours"))
PAUSE_LABELS = dict(PAUSE_CHOICES)


def bw_id(value: str) -> str:
    return value or BW_UNLIMITED


def bw_value(combo_id) -> str:
    return "" if combo_id in (None, BW_UNLIMITED) else str(combo_id)


# ---------------------------------------------------------------- configuration
def strip_inline_comment(value: str) -> str:
    """Cut an unquoted `#` and everything after it, the way bash cuts a comment.

    `onedrive-sync` sources the config with `.`, which drops a comment at the end
    of a line, so a hand-edited INTERVAL_MIN="15"   # every fifteen minutes was
    15 to bash and `15"   # every fifteen minutes` to this parser: the dialog
    showed one value and the wrapper and systemd used another.

    What bash calls a comment is a `#` at the start of a word, so whitespace has
    to come before it: a `#` with a non-space character in front of it, a `#`
    inside single or double quotes, and a backslash-escaped `#` are all part of
    the value and stay. Quotes are tracked here and removed later by
    load_config(), so the text between them is never treated as a comment.

    The caller passes the text as it stands after the `=`, before stripping it,
    because a `#` that directly follows the `=` is not at the start of a word and
    bash keeps it: `KEY=#x` is `#x` there. Only the unstripped text still says
    whether a space came first, so load_config() strips afterwards.

    This is not bash's escape handling. bash also removes the backslash from an
    unquoted `\\#`, and this keeps it, so `KEY=x\\#y` reads as `x\\#y` here and
    `x#y` there. That is a decision rather than an oversight: the tray's own
    writer escapes `\\`, `"` and `$` with no reader to undo it
    (docs/KNOWN-ISSUES.md, "Four parsers for one file format"), and unescaping one
    character would be a third answer to a question that needs one.
    """
    quote = ""
    escaped = False
    for index, char in enumerate(value):
        if escaped:
            escaped = False
        elif char == "\\" and quote != "'":
            escaped = True
        elif quote:
            if char == quote:
                quote = ""
        elif char in "\"'":
            quote = char
        elif char == "#" and index > 0 and value[index - 1].isspace():
            return value[:index].rstrip()
    return value


class ConfigFault(Exception):
    """The config file is there, but not the text this reader can parse.

    Separate from OSError on purpose: a file that cannot be opened is a config
    that answers the defaults, and main()'s missing-REMOTE sentence is the right
    thing to say about it. A file that is not UTF-8 is a different fault with a
    different repair, and answering the defaults for it would point the user at
    the wrong one.
    """


def config_utf8_problem(exc: UnicodeDecodeError, path: str = CONFIG_FILE) -> str:
    """The sentence for a config file that is not the UTF-8 it has to be.

    The offending byte is named because that is all the reader can honestly say
    about where the fault is: the file is opened as UTF-8 and nothing else, and
    "invalid UTF-8" alone leaves a hand-edited file to be searched byte by byte.
    `path` is the file the sentence is about, because both readers of the format
    raise this: load_config() opens CONFIG_FILE, and update_config_file() is
    handed the path by its caller.
    """
    byte = exc.object[exc.start:exc.start + 1]
    where = "0x" + byte.hex() if byte else "?"
    return (f"{path} is not valid UTF-8 (byte {where}); "
            f"fix the file or run setup.sh.")


def load_config() -> dict:
    """Parse the shell-style KEY="value" config (no shell execution).

    `export KEY=value` names the key `KEY`. bash needs the word when it sources
    the file, onedrive-sync and onedrive-doctor source the file, and the tray's
    own KEY_RE - which reads the file this tray writes - has always allowed the
    prefix, so a hand-written export is a setting to all of them.

    A value ends at an unquoted `#` that whitespace precedes, decided on the raw
    text after the `=`, so `KEY=#x` keeps its `#` while `KEY=   # x` is empty,
    both as bash has them. Neither this reader nor the installers undo the
    escaping the writer applies; see strip_inline_comment.
    """
    cfg: dict[str, str] = {}
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            for raw in fh:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                # Before .strip(): a `#` that directly follows the `=` is the
                # start of the value and not of a comment, and only the text as it
                # stands still says whether a space came first.
                val = strip_inline_comment(val).strip()
                if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                    val = val[1:-1]
                key = key.strip()
                # `export REMOTE=...`, with any whitespace around the word, is the
                # key REMOTE. Splitting on the first `=` alone filed it under
                # "export REMOTE" and left REMOTE unset, so the tray refused to
                # start on a config the two programs it names as the fix read
                # correctly.
                if (key.startswith("export")
                        and key[len("export"):len("export") + 1].isspace()):
                    key = key[len("export"):].strip()
                # ${VAR:-fallback} is bash, and os.path.expandvars below leaves it
                # literal, so a path written that way (config.example writes three
                # of them now) would reach the tray as text with the braces still
                # on it: the log status would be unknown and "View sync log" would
                # open nothing. Resolve that form first, with the meaning bash gives
                # it (an unset or empty variable takes the fallback), then expand
                # the plain $VARs.
                val = re.sub(r"\$\{(\w+):-([^}]*)\}",
                             lambda m: os.environ.get(m.group(1)) or m.group(2), val)
                cfg[key] = os.path.expandvars(val)
    except UnicodeDecodeError as exc:
        # One bad byte used to travel out of main() as a traceback, in a process
        # whose autostart entry has Terminal=false, while the shell half sourced
        # the same file happily and kept syncing. It is a config fault with a
        # sentence, not an unreadable file: the offending byte is named, and no
        # value is guessed at, because LOCAL is a path.
        raise ConfigFault(config_utf8_problem(exc)) from exc
    except OSError as exc:
        # A file that cannot be opened is not a file with no keys in it, and the
        # defaults are what this used to answer for both. A config that is there
        # but mode 000 therefore reached main() as a config with no REMOTE, which
        # sent the reader to add the key that was already in it, and reached the
        # settings dialog as empty fields. The shell half sources the same file
        # and stops with "Permission denied", so the sentence matches that one.
        raise ConfigFault(f"cannot read {CONFIG_FILE}: "
                          f"{exc.strerror or exc}") from exc

    cfg.setdefault("LOCAL", os.path.expanduser("~/OneDrive"))
    cfg.setdefault("UNIT_NAME", "onedrive-sync")
    cfg.setdefault("LOG", os.path.join(CACHE_DIR, "sync.log"))
    cfg.setdefault("OPEN_APP_CMD", "")
    cfg.setdefault("OPEN_APP_NAME", "the app")
    cfg.setdefault("EXCLUDE_FOLDERS_FILE", os.path.join(CONFIG_DIR, "exclude-folders.txt"))
    for key, value in SETTINGS_DEFAULTS.items():
        cfg.setdefault(key, value)
    return cfg


def local_path_problem(value) -> str:
    """Why `value` cannot be the LOCAL in the config, or "" when it can be.

    LOCAL is written by setup.sh and by hand, and nothing used to check it. A
    relative one is the dangerous case: the delete guard resolves it against
    whatever directory the tray process happens to run in - systemd starts the
    tray with no WorkingDirectory, so that is the user's home - and isdir,
    realpath and the prefix check then all pass against a tree rclone never syncs.
    The sentence names the key and the value, so the edit to make is in the text.
    """
    text = str(value or "").strip()
    if not text:
        return ('LOCAL is not set; it has to be an absolute path, such as '
                '"$HOME/OneDrive".')
    if not os.path.isabs(os.path.expanduser(text)):
        return (f'LOCAL="{text}" is not an absolute path; it has to be one, such '
                f'as "$HOME/OneDrive".')
    root = os.path.realpath(os.path.expanduser(text))
    if os.path.dirname(root) == root:
        # The filesystem root passes the two checks above and is the one absolute
        # value they cannot describe. It matters because _local_delete_path()
        # tests "strictly inside the resolved root" with a separator-anchored
        # prefix, and for "/" that prefix is "/" itself: every top-level
        # directory is then inside the sync root, so a remote folder named like a
        # system directory is offered for deletion and the dialog names the real
        # path. The root has no parent, which is what this asks.
        return (f'LOCAL="{text}" is the filesystem root; it has to be a directory '
                f'below it, such as "$HOME/OneDrive".')
    return ""


def truthy(value) -> bool:
    """Read a 1/0 config value the way the settings dialog writes it.

    The accepted on-spellings are the set onedrive-sync reads for CHECK_ACCESS
    and onedrive-doctor reads for WATCH: 1, true, yes, on, enabled. Anything
    else is off, which is what makes "disabled" and an unrecognised value behave
    the same way without needing a second table.
    """
    return str(value).strip().lower() in ("1", "true", "yes", "on", "enabled")


def shell_quote_value(value) -> str:
    """Quote a config value the way the config file has it: KEY="value".

    Backslashes, quotes, dollars and backticks are escaped, so `onedrive-sync`
    can source the file and get back exactly the string that was written.
    """
    text = str(value)
    for ch in ("\\", '"', "$", "`"):
        text = text.replace(ch, "\\" + ch)
    return f'"{text}"'


# The text in front of a key, which the writer puts back, and the key itself.
# `export KEY=value` is the same setting to load_config(), to onedrive-sync and
# to the doctor, and a line is replaced in place, so the prefix a hand-written
# file has is kept rather than quietly dropped by the next settings save. The
# leading whitespace belongs to the prefix for the same reason: it was there
# before the save.
KEY_RE = re.compile(
    r"^(?P<prefix>\s*(?:export\s+)?)(?P<key>[A-Za-z_][A-Za-z0-9_]*)\s*=")


def write_atomic(path: str, text: str) -> None:
    """Write `text` to `path` so a write that cannot finish destroys nothing.

    The four files the tray rewrites are read back by other programs: onedrive-sync
    sources the config with `.`, and the folder menu and the wrapper both read the
    exclusion list. `open(path, "w")` empties the file before a single byte of the
    new content is known to fit, so a full disk, an OOM kill or a power loss in
    that window leaves it truncated. The reviewer's reproducer under a kernel
    file-size limit left the 8.6 KB config at 8192 bytes, mid-word, with
    MAX_LOG_BYTES, RCLONE, RETRIES and RETRY_DELAY gone, and onedrive-sync then
    dies on a file it can no longer source.

    The new content goes beside the target, is flushed and fsynced, and only then
    replaces the target with one rename, so a reader sees either the whole old
    file or the whole new one. Anything that goes wrong removes the temporary file
    and raises OSError, which is what every caller here already handles.

    The target's own permission is checked first, because that is the one thing a
    rename does not need: the directory decides whether os.replace() may happen,
    so a read-only config would otherwise stop being read-only.
    """
    directory = os.path.dirname(os.path.abspath(path)) or "."
    if os.path.exists(path):
        # O_WRONLY without O_TRUNC: a permission check, not a write.
        os.close(os.open(path, os.O_WRONLY))
    fd, tmp = tempfile.mkstemp(dir=directory,
                               prefix="." + os.path.basename(path) + ".")
    try:
        try:
            mode = os.stat(path).st_mode & 0o7777
        except OSError:
            # A file that is not there yet keeps the mode a plain open() would
            # have given it under this process's umask.
            mask = os.umask(0)
            os.umask(mask)
            mode = 0o666 & ~mask
        try:
            os.chmod(tmp, mode)
        except OSError:
            pass
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
        tmp = None
    finally:
        if tmp is not None:
            try:
                os.remove(tmp)
            except OSError:
                pass
    # The rename has to reach the disk too, or a power loss can leave the
    # directory entry pointing at the file that was replaced. Best effort: a
    # filesystem that will not open or fsync its directory is not a reason to
    # fail a write that did land.
    try:
        dir_fd = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    except OSError:
        return
    try:
        os.fsync(dir_fd)
    except OSError:
        pass
    finally:
        os.close(dir_fd)


def update_config_file(path: str, changes: dict) -> list:
    """Set keys in an existing config file, leaving everything else alone.

    The file is a hand-edited document with comments and keys this tray knows
    nothing about (CHECK_FILENAME, RETRIES, ...), and install.sh hands the user
    the same file. Rewriting it from a template would delete both, so only the
    lines whose keys are being changed are replaced and keys that are missing are
    appended at the end.

    A line is replaced with its own prefix: `export KEY=value` is the setting
    load_config() reads, so a save that changed that key used to drop the word
    the user wrote. Keys that had to be appended get no prefix, because there was
    no line to take one from.

    Returns the keys that had to be appended. Raises OSError when the file cannot
    be read or written, and ConfigFault - with config_utf8_problem()'s sentence,
    the one load_config() answers the same file with - when it is there but is not
    the UTF-8 this format has to be.
    """
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except UnicodeDecodeError as exc:
        # The same fault load_config() turns into a sentence. Raised as a bare
        # UnicodeDecodeError it went past both callers, which catch OSError:
        # --show-icon and --hide-icon died with a traceback, and a Save in the
        # settings window killed its worker before _finish() could be scheduled,
        # so the button stayed insensitive for the life of the window and nothing
        # was ever reported. The bytes are not guessed at, for the same reason
        # load_config() does not guess: the values in it are paths.
        raise ConfigFault(config_utf8_problem(exc, path)) from exc

    wanted = dict(changes)
    lines = text.split("\n")
    trailing = lines.pop() if lines and lines[-1] == "" else None

    # Every line carrying the key, not only the first. The file is read with `.`
    # by onedrive-sync and by load_config(), and both let the last assignment win,
    # so rewriting the first occurrence wrote a value the file still did not
    # mean: a hand-edited file with the key on two lines answered --hide-icon
    # with "SHOW_ICON=0 written" and then kept the icon, because the second line
    # was still what every reader saw. Rewriting all of them leaves every reader
    # with the same answer.
    replaced = set()
    for index, line in enumerate(lines):
        found = KEY_RE.match(line)
        if not found:
            continue
        key = found.group("key")
        if key in wanted:
            replaced.add(key)
            lines[index] = (f"{found.group('prefix')}{key}="
                            f"{shell_quote_value(wanted[key])}")

    appended = sorted(key for key in wanted if key not in replaced)
    if appended:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append("# Added by the tray's settings dialog.")
    for key in appended:
        lines.append(f"{key}={shell_quote_value(wanted[key])}")

    out = "\n".join(lines)
    if trailing is not None or not out.endswith("\n"):
        out += "\n"
    write_atomic(path, out)
    return appended


# ---------------------------------------------------------------- settings actions
# Each of these returns an error message, or "" when it worked. The settings
# dialog shows every message it gets back: a systemd or autostart action that
# fails silently would leave the dialog claiming a change that never happened.
def timer_dropin_path(unit: str) -> str:
    """Where systemd looks for the interval override of <unit>.timer."""
    return os.path.join(SYSTEMD_USER_DIR, f"{unit}.timer.d", "interval.conf")


def write_timer_dropin(unit: str, minutes: int) -> str:
    """Set the sync interval through a drop-in, never by rewriting the unit.

    install.sh writes <unit>.timer from systemd/onedrive-sync.timer.in on every
    run, so anything put in the unit file itself is lost at the next update. A
    drop-in is the documented way to override one directive and it survives.
    """
    try:
        minutes = int(minutes)
        if minutes < 1:
            return "the interval must be at least 1 minute"
        path = timer_dropin_path(unit)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        write_atomic(path,
                     "# Set by the tray's settings dialog. A drop-in, so a later\n"
                     "# install.sh can rewrite the unit file without losing it.\n"
                     "[Timer]\n"
                     f"OnUnitInactiveSec={minutes}min\n")
    except (OSError, TypeError, ValueError) as exc:
        return str(exc)
    rc, _, err = sh("systemctl --user daemon-reload", timeout=30)
    if rc != 0:
        return err or f"systemctl --user daemon-reload exited {rc}"
    return ""


def set_watch_unit(unit: str, enable: bool) -> str:
    """Turn the realtime-sync unit on or off, and say so when that fails."""
    action = "enable --now" if enable else "disable --now"
    # The unit name is a config value, so it is quoted for the shell sh() starts.
    rc, out, err = sh(f"systemctl --user {action} {shlex.quote(unit)}-watch.service",
                      timeout=60)
    if rc != 0:
        return err or out or f"systemctl --user {action} exited {rc}"
    return ""


def desktop_exec(value: str) -> str:
    """Quote one path for a Desktop Entry Exec= line.

    A home directory can hold a space, and the line is read as a command line:
    written bare, the path comes out as two arguments and the tray never starts
    at login. The quoting is the Desktop Entry Specification's, applied in the
    order it requires. First the quoting layer: backslash, double quote, backtick
    and dollar are escaped, and a percent is doubled because it introduces a
    field code. Then the general string-value rule, which doubles every backslash
    the quoting layer left behind. That second pass is what the specification
    means by needing four backslashes for one literal backslash, and it is not
    optional here: GLib's key-file reader rejects a bare \\" as a value that
    cannot be interpreted, so without it the whole file would fail to parse.
    """
    quoted = value.replace("\\", "\\\\")
    for ch in ('"', "`", "$"):
        quoted = quoted.replace(ch, "\\" + ch)
    quoted = quoted.replace("%", "%%")
    return '"' + quoted.replace("\\", "\\\\") + '"'


def autostart_contents(script: str = "") -> str:
    """The desktop entry that starts the tray at login.

    `script` is the program to run; the tray itself when it is not given, and a
    parameter so that a test can hand it a path a home directory could really
    have.

    Name and Comment carry a `[zh]` translation: a desktop entry is a key file,
    and GLib looks a localized key up for the session's locale, so without one a
    Chinese desktop lists the entry in English (`OneDrive status icon`) while the
    checkbox that writes it reads 开机自动启动托盘 in the same window. `zh` rather
    than `zh_CN`, because the lookup falls back from the full locale to the
    language, and the project has one Chinese.
    """
    return ("[Desktop Entry]\n"
            "Type=Application\n"
            f"Name={APP_NAME} status icon\n"
            f"Name[zh]={APP_NAME} 状态图标\n"
            "Comment=rclone bisync tray icon\n"
            "Comment[zh]=rclone bisync 托盘图标\n"
            f"Exec={desktop_exec(script or os.path.realpath(__file__))}\n"
            "Terminal=false\n"
            "X-GNOME-Autostart-enabled=true\n")


def write_autostart(enable: bool) -> str:
    """Create or remove the autostart entry; "" when it worked.

    The same file the "Start tray at login" checkbox writes, so the two cannot
    disagree about what is installed.
    """
    try:
        if enable:
            os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
            write_atomic(AUTOSTART, autostart_contents())
            os.chmod(AUTOSTART, 0o644)
        elif os.path.exists(AUTOSTART):
            os.remove(AUTOSTART)
    except OSError as exc:
        return str(exc)
    return ""


def marker_file_path(cfg: dict) -> str:
    """The local marker rclone's --check-access looks for.

    An empty CHECK_FILENAME means rclone's own default, RCLONE_TEST; the file of
    the same name has to exist at the root of both sides.
    """
    name = (cfg.get("CHECK_FILENAME") or "RCLONE_TEST").strip() or "RCLONE_TEST"
    return os.path.join(cfg.get("LOCAL") or "", name)


def sibling_script(name: str) -> str:
    """The helper beside this script, or on PATH; "" when neither is there.

    The sibling wins, so an upgraded checkout is not held back by an older copy
    of the same helper that happens to be earlier on PATH.
    """
    beside = os.path.join(os.path.dirname(os.path.realpath(__file__)), name)
    if os.path.exists(beside):
        return beside
    return shutil.which(name) or ""


def run_script_status(cmd: str, timeout: int = 900):
    """Run a helper script and return (its exit status, stdout+stderr).

    The status matters because onedrive-check uses 1 for "names were found" and 2
    for "the config or the command line is wrong", and a caller that only sees
    zero-or-not has to describe a configuration fault as bad file names. The
    output is decoded as UTF-8 whatever the desktop locale is, the way every file
    the tray reads is opened: a helper that prints a folder name must not come
    back as mojibake on a machine whose locale is not UTF-8.
    """
    try:
        proc = subprocess.run([cmd], capture_output=True,
                              encoding="utf-8", errors="replace",
                              timeout=timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, str(exc)
    return proc.returncode, (proc.stdout + proc.stderr).strip()


def run_script(cmd: str, timeout: int = 900):
    """Run a helper script and return (ok, its stdout+stderr). Slow, so every
    caller runs it on a worker thread."""
    status, text = run_script_status(cmd, timeout)
    return status == 0, text


def run_check_access() -> tuple:
    """Create the marker files. Returns (ok, message); slow, so: worker thread."""
    cmd = sibling_script("onedrive-check-access")
    if not cmd:
        return False, "onedrive-check-access"
    return run_script(cmd)


